---
// Library CSS must be imported here, in the frontmatter — NOT in the client
// <script> below. CSS imported from a <script> is not attributed to the pages
// that use the component: Astro links it on every page in the build. See the
// MapLibre section in AGENTS.md.
import 'maplibre-gl/dist/maplibre-gl.css'
import MapAttribution from './MapAttribution.astro'

interface Props {
  locale: string
  initial?: { lat: number; lng: number } | null
}
const { locale, initial = null } = Astro.props as {
  locale: 'en' | 'de'
  initial?: { lat: number; lng: number } | null
}
---

<div class="map-frame">
  <div class="map-frame__title">
    <span class="map-frame__title-text">[ {locale === 'de' ? 'Ort wählen' : 'pick location'} ]</span
    >
    <span class="map-frame__coords" id="picker-coords"
      >{locale === 'de' ? 'noch kein Ort' : 'no location'}</span
    >
  </div>
  <div
    id="picker-map"
    class="picker-map"
    data-locale={locale}
    data-initial={initial ? JSON.stringify(initial) : ''}
  >
  </div>
  <MapAttribution />
</div>

<script>
  // Must precede the Maplibre import so the worker URL is set before any `new Map()`.
  import '../lib/maplibre-worker'
  // maplibre-gl v6 is ESM-only and no longer has a default export.
  import * as maplibregl from 'maplibre-gl'
  import { currentTheme, themeStyleUrl } from '../lib/map-palette'

  function init() {
    const container = document.getElementById('picker-map')
    if (!container) return

    let initial: { lat: number; lng: number } | null = null
    try {
      const parsed = JSON.parse(container.dataset.initial || 'null')
      if (
        parsed &&
        typeof parsed.lat === 'number' &&
        typeof parsed.lng === 'number' &&
        Number.isFinite(parsed.lat) &&
        Number.isFinite(parsed.lng)
      ) {
        initial = { lat: parsed.lat, lng: parsed.lng }
      }
    } catch {}

    const center = initial ? [initial.lng, initial.lat] : [11.0922, 47.4917]

    const map = new maplibregl.Map({
      container,
      style: themeStyleUrl(currentTheme()),
      center: center as [number, number],
      zoom: 11,
    })

    const coordsEl = document.getElementById('picker-coords')
    let marker: maplibregl.Marker | null = null

    function updatePin(lngLat: maplibregl.LngLat) {
      const el = document.createElement('div')
      el.className = 'picker-pin'
      el.innerHTML = ''
      if (marker) marker.remove()
      marker = new maplibregl.Marker({ element: el }).setLngLat(lngLat).addTo(map)

      const lat = lngLat.lat.toFixed(5)
      const lng = lngLat.lng.toFixed(5)
      if (coordsEl) coordsEl.textContent = `${lat}°N ${lng}°E`

      const input = document.getElementById('picker-location') as HTMLInputElement | null
      if (input) input.value = JSON.stringify({ lat: Number(lat), lng: Number(lng) })
    }

    map.on('load', () => {
      // The baked style JSON carries this theme's colours; a theme change
      // swaps it wholesale (the picker adds no layers of its own).
      document.addEventListener('myco:theme', () => {
        map.setStyle(themeStyleUrl(currentTheme()))
      })

      if (initial) updatePin(new maplibregl.LngLat(initial.lng, initial.lat))
      map.on('click', (e) => {
        updatePin(e.lngLat)
        map.getCanvas().style.cursor = 'crosshair'
      })
      map.on('mousemove', () => {
        map.getCanvas().style.cursor = 'crosshair'
      })
    })
  }

  if (document.readyState !== 'loading') init()
  else document.addEventListener('DOMContentLoaded', init)
</script>

<input type="hidden" id="picker-location" name="location" value="" />

<style>
  .map-frame {
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    box-shadow: var(--shadow);
    border-radius: var(--radius);
  }

  .map-frame__title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border-char);
    font-size: 0.8125rem;
  }

  .map-frame__title-text {
    color: var(--fg-bright);
    font-weight: 700;
  }

  .map-frame__coords {
    color: var(--fg-dim);
    font-size: 0.6875rem;
  }

  .picker-map {
    width: 100%;
    height: 480px;
    cursor: crosshair;
    touch-action: none;
    background: var(--bg-highlight);
  }

  :global(.picker-pin) {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--accent-ink);
    box-shadow: 0 0 0 2px var(--accent-dim);
    cursor: crosshair;
  }

  :global(.maplibregl-ctrl-attrib) {
    display: none;
  }

  :global(.maplibregl-map) {
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .picker-map {
      height: 340px;
    }
  }
</style>
