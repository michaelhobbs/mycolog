---
import Layout from '../../../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import Block from '../../../../components/Block.astro'
import Notice from '../../../../components/Notice.astro'
import LinkRow from '../../../../components/LinkRow.astro'
import MiniMap from '../../../../components/MiniMap.astro'
import {
  enrichSighting,
  buildSpeciesMap,
  buildLocationMap,
  locationName,
} from '../../../../lib/sightings'
import { getTranslations, formatDate, locales } from '../../../../i18n'
import { l10n } from '../../../../i18n/helpers'
import type { Locale } from '../../../../i18n'

export function getStaticPaths() {
  return Promise.resolve(
    (async () => {
      const sightings = await getCollection('sightings')
      return sightings.flatMap((s) => {
        const [date, slug] = s.id.split('/')
        return locales.map((locale) => ({ params: { locale, date, slug } }))
      })
    })(),
  )
}

const { locale, date, slug } = Astro.params as { locale: Locale; date: string; slug: string }
const t = getTranslations(locale)
const sightingId = `${date}/${slug}`

const [all, species, authors, locations] = await Promise.all([
  getCollection('sightings'),
  getCollection('species'),
  getCollection('authors'),
  getCollection('locations'),
])
const entry = all.find((s) => s.id === sightingId)
const sighting = entry ? enrichSighting(entry, buildSpeciesMap(species)) : undefined
const locMap = buildLocationMap(locations)
const authorNames = new Map(authors.map((a) => [a.id, a.data.name]))
const authorInitials = sighting
  ? (sighting.authors ?? []).map((a) => (authorNames.get(a) ?? a).charAt(0).toUpperCase()).join('+')
  : ''
const fullSrcs = sighting
  ? await Promise.all(
      sighting.images.map(async (img) => (await getImage({ src: img, width: 1600 }))?.src ?? ''),
    )
  : []

// Re-ordering the gallery (choosing the main photo) is a dev-only workflow.
const dev = import.meta.env.DEV

const pageTitle = sighting
  ? `${l10n(sighting.species.commonName, locale)} (${formatDate(sighting.dateSpotted, locale)}) — myco.log`
  : 'myco.log'
---

<Layout title={pageTitle} locale={locale}>
  <section class="sighting-page">
    <div class="page-header">
      <span class="page-header__tag"
        >╔══ {
          sighting
            ? `${l10n(sighting.species.commonName, locale)} (${formatDate(sighting.dateSpotted, locale)})`
            : t.sighting.missing
        }</span
      >
      <span class="page-header__sub">{sighting?.species.scientificName}</span>
      {
        sighting && authorInitials && (
          <span class="stamp" aria-hidden="true">
            {authorInitials}
          </span>
        )
      }
    </div>

    <LinkRow
      locale={locale}
      fallback={`/${locale}/log/${date}`}
      links={[
        {
          href: `/${locale}/mushrooms/${sighting?.id}`,
          label: t.sighting.species,
        },
      ]}
    />

    {
      sighting && (
        <>
          {dev && <Notice margin={false} body={t.sighting.devOnly} />}

          <div class="gallery" data-lightbox-group>
            {sighting.images.map((img, i) => (
              <figure
                class:list={['gallery__item', dev && i === 0 && 'gallery__item--cover']}
                data-lightbox-src={fullSrcs[i]}
              >
                <button
                  type="button"
                  class="gallery__zoom"
                  data-lightbox-trigger
                  data-index={i}
                  aria-label={`${t.sighting.fullscreen} ${i + 1}`}
                  title={t.sighting.fullscreen}
                >
                  <Image
                    src={img}
                    alt={`${l10n(sighting.species.commonName, locale)} — ${i + 1}`}
                    loading="lazy"
                    width={640}
                    widths={[320, 640]}
                  />
                </button>
                {dev && (
                  <button
                    type="button"
                    class="gallery__cover"
                    data-cover
                    data-date={date}
                    data-slug={slug}
                    data-image={img.src}
                    disabled={i === 0}
                    title={i === 0 ? t.sighting.mainPhoto : t.sighting.setMainPhoto}
                  >
                    {i === 0 ? t.sighting.mainPhoto : t.sighting.setMainPhoto}
                  </button>
                )}
              </figure>
            ))}
          </div>

          {dev && <span id="cover-status" class="cover-status" role="status" />}

          <MiniMap
            points={[
              {
                lat: sighting.location.lat,
                lng: sighting.location.lng,
                label: locationName(locMap, sighting.locationSlug, locale),
              },
            ]}
          />

          <div class="facts">
            <div class="fact-row">
              <span class="fact-lbl">{t.sighting.location}</span>
              <span class="fact-dot" />
              <span class="fact-val">
                {sighting.locationSlug ? (
                  <a href={`/${locale}/locations/${sighting.locationSlug}`} class="fact-val-link">
                    {locationName(locMap, sighting.locationSlug, locale) || t.mushrooms.unknown}
                  </a>
                ) : (
                  t.mushrooms.unknown
                )}
              </span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">{t.sighting.coordinates}</span>
              <span class="fact-dot" />
              <span class="fact-val">
                {sighting.location.lat.toFixed(5)}°N {sighting.location.lng.toFixed(5)}°E
              </span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">{t.sighting.spotted}</span>
              <span class="fact-dot" />
              <span class="fact-val">
                <a href={`/${locale}/log/${sighting.dateSpotted}`} class="fact-val-link">
                  {formatDate(sighting.dateSpotted, locale)}
                </a>
              </span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">{t.sighting.identified}</span>
              <span class="fact-dot" />
              <span class="fact-val">
                <a
                  href={`/${locale}/identifications/${sighting.dateIdentified}`}
                  class="fact-val-link"
                >
                  {formatDate(sighting.dateIdentified, locale)}
                </a>
              </span>
            </div>
          </div>

          {sighting.notes && (
            <Block title={t.sighting.sightingNotes}>
              <p class="block__notes">{l10n(sighting.notes, locale)}</p>
            </Block>
          )}

          {sighting.species.habitat && (
            <Block title={t.mushrooms.habitat}>
              <p class="block__notes">{l10n(sighting.species.habitat, locale)}</p>
            </Block>
          )}

          {sighting.species.edibility && (
            <Block title={t.mushrooms.edibility}>
              <p class="block__notes">{l10n(sighting.species.edibility, locale)}</p>
            </Block>
          )}

          {sighting.species.determiningFeatures.length > 0 && (
            <Block title={t.mushrooms.features}>
              <ul class="block__list">
                {sighting.species.determiningFeatures.map((f) => (
                  <li>▸ {l10n(f, locale)}</li>
                ))}
              </ul>
            </Block>
          )}

          {sighting.species.notes && (
            <Block title={t.mushrooms.notes}>
              <p class="block__notes">{l10n(sighting.species.notes, locale)}</p>
            </Block>
          )}
        </>
      )
    }
  </section>

  <script
    is:inline
    define:vars={{
      coverEnabled: dev,
      coverT: {
        updating: t.sighting.updating,
        updated: t.sighting.mainUpdated,
        error: t.sighting.error,
      },
    }}
  >
    if (!coverEnabled) {
      // noop in the production build (buttons aren't rendered there either)
    } else {
      const statusEl = document.getElementById('cover-status')
      document.querySelectorAll('[data-cover]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const payload = {
            date: btn.dataset.date,
            slug: btn.dataset.slug,
            image: btn.dataset.image,
          }
          btn.disabled = true
          if (statusEl) {
            statusEl.textContent = coverT.updating
            statusEl.dataset.state = 'pending'
          }
          try {
            const res = await fetch('/myco/api/sightings/cover', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            })
            if (!res.ok) {
              const err = await res.json().catch(() => ({}))
              throw new Error(err.error || 'HTTP ' + res.status)
            }
            if (statusEl) {
              statusEl.textContent = coverT.updated
              statusEl.dataset.state = 'ok'
            }
            window.location.reload()
          } catch (err) {
            console.error('[cover] failed:', err)
            if (statusEl) {
              statusEl.textContent =
                coverT.error + (err instanceof Error ? ' — ' + err.message : '')
              statusEl.dataset.state = 'error'
            }
            btn.disabled = false
          }
        })
      })
    }
  </script>
</Layout>

<style>
  .sighting-page {
    padding-bottom: 2rem;
  }

  .page-header {
    position: relative;
    margin-bottom: 1rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--accent-dim);
    font-size: 0.8125rem;
  }

  .stamp {
    position: absolute;
    top: 0.1rem;
    right: 0;
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--accent-dim);
    border: 1.5px dashed var(--accent-dim);
    border-radius: 2px;
    padding: 0.15rem 0.45rem;
    opacity: 0.65;
    transform: rotate(-4deg);
    user-select: none;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .gallery__item {
    margin: 0;
    border: var(--border-w) solid var(--fg-muted);
    overflow: hidden;
    background: var(--bg-highlight);
    aspect-ratio: 4 / 3;
    position: relative;
  }

  .gallery__item.gallery__item--cover {
    border-color: var(--accent-text);
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: filter 0.15s;
  }

  .gallery__zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
    /* Opts out of iOS double-tap-to-zoom, so a single tap fires click. */
    touch-action: manipulation;
  }

  .gallery__zoom:hover img {
    filter: brightness(1.08);
  }

  .gallery__cover {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg-overlay);
    border: none;
    border-top: 1px solid var(--border-char);
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    transition:
      background 0.1s,
      color 0.1s;
  }

  .gallery__cover:hover:not(:disabled) {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .gallery__cover:disabled {
    color: var(--yellow);
    cursor: default;
  }

  .cover-status {
    display: block;
    margin: -0.25rem 0 1.25rem;
    font-size: 0.75rem;
  }

  .cover-status[data-state='error'] {
    color: var(--red);
  }

  .cover-status[data-state='ok'] {
    color: var(--accent-text);
  }

  .cover-status[data-state='pending'] {
    color: var(--fg-dim);
  }

  .facts {
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.5rem 0.75rem;
    margin-bottom: 1.25rem;
    font-size: 0.8125rem;
  }

  .fact-row {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    line-height: 1.8;
  }

  .fact-lbl {
    color: var(--fg-dim);
    flex-shrink: 0;
    font-size: 0.75rem;
  }

  .fact-dot {
    flex: 1;
    border-bottom: 1px dotted var(--fg-muted);
    min-width: 0.5rem;
    margin-bottom: 0.2em;
  }

  .fact-val {
    color: var(--fg-bright);
    text-align: right;
  }

  .fact-val-link {
    color: var(--fg-bright);
    text-decoration: none;
    transition: color 0.1s;
  }

  .fact-val-link:hover {
    color: var(--accent-text);
  }

  .block__list {
    list-style: none;
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.75rem;
  }

  .block__list li {
    color: var(--fg);
    line-height: 1.9;
    font-size: 0.8125rem;
  }

  .block__notes {
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.75rem;
    color: var(--fg);
    font-style: italic;
    line-height: 1.7;
    font-size: 0.8125rem;
  }
</style>
