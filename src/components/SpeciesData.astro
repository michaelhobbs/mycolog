---
// The species-page content blocks: names, morphology, ecology and edibility.
//
// The Names block also carries the nomenclature topology (accepted name,
// basionym, and the toggleable full history) from Index Fungorum, because
// that is where a reader looks for names. Only the accepted name and the
// basionym show by default; the variations and synonyms sit behind a
// `<details>` so the block is usable without JavaScript.
//
// Every Wikidata value here is `optional` on purpose. Wikidata's coverage is
// partial -- `hymenium type` is on 31 of the 47 species, `ecological type` on
// 29 -- so a missing property means "Wikidata makes no claim", which is not
// the same as "this species has no pores". A row with no data is therefore
// omitted rather than rendered as a negative, and a section with no rows at
// all says so explicitly.
//
// The mark beside each value is a drawing or a colour swatch (see `ValueMark`).
// An unknown QID renders as text with neither, never a broken image -- 4 values
// have neither and 1 has a drawing belonging to a different value.
import Block from './Block.astro'
import NameCite from './NameCite.astro'
import Notice from './Notice.astro'
import ValueMark from './ValueMark.astro'
import { foraging, foragingSources } from '../data/legal/foraging-de'
import type { NameUsage, TaxonomyData } from '../data/taxonomy/types'
import type { ItemRef, WikidataSpeciesData } from '../data/wikidata/species/types'
import type { Locale } from '../i18n'
import type { Translations } from '../i18n'
import { l10n } from '../i18n/helpers'

type Localized = { en: string; de: string }
type AnyRef = ItemRef<never> | ItemRef

interface Props {
  data: WikidataSpeciesData | undefined
  locale: Locale
  t: Translations
  /** The site's own prose, which is richer than Wikidata's enum values. */
  commonName?: Localized
  habitat?: Localized
  edibility?: Localized
  scientificName: string
  /** Collection slug, used to look the species up in the foraging snapshot. */
  slug: string
  /** The Index Fungorum topology for this species, when one was resolved. */
  taxonomy?: TaxonomyData
}

const { data, locale, t, commonName, habitat, edibility, scientificName, slug, taxonomy } =
  Astro.props

/** Prefer the requested language, then English, so a value is never blank. */
const labelOf = (ref: AnyRef) => ref.labels[locale] ?? ref.labels.en ?? ref.labels.de ?? ref.qid

interface Value {
  qid: string
  text: string
}

// The mark is not resolved here: ValueMark looks the drawing and the colour up
// from the QID, so a value with only a colour is not a special case at the call
// site.
const val = (ref: AnyRef): Value => ({
  qid: ref.qid,
  text: labelOf(ref),
})

const morphology = data?.morphology
const ecoVals = (data?.ecology.ecologicalType ?? []).map(val)
const consVals = (data?.edibility.conservationStatus ?? []).map(val)
const edibilityVals = (data?.edibility.values ?? []).map(val)

// Rows with no data are dropped, so a species missing `spore print color` does
// not get a row reading "Spore print — not stated", which reads as a finding.
const morphRows = [
  {
    label: t.mushrooms.hymeniumType,
    vals: morphology?.hymeniumType ? [val(morphology.hymeniumType)] : [],
  },
  { label: t.mushrooms.capShape, vals: (morphology?.capShape ?? []).map(val) },
  {
    label: t.mushrooms.hymeniumAttachment,
    vals: morphology?.hymeniumAttachment ? [val(morphology.hymeniumAttachment)] : [],
  },
  {
    label: t.mushrooms.stipeCharacter,
    vals: morphology?.stipeCharacter ? [val(morphology.stipeCharacter)] : [],
  },
  {
    label: t.mushrooms.sporePrintColor,
    vals: morphology?.sporePrintColor ? [val(morphology.sporePrintColor)] : [],
  },
].filter((r) => r.vals.length > 0)

// Common names: the site's own first, then whatever Wikidata adds.
//
// Dedupe is case- and diacritic-insensitive. Wikidata is inconsistent about
// casing ("Fly Agaric" vs "Fly agaric") and routinely lists a species' common
// name again as its own alias, so a plain `Set` yields "Fly Agaric, Fly agaric"
// under Common names and then "fly agaric" a second time under "also known as".
// The first spelling wins, which is the site's own.
const fold = (v: string) =>
  v
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .toLowerCase()

const dedupe = (values: string[]) => {
  const seen = new Set<string>()
  const out: string[] = []
  for (const v of values) {
    const key = fold(v)
    if (!key || seen.has(key)) continue
    seen.add(key)
    out.push(v)
  }
  return out
}

const wikiCommon = (data?.names.commonNames ?? [])
  .filter((c) => c.lang === locale || c.lang === 'en')
  .map((c) => c.value)
const commonNames = dedupe([l10n(commonName, locale), ...wikiCommon])

// Bavarian (`bar`) common names are a regional variety of German, not one of
// the site's locales, so they can never come out of `l10n` and must not be
// mixed into the list above -- a Bavarian variant read as if it were the
// standard German name loses exactly the thing that makes it worth showing.
// They get a row of their own on both locales, under a label that says what
// they are: a Bavarian form is only useful to a reader who is told it is one.
//
// The names come from the Wikidata snapshot, which records every `bar` claim
// of P1843 (two for Amanita muscaria, the only species in the collection that
// has any). A value already listed as a common name is dropped, since a
// Bavarian form identical to the standard one carries no information.
const listed = new Set(commonNames.map(fold))
const bavarianNames = dedupe(
  (data?.names.commonNames ?? []).filter((c) => c.lang === 'bar').map((c) => c.value),
).filter((v) => !listed.has(fold(v)))

// The site's own common name for this locale, and the two annotations built
// from it. `l10n` never returns undefined, so an empty string means "no common
// name is recorded in this language"; the dedicated form is used so a species
// without one says so instead of silently dropping the row. A trailing `*` is
// the site's mark for a name that is a literal translation of the scientific
// name rather than an established vernacular name; the row shows the mark so
// the note can be traced back to the name it explains.
const ownName = commonName ? l10n(commonName, locale) : ''
const noCommonName = !!commonName && ownName === ''
const literalName = ownName.endsWith('*')

// Wikidata lists the scientific name (and infraspecific variants of it) among
// the aliases of most items, and often repeats a common name there too. Both
// are already stated elsewhere on the page, so an alias list echoing them back
// is noise.
const statedElsewhere = new Set(
  [...commonNames, scientificName, data?.taxonomy.taxonName ?? ''].map(fold),
)
const aliases = dedupe([
  ...(data?.names.aliases?.[locale] ?? []),
  ...(data?.names.aliases?.en ?? []),
]).filter((a) => !statedElsewhere.has(fold(a)))

// --- Nomenclature topology (Index Fungorum via ChecklistBank) -------------
//
// Split an infraspecific name so the rank abbreviation can stay upright
// between two italic runs: "Amanita muscaria var. muscaria" -> base
// "Amanita muscaria", marker "var.", tail "muscaria". A plain binomial
// comes back with an empty marker and tail.
const nameParts = (name: string) => {
  const m = name.match(/^(.*?)\s+(f\.sp\.|subsp\.|ssp\.|var\.|forma|f\.|lusus)\s+(.+)$/i)
  return m ? { base: m[1], marker: m[2], tail: m[3] } : { base: name, marker: '', tail: '' }
}

// Authorship and year, joined for display. The whole string is built here:
// a newline inside a JSX text node is dropped, so `{authorship} {year}`
// wrapped by Prettier would render without the separator.
const authority = (n: NameUsage) => [n.authorship, n.year ?? ''].filter(Boolean).join(', ')

// The two always-visible rows are the accepted name and the basionym; the
// toggle reveals everything else in `fullHistory`, split into the accepted
// name's infraspecific children (grouped under it, per their recorded
// parent) and the remaining synonyms.
const topIds = new Set(
  [taxonomy?.accepted?.usageId, taxonomy?.basionym?.usageId].filter(
    (v): v is string | number => v != null,
  ),
)
const restHistory = (taxonomy?.fullHistory ?? []).filter(
  (e) => e.usageId != null && !topIds.has(e.usageId),
)
const variationIds = new Set((taxonomy?.variations ?? []).map((v) => v.usageId))
const variationItems = (taxonomy?.variations ?? []).map((n) => ({
  parts: nameParts(n.scientificName),
  cite: authority(n),
}))
const otherItems = restHistory
  .filter((e) => !variationIds.has(e.usageId))
  .map((n) => ({ parts: nameParts(n.scientificName), cite: authority(n) }))
const allNamesLabel = t.mushrooms.allNames.replace(
  '{count}',
  String(taxonomy?.fullHistory.length ?? 0),
)

// --- Foraging status (Germany) ---------------------------------------------
//
// Two independent facts from the generated snapshot: federal species
// protection (BArtSchV Annex 1 + its §2(1) exemptions) and the German Red
// List of macrofungi. Threatened is not protected, so the two never collapse
// into one verdict. A species added after the snapshot was last regenerated
// has no entry, and then the whole block is omitted rather than shown as
// "not protected". The strings are built here, not in the template: a
// newline inside a JSX text node is dropped (see `authority` above).
const legal = foraging[slug]
const protectionBase = legal
  ? legal.protection === 'prohibited'
    ? t.mushrooms.protectionProhibited
    : legal.protection === 'smallQuantityExempt'
      ? t.mushrooms.protectionExempt
      : t.mushrooms.protectionNotListed
  : ''
const protectionText = legal?.lawName ? `${protectionBase} (${legal.lawName})` : protectionBase
const redListCats: Record<string, string | undefined> = t.mushrooms.redListCategories
const redListText = legal?.redList
  ? `${legal.redList.code} — ${redListCats[legal.redList.code] ?? legal.redList.code}`
  : ''
const foragingNote = t.mushrooms.foragingSourcesNote.replace('{date}', foragingSources.retrieved)
---

<Block title={t.mushrooms.names}>
  <div class="rows">
    <div class="row">
      <span class="row__label">{t.mushrooms.scientificName}</span>
      <span class="row__dots"></span>
      <span class="row__value"><em>{scientificName}</em></span>
    </div>
    {
      commonNames.length > 0 && (
        <div class="row">
          <span class="row__label">{t.mushrooms.commonNames}</span>
          <span class="row__dots" />
          <span class="row__value">{commonNames.join(', ')}</span>
        </div>
      )
    }
    {
      bavarianNames.length > 0 && (
        <div class="row">
          <span class="row__label">{t.mushrooms.bavarianNames}</span>
          <span class="row__dots" />
          <span class="row__value">{bavarianNames.join(', ')}</span>
        </div>
      )
    }
    {noCommonName && <p class="src-note">{t.mushrooms.noCommonName}</p>}
    {literalName && <p class="src-note">{t.mushrooms.literalName}</p>}
    {
      aliases.length > 0 && (
        <div class="row">
          <span class="row__label">{t.mushrooms.alternateNames}</span>
          <span class="row__dots" />
          <span class="row__value">{aliases.join(', ')}</span>
        </div>
      )
    }
  </div>
</Block>

{
  taxonomy && (
    <Block title={t.mushrooms.nomenclature}>
      <div class="rows">
        <div class="row">
          <span class="row__label">{t.mushrooms.acceptedName}</span>
          <span class="row__dots" />
          <span class="row__value">
            <NameCite
              parts={nameParts(taxonomy.accepted.scientificName)}
              cite={authority(taxonomy.accepted)}
            />
          </span>
        </div>
        {taxonomy.basionym && (
          <div class="row">
            <span class="row__label">{t.mushrooms.basionym}</span>
            <span class="row__dots" />
            <span class="row__value">
              <NameCite
                parts={nameParts(taxonomy.basionym.scientificName)}
                cite={authority(taxonomy.basionym)}
              />
            </span>
          </div>
        )}
        {restHistory.length > 0 && (
          <details class="more">
            <summary class="more__summary">{allNamesLabel}</summary>
            <div class="more__body">
              {variationItems.length > 0 && (
                <div class="group">
                  <div class="group__label">{t.mushrooms.variations}</div>
                  <div class="group__items">
                    {variationItems.map((i) => (
                      <div class="item">
                        <NameCite parts={i.parts} cite={i.cite} />
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {otherItems.length > 0 && (
                <div class="group">
                  <div class="group__label">{t.mushrooms.otherNames}</div>
                  <div class="group__items">
                    {otherItems.map((i) => (
                      <div class="item">
                        <NameCite parts={i.parts} cite={i.cite} />
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </details>
        )}
      </div>
      <p class="src-note">{t.mushrooms.nomenclatureNote}</p>
    </Block>
  )
}

<Block title={t.mushrooms.morphology}>
  {
    morphRows.length ? (
      <div class="rows">
        {morphRows.map((row) => (
          <div class="row">
            <span class="row__label">{row.label}</span>
            <span class="row__dots" />
            <span class="row__value">
              {row.vals.map((v) => (
                <span class="value">
                  <span class="value__text">{v.text}</span>
                  <ValueMark qid={v.qid} />
                </span>
              ))}
            </span>
          </div>
        ))}
      </div>
    ) : (
      <p class="none">{t.mushrooms.noData}</p>
    )
  }
</Block>

<Block title={t.mushrooms.ecology}>
  <div class="rows">
    {
      ecoVals.length > 0 && (
        <div class="row">
          <span class="row__label">{t.mushrooms.ecologicalType}</span>
          <span class="row__dots" />
          <span class="row__value">
            {ecoVals.map((v) => (
              <span class="value">
                <span class="value__text">{v.text}</span>
                <ValueMark qid={v.qid} />
              </span>
            ))}
          </span>
        </div>
      )
    }
    {
      consVals.length > 0 && (
        <div class="row">
          <span class="row__label">{t.mushrooms.conservationStatus}</span>
          <span class="row__dots" />
          <span class="row__value">
            {consVals.map((v) => (
              <span class="value">
                <span class="value__text">{v.text}</span>
              </span>
            ))}
          </span>
        </div>
      )
    }
  </div>
  {habitat && <p class="prose">{l10n(habitat, locale)}</p>}
</Block>

{
  legal && (
    <Block title={t.mushrooms.foraging}>
      <div class="rows">
        <div class="row">
          <span class="row__label">{t.mushrooms.foragingProtection}</span>
          <span class="row__dots" />
          <span class="row__value">{protectionText}</span>
        </div>
        {legal.redList && (
          <div class="row">
            <span class="row__label">{t.mushrooms.foragingRedList}</span>
            <span class="row__dots" />
            <span class="row__value">{redListText}</span>
          </div>
        )}
      </div>
      <Notice
        title={t.mushrooms.foragingNoticeTitle}
        body={t.mushrooms.foragingNoticeBody}
        margin={false}
      />
      <p class="src-note">
        {foragingNote}{' '}
        <a href={foragingSources.bartschvAnlage1} rel="noopener noreferrer" target="_blank">
          {t.mushrooms.sourceLaw}
        </a>
        {' · '}
        <a href={foragingSources.redListZip} rel="noopener noreferrer" target="_blank">
          {t.mushrooms.sourceRedList}
        </a>
      </p>
    </Block>
  )
}

<Block title={t.mushrooms.edibility}>
  {
    edibilityVals.length ? (
      <ul class="values">
        {edibilityVals.map((v) => (
          <li class="value">
            <ValueMark qid={v.qid} variant="chip" />
            <span class="value__text">{v.text}</span>
          </li>
        ))}
      </ul>
    ) : (
      // An empty list would read as "safe to eat". Wikidata making no edibility
      // claim is not the same as an edible species, so say what it means.
      <p class="none">{t.mushrooms.noData}</p>
    )
  }
  {edibility && <p class="prose">{l10n(edibility, locale)}</p>}
</Block>

<style>
  .rows {
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
  }

  .rows:empty {
    display: none;
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    line-height: 1.9;
  }

  .row__label {
    color: var(--fg-dim);
    flex-shrink: 0;
    font-size: 0.75rem;
  }

  .row__dots {
    flex: 1;
    border-bottom: 1px dotted var(--fg-muted);
    min-width: 0.5rem;
    margin-bottom: 0.2em;
  }

  .row__value {
    color: var(--fg-bright);
    text-align: right;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.15rem 0.5rem;
  }

  .value {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .value__text {
    color: var(--fg-bright);
    font-size: 0.8125rem;
  }

  .values {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.6rem 0.75rem;
  }

  .none {
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    color: var(--fg-muted);
    font-style: italic;
    font-size: 0.8125rem;
    margin: 0;
    padding: 0.6rem 0.75rem;
  }

  .prose {
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.6rem 0.75rem;
    margin: 0.4rem 0 0;
    color: var(--fg);
    line-height: 1.7;
    font-size: 0.8125rem;
  }

  /* Nomenclature: the toggle is a native <details>, so the full history is
     reachable without JavaScript and the block ships collapsed with no flash.
     The summary mirrors SpeciesFilter's facet summaries (+ / − marker,
     uppercase label) so the two expandable things on the site behave alike. */
  .more {
    border-top: 1px solid var(--border-char);
    margin-top: 0.35rem;
  }

  .more__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    min-height: 2.25rem;
    padding: 0.35rem 0 0.15rem;
    color: var(--fg-dim);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .more__summary::-webkit-details-marker {
    display: none;
  }

  .more__summary::before {
    content: '+';
    color: var(--fg-muted);
    font-size: 0.75rem;
    width: 0.75rem;
  }

  .more[open] > .more__summary::before {
    content: '−';
  }

  .more__summary:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  .group__label {
    color: var(--fg-dim);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0.5rem 0 0.15rem;
  }

  /* The tree line is what makes the grouping read as nesting: the items hang
     off it directly beneath the group they belong to. */
  .group__items {
    border-left: 1px solid var(--border-char);
    padding-left: 0.75rem;
    margin-left: 0.2rem;
  }

  .item {
    color: var(--fg-bright);
    font-size: 0.8125rem;
    line-height: 1.9;
  }

  /* Credit line, styled like SpeciesSources' note: muted, small, and kept
     outside `.rows` so it does not read as a label/value pair. */
  .src-note {
    color: var(--fg-muted);
    font-size: 0.75rem;
    margin: 0.5rem 0 0;
  }
</style>
