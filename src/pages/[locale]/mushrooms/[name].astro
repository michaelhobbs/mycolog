---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getTranslations, formatDate, locales } from '../../../i18n';
import { l10n } from '../../../i18n/helpers';
import type { Locale } from '../../../i18n';

export function getStaticPaths() {
  return Promise.resolve(
    (async () => {
      const species = await getCollection('species');
      return species.flatMap((sp) =>
        locales.map((locale) => ({ params: { locale, name: sp.id } })),
      );
    })(),
  );
}

const { locale, name } = Astro.params as { locale: Locale; name: string };
const t = getTranslations(locale);

const [all, speciesList] = await Promise.all([
  getCollection('sightings'),
  getCollection('species'),
]);
const species = speciesList.find((sp) => sp.id === name);

const entries = all
  .filter((s) => s.data.species === name)
  .sort((a, b) => (a.data.dateSpotted < b.data.dateSpotted ? -1 : 1));

const sp = species?.data;
const allImages = entries.flatMap((e) => e.data.images);
const notes = entries.map((e) => e.data.notes).find(Boolean);
const sharedNotes = sp?.notes;
const habitat = sp?.habitat;
const edibility = sp?.edibility;
const features = sp?.determiningFeatures ?? [];
---

<Layout title={`${species ? l10n(sp?.commonName, locale) : name} — myco.log`} locale={locale}>
  <section class="species-page">
    <div class="page-header">
      <span class="page-header__tag">╔══ {sp ? l10n(sp.commonName, locale) : name}</span>
      <span class="page-header__sub">{sp?.scientificName}</span>
    </div>

    <div class="back">
      <a href={`/${locale}/mushrooms`} class="tui-link">{'<'} {t.mushrooms.backToIndex}</a>
    </div>

    {species && (
      <>
        <div class="gallery">
          {allImages.map((img, i) => (
            <figure class="gallery__item">
              <Image src={img} alt={`${l10n(sp.commonName, locale)} — ${i + 1}`} loading="lazy" widths={[320, 640]} />
            </figure>
          ))}
        </div>

        <div class="facts">
          <div class="fact-row">
            <span class="fact-lbl">{t.mushrooms.edibility}</span>
            <span class="fact-dot"></span>
            <span class="fact-val">{edibility ? l10n(edibility, locale) : '—'}</span>
          </div>
          <div class="fact-row">
            <span class="fact-lbl">{t.mushrooms.habitat}</span>
            <span class="fact-dot"></span>
            <span class="fact-val">{habitat ? l10n(habitat, locale) : '—'}</span>
          </div>
        </div>

        {sharedNotes && (
          <section class="block">
            <div class="block__hdr">╔═ {t.mushrooms.notes}</div>
            <p class="block__notes">{l10n(sharedNotes, locale)}</p>
          </section>
        )}

        {features.length > 0 && (
          <section class="block">
            <div class="block__hdr">╔═ {t.mushrooms.features}</div>
            <ul class="block__list">
              {features.map((f) => (
                <li>▸ {l10n(f, locale)}</li>
              ))}
            </ul>
          </section>
        )}

        <section class="block">
          <div class="block__hdr">╔═ {t.mushrooms.sightings} ({entries.length})</div>
          <ul class="block__sightings">
            {entries.map((e) => {
              const sd = e.data;
              const cover = sd.images?.[0];
              return (
                <li class="sighting">
                  {cover && (
                    <a href={`/${locale}/log/${sd.dateSpotted}`} class="sighting__img">
                      <Image src={cover} alt={l10n(sp.commonName, locale)} loading="lazy" width={96} />
                    </a>
                  )}
                  <div class="sighting__body">
                    <a href={`/${locale}/log/${sd.dateSpotted}`} class="sighting__date">
                      {formatDate(sd.dateSpotted, locale)}
                    </a>
                    <span class="sighting__loc">@{l10n(sd.location.name, locale) || t.mushrooms.unknown}</span>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      </>
    )}
  </section>
</Layout>

<style>
  .species-page { padding-bottom: 2rem; }

  .page-header { margin-bottom: 1rem; }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--accent-dim);
    font-size: 0.8125rem;
  }

  .back { margin-bottom: 1.25rem; }

  .tui-link {
    color: var(--accent-dim);
    text-decoration: none;
    font-size: 0.8125rem;
  }

  .tui-link:hover {
    color: var(--accent);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .gallery__item {
    margin: 0;
    border: 1px solid var(--fg-muted);
    overflow: hidden;
    background: var(--bg-highlight);
    aspect-ratio: 4 / 3;
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .facts {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.5rem 0.75rem;
    margin-bottom: 1.25rem;
    font-size: 0.8125rem;
  }

  .fact-row {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    line-height: 1.8;
  }

  .fact-lbl {
    color: var(--fg-dim);
    flex-shrink: 0;
    font-size: 0.75rem;
  }

  .fact-dot {
    flex: 1;
    border-bottom: 1px dotted var(--fg-muted);
    min-width: 0.5rem;
    margin-bottom: 0.2em;
  }

  .fact-val {
    color: var(--fg-bright);
    text-align: right;
  }

  .block {
    margin-bottom: 1.25rem;
  }

  .block__hdr {
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 0.8125rem;
    margin-bottom: 0.5rem;
  }

  .block__list {
    list-style: none;
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.75rem;
  }

  .block__list li {
    color: var(--fg);
    line-height: 1.9;
    font-size: 0.8125rem;
  }

  .block__notes {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.75rem;
    color: var(--fg);
    font-style: italic;
    line-height: 1.7;
    font-size: 0.8125rem;
  }

  .block__sightings {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sighting {
    display: flex;
    gap: 0.75rem;
    padding: 0.5rem;
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    font-size: 0.8125rem;
  }

  .sighting__img {
    width: 72px;
    height: 56px;
    flex-shrink: 0;
    border: 1px solid var(--fg-muted);
    overflow: hidden;
    background: var(--bg-highlight);
  }

  .sighting__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sighting__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .sighting__date {
    color: var(--yellow);
    font-weight: 700;
    text-decoration: none;
  }

  .sighting__date:hover {
    color: var(--fg-bright);
  }

  .sighting__loc {
    color: var(--fg-dim);
    font-size: 0.75rem;
  }
</style>
