---
import { formatAnchorDate, formatCompactDate } from '../i18n'

interface Props {
  dates: string[]
  label: string
}

const { dates, label } = Astro.props
---

<nav class="date-index" aria-label={label}>
  <span class="date-index__label">{label}</span>
  {
    dates.map((d) => (
      <a class="date-index__link" href={`#${formatAnchorDate(d)}`}>
        {formatCompactDate(d)}
      </a>
    ))
  }
</nav>

<style>
  .date-index {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
    margin: 0 0 1.25rem;
  }

  .date-index__label {
    color: var(--fg-dim);
    font-size: 0.8125rem;
    margin-right: 0.25rem;
  }

  .date-index__link {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    color: var(--fg-dim);
    font-size: 0.8125rem;
    padding: 0.125rem 0.625rem;
    text-decoration: none;
  }

  .date-index__link:hover {
    color: var(--fg-bright);
    border-color: var(--accent-dim);
  }
</style>
