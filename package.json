{
  "name": "mushrooms",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "update-backlog": "node scripts/import-backlog-public.mjs",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "prepare": "husky",
    "api": "node scripts/api.mjs"
  },
  "dependencies": {
    "astro": "^7.2.6",
    "maplibre-contour": "^0.1.0",
    "maplibre-gl": "^4.7.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "lint-staged": {
    "*.{astro,js,mjs,ts,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
