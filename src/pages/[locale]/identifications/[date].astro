---
import Layout from '../../../layouts/Layout.astro'
import MushroomCard from '../../../components/MushroomCard.astro'
import LinkRow from '../../../components/LinkRow.astro'
import DateRail from '../../../components/DateRail.astro'
import { getCollection } from 'astro:content'
import {
  enrichSightings,
  identificationDate,
  buildLocationMap,
  locationName,
} from '../../../lib/sightings'
import { getTranslations, formatDate, locales } from '../../../i18n'
import { formatDayLong, type RailDay } from '../../../lib/date-rail'
import type { Locale } from '../../../i18n'

export async function getStaticPaths() {
  const sightingEntries = await getCollection('sightings')
  const dates = [
    ...new Set(sightingEntries.map((s) => s.data.dateIdentified || s.data.dateSpotted)),
  ].sort()
  return dates.flatMap((date) => locales.map((locale) => ({ params: { locale, date } })))
}

const { locale, date } = Astro.params as { locale: Locale; date: string }
const t = getTranslations(locale)

const [sightingEntries, speciesEntries, locationEntries] = await Promise.all([
  getCollection('sightings'),
  getCollection('species'),
  getCollection('locations'),
])
const enriched = enrichSightings(sightingEntries, speciesEntries)
const sightings = enriched.filter((s) => identificationDate(s) === date)
const locations = buildLocationMap(locationEntries)

const byDate = new Map<string, typeof sightings>()
for (const s of enriched) {
  const key = identificationDate(s)
  const bucket = byDate.get(key)
  if (bucket) bucket.push(s)
  else byDate.set(key, [s])
}

const railDays: RailDay[] = [...byDate.entries()]
  .map(([day, items]) => {
    const names = [...new Set(items.map((s) => s.locationSlug).filter(Boolean))]
      .slice(0, 3)
      .map((slug) => locationName(locations, slug, locale))
    return { date: day, count: items.length, meta: names.join(' · ') || undefined }
  })
  .sort((a, b) => (a.date < b.date ? 1 : -1))
const countLabel = `${sightings.length} ${t.log.sightingsCount}`
---

<Layout
  title={`${t.identifications.title} · ${formatDate(date, locale)} — myco.log`}
  locale={locale}
>
  <DateRail
    days={railDays}
    basePath={`/${locale}/identifications`}
    locale={locale}
    countUnit={t.log.sightingsCount}
    navLabel={t.common.jumpToDate}
    activeDate={date}
    activeLabel={formatDayLong(date, locale)}
  >
    <div class="page-header">
      <span class="page-header__tag"
        >╔══ {t.identifications.title} · {formatDate(date, locale)}</span
      >
      <span class="page-header__sub">{countLabel}</span>
    </div>

    <LinkRow
      locale={locale}
      fallback={`/${locale}/identifications`}
      links={[{ href: `/${locale}/identifications`, label: t.identifications.backToList }]}
    />

    {
      sightings.length === 0 ? (
        <p class="empty">{t.log.noSightings}</p>
      ) : (
        <div class="day__grid">
          {sightings.map((sighting) => (
            <MushroomCard sighting={sighting} locale={locale} locations={locations} />
          ))}
        </div>
      )
    }
  </DateRail>
</Layout>

<style>
  .page-header {
    margin-bottom: 1.25rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .empty {
    color: var(--fg-dim);
    font-size: 0.8125rem;
    margin-bottom: 1rem;
  }

  .day__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .day__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
