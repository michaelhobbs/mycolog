---
import Layout from '../../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import { enrichSightings } from '../../../lib/sightings'
import { getTranslations, locales } from '../../../i18n'
import { l10n } from '../../../i18n/helpers'
import type { Locale } from '../../../i18n'

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }
const t = getTranslations(locale)

const [sightingEntries, speciesEntries] = await Promise.all([
  getCollection('sightings'),
  getCollection('species'),
])
const sightings = enrichSightings(sightingEntries, speciesEntries)

const byId = new Map<string, typeof sightings>()
for (const s of sightings) {
  if (!byId.has(s.id)) byId.set(s.id, [])
  byId.get(s.id)!.push(s)
}

const imagesBySighting = new Map(sightings.map((s) => [s.slug, s.images ?? []]))

const species = speciesEntries
  .map((sp) => {
    const list = byId.get(sp.id) ?? []
    const cover =
      (sp.data.cover && imagesBySighting.get(sp.data.cover.sighting)?.[sp.data.cover.index]) ??
      list[0]?.images?.[0]
    return {
      id: sp.id,
      commonName: sp.data.commonName,
      scientificName: sp.data.scientificName,
      cover,
      count: list.length,
    }
  })
  .sort((a, b) => a.id.localeCompare(b.id))
---

<Layout title={`${t.mushrooms.title} — myco.log`} locale={locale}>
  <section class="mushrooms-page">
    <div class="page-header">
      <span class="page-header__tag">╔══ {t.mushrooms.title}</span>
      <span class="page-header__sub"
        >{t.mushrooms.subtitle} · {species.length} {t.mushrooms.count}</span
      >
    </div>

    <div class="grid">
      {
        species.map((m) => (
          <a href={`/${locale}/mushrooms/${m.id}`} class="card">
            <div class="card__img">
              {m.cover && (
                <Image
                  src={m.cover}
                  alt={l10n(m.commonName, locale)}
                  loading="lazy"
                  widths={[320, 640]}
                />
              )}
            </div>
            <div class="card__body">
              <span class="card__species">{m.scientificName}</span>
              <span class="card__name">{l10n(m.commonName, locale)}</span>
              <span class="card__meta">
                {m.count} {t.log.sightingsCount}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .mushrooms-page {
    padding-bottom: 2rem;
  }

  .page-header {
    margin-bottom: 1.25rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
  }

  .card {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.1s;
  }

  .card:hover {
    border-color: var(--accent-dim);
  }

  .card__img {
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--border-char);
    overflow: hidden;
    background: var(--bg-highlight);
  }

  .card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__body {
    padding: 0.625rem 0.75rem;
  }

  .card__species {
    display: block;
    font-size: 0.6875rem;
    color: var(--accent-dim);
  }

  .card__name {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 0.9375rem;
    margin: 0.125rem 0 0.25rem;
  }

  .card__meta {
    color: var(--fg-dim);
    font-size: 0.75rem;
  }
</style>
