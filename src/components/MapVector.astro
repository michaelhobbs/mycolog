---
import type { Locale } from '../i18n'
import type { EnrichedSighting } from '../lib/sightings'
import { getImage } from 'astro:assets'
import { l10n } from '../i18n/helpers'

interface Props {
  sightings: EnrichedSighting[]
  locale: Locale
  center?: [number, number]
}

const { sightings, locale, center = [47.4917, 11.0922] } = Astro.props

const clientSightings = await Promise.all(
  sightings.map(async (s) => {
    const resolvedImages = (
      await Promise.all(
        (s.images ?? []).map(async (img) => {
          const resolved = await getImage({ src: img, width: 320 })
          return resolved?.src ?? ''
        }),
      )
    ).filter(Boolean)
    return {
      id: s.id,
      dateSpotted: s.dateSpotted,
      location: s.location,
      imageUrls: resolvedImages,
      name: l10n(s.species.commonName, locale) ?? '',
      species: s.species.scientificName ?? '',
    }
  }),
)

const sightingsJSON = JSON.stringify(clientSightings)
---

<div class="map-frame">
  <div class="map-frame__title">
    <span class="map-frame__title-text">[ map ]</span>
    <span class="map-frame__title-coords">{center[0].toFixed(4)}°N {center[1].toFixed(4)}°E</span>
  </div>
  <div
    id="map"
    class="map"
    data-sightings={sightingsJSON}
    data-center={JSON.stringify(center)}
    data-locale={locale}
  >
  </div>
  <div class="map-frame__attribution">
    <span>OpenFreeMap · © OpenMapTiles · © OpenStreetMap contributors</span>
  </div>
</div>

<script>
  import maplibregl from 'maplibre-gl'
  import 'maplibre-gl/dist/maplibre-gl.css'
  import mlcontour from 'maplibre-contour'

  const STYLE_URL = 'https://tiles.openfreemap.org/styles/fiord'

  // Altitude contours generated on the fly from free raster-DEM tiles
  // (AWS Mapzen "terrarium" elevation tiles, z0-14, no key required).
  const demSource = new mlcontour.DemSource({
    url: 'https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png',
    encoding: 'terrarium',
    maxzoom: 14,
    worker: false,
    cacheSize: 50,
    timeoutMs: 10_000,
  })
  demSource.setupMaplibre(maplibregl)

  // Dark green hypsometric terrain, teal lakes/rivers, green-toned roads +
  // accent trails (the palette from the retired d3 POC).
  function applyPalette(map: maplibregl.Map) {
    const paint = (layer: string, props: { [s: string]: unknown }) => {
      if (map.getLayer(layer)) {
        Object.entries(props).forEach(([k, v]) => map.setPaintProperty(layer, k, v))
      }
    }

    paint('background', { 'background-color': '#0e120b' })
    paint('landcover_wood', { 'fill-color': '#151a10', 'fill-opacity': 1 })
    paint('landuse_residential', { 'fill-color': '#11150c', 'fill-opacity': 1 })
    paint('landcover_ice_shelf', { 'fill-color': '#20291a' })
    paint('landcover_glacier', { 'fill-color': '#20291a' })

    ;['park', 'park_outline'].forEach((l) => {
      if (map.getLayer(l)) map.setLayoutProperty(l, 'visibility', 'none')
    })

    paint('water', { 'fill-color': '#2a7d94' })
    paint('waterway', { 'line-color': '#2a6a80' })
    paint('building', { 'fill-color': '#263222' })

    paint('highway_major_casing', { 'line-color': '#151a10' })
    paint('highway_major_inner', { 'line-color': '#d4f0d4' })
    paint('highway_major_subtle', { 'line-color': '#d4f0d4', 'line-opacity': 0.6 })
    paint('highway_motorway_casing', { 'line-color': '#151a10' })
    paint('highway_motorway_inner', { 'line-color': '#d4f0d4' })
    paint('highway_minor', { 'line-color': '#8fbf8f' })
    paint('highway_path', { 'line-color': '#33ff33', 'line-dasharray': [1.5, 1.5] })

    paint('boundary_state', { 'line-color': '#2d5a2d' })
    paint('boundary_country_z5-', { 'line-color': '#4a8f4a' })

    ;[
      'place_city_large',
      'place_city',
      'place_town',
      'place_village',
      'place_suburb',
      'place_other',
      'highway_name_other',
      'highway_name_motorway',
      'water_name',
    ].forEach((l) =>
      paint(l, { 'text-color': '#d4f0d4', 'text-halo-color': '#0e120b', 'text-halo-width': 1.5 }),
    )
  }

  function addHikingLayers(map: maplibregl.Map) {
    const add = (
      id: string,
      type: string,
      beforeId: string,
      {
        sourceLayer,
        filter,
        layout = {},
        paint = {},
        minzoom,
        maxzoom,
      }: {
        sourceLayer: string
        filter: any
        layout: any
        paint: any
        minzoom?: number
        maxzoom?: number
      },
    ) => {
      map.addLayer(
        {
          id,
          type,
          source: 'openmaptiles',
          'source-layer': sourceLayer,
          filter,
          layout,
          paint,
          ...(minzoom !== undefined ? { minzoom } : {}),
          ...(maxzoom !== undefined ? { maxzoom } : {}),
        },
        beforeId,
      )
    }

    const base = map.getStyle().layers.find((l: { id: string }) => l.id === 'boundary_state')
    const b4 = base ? base.id : undefined

    // --- mountain peaks (summits with name + elevation) ---
    add('hiking-peak', 'symbol', b4, {
      sourceLayer: 'mountain_peak',
      filter: ['all', ['==', ['get', 'class'], 'peak'], ['<=', ['get', 'rank'], 4]],
      layout: {
        'icon-image': 'marker',
        'icon-size': ['interpolate', ['linear'], ['zoom'], 12, 0.6, 14, 1],
        'text-field': [
          'concat',
          ['coalesce', ['get', 'name_de'], ['get', 'name'], ''],
          ['literal', ' '],
          ['coalesce', ['to-string', ['get', 'ele']], ''],
          ['literal', ' m'],
        ],
        'text-font': ['Noto Sans Bold'],
        'text-size': 11,
        'text-anchor': 'left',
        'text-offset': [0.7, 0],
        'text-allow-overlap': false,
      },
      paint: {
        'text-color': '#d4f0d4',
        'text-halo-color': '#0e120b',
        'text-halo-width': 1.5,
      },
    })

    // --- hiking POIs (shelters, guideposts, drinking water, viewpoints) ---
    add('hiking-poi', 'symbol', 'hiking-peak', {
      sourceLayer: 'poi',
      minzoom: 14,
      filter: [
        'all',
        ['match', ['geometry-type'], ['Point', 'MultiPoint'], true, false],
        [
          'match',
          ['get', 'subclass'],
          [
            'shelter',
            'guidepost',
            'map',
            'viewpoint',
            'drinking_water',
            'alpine_hut',
            'hostel',
            'spring',
          ],
          true,
          false,
        ],
        ['<=', ['get', 'rank'], 15],
      ],
      layout: {
        'icon-image': 'marker',
        'icon-size': 0.4,
        'text-field': ['coalesce', ['get', 'name_de'], ['get', 'name'], ''],
        'text-font': ['Noto Sans Regular'],
        'text-size': 10,
        'text-anchor': 'top',
        'text-offset': [0, 0.5],
        'text-allow-overlap': false,
      },
      paint: {
        'text-color': '#8fbf8f',
        'text-halo-color': '#0e120b',
        'text-halo-width': 1.2,
      },
    })

    // --- named hiking trail labels (from transportation_name) ---
    add('hiking-trail-label', 'symbol', b4, {
      sourceLayer: 'transportation_name',
      minzoom: 14,
      filter: [
        'all',
        ['==', ['get', 'class'], 'path'],
        ['match', ['geometry-type'], ['LineString', 'MultiLineString'], true, false],
        ['!=', ['coalesce', ['get', 'name'], ''], ''],
      ],
      layout: {
        'symbol-placement': 'line',
        'text-field': ['coalesce', ['get', 'name'], ''],
        'text-font': ['Noto Sans Regular'],
        'text-size': 10.5,
        'text-letter-spacing': 0.02,
        'symbol-spacing': 300,
        'text-rotation-alignment': 'map',
      },
      paint: {
        'text-color': '#33ff33',
        'text-halo-color': '#0e120b',
        'text-halo-width': 1.4,
      },
    })
  }

  function addContours(map: maplibregl.Map) {
    if (map.getSource('hiking-contours')) return

    map.addSource('hiking-contours', {
      type: 'vector',
      tiles: [
        demSource.contourProtocolUrl({
          thresholds: {
            12: [40, 200],
            13: [20, 100],
            14: [20, 50],
          },
          contourLayer: 'contours',
          elevationKey: 'ele',
          levelKey: 'level',
          extent: 4096,
          buffer: 1,
        }),
      ],
      maxzoom: 15,
    })

    const beforeId =
      (map.getLayer('waterway') && 'waterway') ||
      (map.getLayer('hiking-peak') && 'hiking-peak') ||
      undefined
    map.addLayer(
      {
        id: 'hiking-contour-minor',
        type: 'line',
        source: 'hiking-contours',
        'source-layer': 'contours',
        filter: ['==', ['get', 'level'], 0],
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: {
          'line-color': '#3a4a35',
          'line-width': 0.6,
          'line-opacity': 0.9,
        },
      },
      beforeId,
    )

    map.addLayer(
      {
        id: 'hiking-contour-major',
        type: 'line',
        source: 'hiking-contours',
        'source-layer': 'contours',
        filter: ['>=', ['get', 'level'], 1],
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: {
          'line-color': '#5a6c52',
          'line-width': 0.9,
          'line-opacity': 1,
        },
      },
      beforeId,
    )
  }

  // Mushroom sightings pinned as accent dots + labels, from the data embedded
  // on the page (data-sightings with a pre-resolved `name` in the active locale).
  // Overlapping points are clustered by MapLibre (supercluster): each cluster
  // is drawn as a larger accent dot with a count badge, and clicking it opens a
  // carousel popup that navigates every sighting it contains. Clustering stays
  // enabled at every zoom, so points at identical coordinates always stay grouped
  // (0 px apart can never leave the cluster radius), while points that only
  // happen to overlap decluster once their on-screen distance exceeds the radius.
  function addSightings(map: maplibregl.Map, sightings: any[]) {
    if (map.getSource('sightings') || !sightings.length) return
    const locale = document.getElementById('map')?.dataset.locale ?? 'en'
    const linkLabel = locale === 'de' ? 'Im Protokoll ansehen →' : 'See in log →'

    const features = sightings.map((s, i) => ({
      type: 'Feature' as const,
      id: i,
      properties: {
        id: s.id ?? '',
        dateSpotted: s.dateSpotted ?? '',
        name: s.name ?? s.species ?? '',
        species: s.species ?? '',
        imageUrls: JSON.stringify(s.imageUrls ?? []),
      },
      geometry: { type: 'Point' as const, coordinates: [s.location.lng, s.location.lat] },
    }))

    map.addSource('sightings', {
      type: 'geojson',
      data: { type: 'FeatureCollection', features },
      cluster: true,
      clusterRadius: 44,
    })
    const source = map.getSource('sightings') as maplibregl.GeoJSONSource

    // --- cluster circle + count badge ---
    map.addLayer({
      id: 'sighting-cluster',
      type: 'circle',
      source: 'sightings',
      filter: ['has', 'point_count'],
      paint: {
        'circle-color': '#33ff33',
        'circle-radius': ['step', ['get', 'point_count'], 14, 10, 18, 30, 22],
        'circle-stroke-color': '#0e120b',
        'circle-stroke-width': 2,
      },
    })

    map.addLayer({
      id: 'sighting-cluster-count',
      type: 'symbol',
      source: 'sightings',
      filter: ['has', 'point_count'],
      layout: {
        'text-field': ['get', 'point_count_abbreviated'],
        'text-font': ['Noto Sans Bold'],
        'text-size': 12,
      },
      paint: {
        'text-color': '#0e120b',
        'text-halo-color': '#33ff33',
        'text-halo-width': 1,
      },
    })

    // --- individual marker + label (hidden when part of a cluster) ---
    map.addLayer({
      id: 'sighting-marker',
      type: 'circle',
      source: 'sightings',
      filter: ['!', ['has', 'point_count']],
      paint: {
        'circle-color': '#33ff33',
        'circle-radius': 6,
        'circle-stroke-color': '#0e120b',
        'circle-stroke-width': 1.5,
      },
    })

    map.addLayer({
      id: 'sighting-label',
      type: 'symbol',
      source: 'sightings',
      filter: ['!', ['has', 'point_count']],
      layout: {
        'text-field': ['coalesce', ['get', 'name'], ''],
        'text-font': ['Noto Sans Bold'],
        'text-size': 11,
        'text-anchor': 'left',
        'text-offset': [1.1, 0],
        'text-allow-overlap': false,
      },
      paint: {
        'text-color': '#33ff33',
        'text-halo-color': '#0e120b',
        'text-halo-width': 1.4,
      },
    })

    // Transparent hit layer over individual markers for easy clicking.
    map.addLayer(
      {
        id: 'sighting-hit',
        type: 'circle',
        source: 'sightings',
        filter: ['!', ['has', 'point_count']],
        paint: {
          'circle-color': 'rgba(0,0,0,0)',
          'circle-radius': 18,
        },
      },
      'sighting-marker',
    )

    const popup = new maplibregl.Popup({
      offset: 14,
      closeButton: false,
      className: 'tui-map-popup',
    })

    // --- single marker popup ---
    function openSinglePopup(p: any, lngLat: [number, number]) {
      popup.setLngLat(lngLat).setDOMContent(popupNode(p)).addTo(map)
    }

    // marker dot -> popup
    map.on('click', 'sighting-hit', (e: any) => {
      const f = e.features?.[0]
      if (!f) return
      openSinglePopup(f.properties, [e.lngLat.lng, e.lngLat.lat])
    })

    // label text -> popup (so clicking a marker's name opens it too)
    map.on('click', 'sighting-label', (e: any) => {
      const f = e.features?.[0]
      if (!f) return
      const geom = f.geometry?.coordinates
      openSinglePopup(
        f.properties,
        Array.isArray(geom) ? [geom[0], geom[1]] : [e.lngLat.lng, e.lngLat.lat],
      )
    })

    // --- cluster popup with a carousel of all contained sightings ---
    map.on('click', 'sighting-cluster', async (e: any) => {
      const cluster = e.features?.[0]
      if (!cluster) return
      const clusterId = cluster.properties.cluster_id
      // leaves = every sighting nested inside this cluster
      let leaves: any[] = []
      try {
        leaves = await source.getClusterLeaves(clusterId, Number.MAX_SAFE_INTEGER, 0)
      } catch (err) {
        console.error('[map] getClusterLeaves failed:', err)
        return
      }
      if (!leaves.length) return
      popup.setLngLat(e.lngLat).setDOMContent(carouselNode(leaves)).addTo(map)
    })

    // Pointer cursor over any clickable sighting feature. Uses map-wide
    // mousemove + queryRenderedFeatures so it works regardless of which layer
    // sits visually on top (marker dot, its label, the hidden hit area, or a
    // cluster).
    const CLICKABLE = ['sighting-marker', 'sighting-hit', 'sighting-label', 'sighting-cluster']
    map.on('mousemove', (e) => {
      const features = map.queryRenderedFeatures(e.point, { layers: CLICKABLE })
      map.getCanvas().style.cursor = features.length ? 'pointer' : ''
    })

    // Build the single-sighting popup.
    function popupNode(p: any): HTMLElement {
      const root = document.createElement('div')
      root.className = 'tpopup'
      const to = `/${locale}/mushrooms/${encodeURIComponent(p.id ?? '')}`

      let images: string[] = []
      try {
        images = JSON.parse(p.imageUrls || '[]')
      } catch {
        /* ignore */
      }
      if (!images.length) images = p.imageUrl ? [p.imageUrl] : []

      if (images.length) {
        const imgwrap = document.createElement('div')
        imgwrap.className = 'tpopup__imgwrap'

        const link = document.createElement('a')
        link.className = 'tpopup__img'
        link.href = to
        const img = document.createElement('img')
        img.src = images[0]
        img.alt = ''
        link.appendChild(img)
        imgwrap.appendChild(link)

        if (images.length > 1) {
          let imgIdx = 0
          const prev = document.createElement('button')
          prev.className = 'tpopup__arrow tpopup__arrow--prev'
          prev.type = 'button'
          prev.textContent = '<'
          prev.addEventListener('click', (ev) => {
            ev.stopPropagation()
            imgIdx = (imgIdx - 1 + images.length) % images.length
            img.src = images[imgIdx]
          })
          const next = document.createElement('button')
          next.className = 'tpopup__arrow tpopup__arrow--next'
          next.type = 'button'
          next.textContent = '>'
          next.addEventListener('click', (ev) => {
            ev.stopPropagation()
            imgIdx = (imgIdx + 1) % images.length
            img.src = images[imgIdx]
          })
          imgwrap.appendChild(prev)
          imgwrap.appendChild(next)
        }

        root.appendChild(imgwrap)
      }

      const body = document.createElement('div')
      body.className = 'tpopup__body'
      body.innerHTML =
        `<a class="tpopup__species" href="${to}">${escapeHtml(p.species ?? '')}</a>` +
        `<a class="tpopup__name" href="${to}">${escapeHtml(p.name ?? '')}</a>` +
        `<a class="tpopup__link" href="/${locale}/log/${encodeURIComponent(p.dateSpotted ?? '')}">${escapeHtml(linkLabel)}</a>`
      root.appendChild(body)

      return root
    }

    // Build the carousel popup for a cluster of sightings.
    function carouselNode(leaves: any[]): HTMLElement {
      const root = document.createElement('div')
      root.className = 'cpopup'
      const count = leaves.length

      const slide = (i: number) => {
        const p = leaves[i].properties
        const to = `/${locale}/mushrooms/${encodeURIComponent(p.id ?? '')}`

        const stage = document.createElement('div')
        stage.className = 'cpopup__stage'

        let images: string[] = []
        try {
          images = JSON.parse(p.imageUrls || '[]')
        } catch {
          /* ignore */
        }
        if (!images.length) images = p.imageUrl ? [p.imageUrl] : []

        if (images.length) {
          const imgwrap = document.createElement('div')
          imgwrap.className = 'cpopup__imgwrap'

          const link = document.createElement('a')
          link.className = 'cpopup__img'
          link.href = to
          const img = document.createElement('img')
          img.src = images[0]
          img.alt = ''
          link.appendChild(img)
          imgwrap.appendChild(link)

          if (images.length > 1) {
            let imgIdx = 0
            const prev = document.createElement('button')
            prev.className = 'cpopup__arrow cpopup__arrow--prev'
            prev.type = 'button'
            prev.textContent = '<'
            prev.addEventListener('click', (ev) => {
              ev.stopPropagation()
              imgIdx = (imgIdx - 1 + images.length) % images.length
              img.src = images[imgIdx]
            })
            const next = document.createElement('button')
            next.className = 'cpopup__arrow cpopup__arrow--next'
            next.type = 'button'
            next.textContent = '>'
            next.addEventListener('click', (ev) => {
              ev.stopPropagation()
              imgIdx = (imgIdx + 1) % images.length
              img.src = images[imgIdx]
            })
            imgwrap.appendChild(prev)
            imgwrap.appendChild(next)
          }

          stage.appendChild(imgwrap)
        }

        const body = document.createElement('div')
        body.className = 'cpopup__body'
        body.innerHTML =
          `<a class="cpopup__species" href="${to}">${escapeHtml(p.species ?? '')}</a>` +
          `<a class="cpopup__name" href="${to}">${escapeHtml(p.name ?? '')}</a>` +
          `<a class="cpopup__link" href="/${locale}/log/${encodeURIComponent(p.dateSpotted ?? '')}">${escapeHtml(linkLabel)}</a>`
        stage.appendChild(body)

        stageRoot.replaceChildren(stage)
        idx.textContent = `${i + 1} / ${count}`
      }

      const stageRoot = document.createElement('div')
      stageRoot.className = 'cpopup__stageroot'

      const nav = document.createElement('div')
      nav.className = 'cpopup__nav'

      const idx = document.createElement('span')
      idx.className = 'cpopup__count'

      const prev = document.createElement('button')
      prev.className = 'cpopup__btn'
      prev.type = 'button'
      prev.textContent = '<'
      prev.addEventListener('click', (ev) => {
        ev.stopPropagation()
        current = (current - 1 + count) % count
        slide(current)
      })

      const next = document.createElement('button')
      next.className = 'cpopup__btn'
      next.type = 'button'
      next.textContent = '>'
      next.addEventListener('click', (ev) => {
        ev.stopPropagation()
        current = (current + 1) % count
        slide(current)
      })

      nav.append(prev, idx, next)
      root.append(stageRoot, nav)

      let current = 0
      slide(current)
      return root
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
    }
  }

  function initMap() {
    const container = document.getElementById('map')
    if (!container) return

    const lat = 47.4917,
      lon = 11.0922
    const ar = container.clientWidth / container.clientHeight

    const dLat = 15 / 111.32
    const dLon = (15 * ar) / (111.32 * Math.cos((lat * Math.PI) / 180))
    const w = lon - dLon,
      e = lon + dLon
    const s = lat - dLat,
      n = lat + dLat

    const map = new maplibregl.Map({
      container,
      style: STYLE_URL,
      center: [lon, lat],
      bounds: [
        [w, s],
        [e, n],
      ],
    })

    map.on('load', () => {
      applyPalette(map)
      addHikingLayers(map)
      addContours(map)

      // Mask first so the viewport is always framed, even if a later layer
      // fails. Everything outside the 15 km box stays hidden behind it.
      const mask = {
        type: 'FeatureCollection',
        features: [
          {
            type: 'Feature',
            properties: {},
            geometry: {
              type: 'Polygon',
              coordinates: [
                [
                  [-180, -90],
                  [180, -90],
                  [180, 90],
                  [-180, 90],
                  [-180, -90],
                ],
                [
                  [w, s],
                  [w, n],
                  [e, n],
                  [e, s],
                  [w, s],
                ],
              ],
            },
          },
        ],
      }

      map.addSource('box-mask', { type: 'geojson', data: mask })
      map.addLayer({
        id: 'box-mask-fill',
        type: 'fill',
        source: 'box-mask',
        paint: { 'fill-color': '#141414', 'fill-opacity': 1 },
      })
      map.addLayer({
        id: 'box-mask-outline',
        type: 'line',
        source: 'box-mask',
        paint: { 'line-color': '#4a6a4a', 'line-width': 1.5 },
      })

      try {
        addSightings(map, JSON.parse(container.dataset.sightings || '[]'))
      } catch (err) {
        console.error('[map] addSightings failed:', err)
      }
    })

    map.on('error', (e: any) => {
      console.error('[map] maplibre error:', e?.error)
    })

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right')
  }

  if (document.readyState !== 'loading') initMap()
