</pre>
    <h1 class="hero__title">{t.home.heroTitle}</h1>
    <p class="hero__line">{'─'.repeat(50)}</p>
    <p class="hero__desc">{t.home.heroDescription}</p>
    <div class="hero__actions">
      <a href={mapUrl} class="tui-btn">
        {'>'}
        {t.home.heroCta}
      </a>
      <a href={logUrl} class="tui-btn">
        {'>'}
        {t.home.heroLogCta}
      </a>
      <a href={mushroomsUrl} class="tui-btn">
        {'>'}
        {t.home.heroMushroomsCta}
      </a>
    </div>
  </section>

  <Notice margin={false} title={t.home.warningTitle} body={t.home.warningText} />

  <section class="news">
    <div class="news__head">
      <span class="news__title">╔══ {t.home.newsTitle}</span>
    </div>
    <NewsFeed locale={locale} />
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 2rem 0 2.5rem;
  }

  .hero__ascii {
    line-height: 1.2;
    color: var(--accent);
    text-shadow: 0 0 10px rgba(51, 255, 51, 0.3);
    margin-bottom: 1.25rem;
    white-space: pre;
    overflow-x: auto;
    max-width: 100%;
    width: 100%;
    box-sizing: border-box;
  }

  .hero__ascii--wordmark {
    font-size: clamp(0.3125rem, 1.1vw, 0.625rem);
  }

  .hero__ascii--art {
    font-size: clamp(0.4125rem, 1.2vw, 0.725rem);
  }

  .hero__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--fg-bright);
    margin-bottom: 0.75rem;
  }

  .hero__line {
    color: var(--fg-subtle);
    overflow: hidden;
    margin-bottom: 1rem;
    white-space: nowrap;
  }

  .hero__desc {
    color: var(--fg-dim);
    max-width: 520px;
    margin: 0 auto 1.5rem;
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tui-btn {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--accent-dim);
    color: var(--accent);
    text-decoration: none;
    font-size: 0.875rem;
    transition:
      background 0.1s,
      color 0.1s;
  }

  .tui-btn:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .news {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .news__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-char);
    margin-bottom: 1rem;
  }

  .news__title {
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 1.5rem 0 2rem;
    }
  }
</style>
