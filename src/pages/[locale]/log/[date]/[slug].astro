---
import Layout from '../../../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import Notice from '../../../../components/Notice.astro'
import { enrichSighting, buildSpeciesMap } from '../../../../lib/sightings'
import { getTranslations, formatDate, locales } from '../../../../i18n'
import { l10n } from '../../../../i18n/helpers'
import type { Locale } from '../../../../i18n'

export function getStaticPaths() {
  return Promise.resolve(
    (async () => {
      const sightings = await getCollection('sightings')
      return sightings.flatMap((s) => {
        const [date, slug] = s.id.split('/')
        return locales.map((locale) => ({ params: { locale, date, slug } }))
      })
    })(),
  )
}

const { locale, date, slug } = Astro.params as { locale: Locale; date: string; slug: string }
const t = getTranslations(locale)
const sightingId = `${date}/${slug}`

const [all, species, authors] = await Promise.all([
  getCollection('sightings'),
  getCollection('species'),
  getCollection('authors'),
])
const entry = all.find((s) => s.id === sightingId)
const sighting = entry ? enrichSighting(entry, buildSpeciesMap(species)) : undefined
const authorNames = new Map(authors.map((a) => [a.id, a.data.name]))
const fullSrcs = sighting
  ? await Promise.all(
      sighting.images.map(async (img) => (await getImage({ src: img, width: 1600 }))?.src ?? ''),
    )
  : []

// Re-ordering the gallery (choosing the main photo) is a dev-only workflow.
const dev = import.meta.env.DEV

const pageTitle = sighting ? `${l10n(sighting.species.commonName, locale)} — myco.log` : 'myco.log'
---

<Layout title={pageTitle} locale={locale}>
  <section class="sighting-page">
    <div class="page-header">
      <span class="page-header__tag"
        >╔══ {sighting ? l10n(sighting.species.commonName, locale) : t.sighting.missing}</span
      >
      <span class="page-header__sub">{sighting?.species.scientificName}</span>
    </div>

    <div class="back">
      <a href={`/${locale}/log/${date}`} class="tui-link">{'<'} {t.sighting.day}</a>
      <span class="back__sep">·</span>
      <a href={`/${locale}/mushrooms/${sighting?.id}`} class="tui-link">{t.sighting.species}</a>
    </div>

    {
      sighting && (
        <>
          {dev && <Notice margin={false} body={t.sighting.devOnly} />}

          <div class="gallery" data-lightbox-group>
            {sighting.images.map((img, i) => (
              <figure
                class:list={['gallery__item', dev && i === 0 && 'gallery__item--cover']}
                data-lightbox-src={fullSrcs[i]}
              >
                <Image
                  src={img}
                  alt={`${l10n(sighting.species.commonName, locale)} — ${i + 1}`}
                  loading="lazy"
                  widths={[320, 640]}
                />
                <button
                  type="button"
                  class="gallery__full"
                  data-lightbox-trigger
                  data-index={i}
                  aria-label={`${t.sighting.fullscreen} ${i + 1}`}
                  title={t.sighting.fullscreen}
                >
                  ⛶
                </button>
                {dev && (
                  <button
                    type="button"
                    class="gallery__cover"
                    data-cover
                    data-date={date}
                    data-slug={slug}
                    data-image={img.src}
                    disabled={i === 0}
                    title={i === 0 ? t.sighting.mainPhoto : t.sighting.setMainPhoto}
                  >
                    {i === 0 ? t.sighting.mainPhoto : t.sighting.setMainPhoto}
                  </button>
                )}
              </figure>
            ))}
          </div>

          {dev && <span id="cover-status" class="cover-status" role="status" />}

          <div class="facts">
            <div class="fact-row">
              <span class="fact-lbl">{t.sighting.location}</span>
              <span class="fact-dot" />
              <span class="fact-val">
                {l10n(sighting.location.name, locale) || t.mushrooms.unknown}
              </span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">{t.sighting.coordinates}</span>
              <span class="fact-dot" />
              <span class="fact-val">
                {sighting.location.lat.toFixed(5)}°N {sighting.location.lng.toFixed(5)}°E
              </span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">{t.sighting.spotted}</span>
              <span class="fact-dot" />
              <span class="fact-val">{formatDate(sighting.dateSpotted, locale)}</span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">{t.sighting.identified}</span>
              <span class="fact-dot" />
              <span class="fact-val">{formatDate(sighting.dateIdentified, locale)}</span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">{t.sighting.authors}</span>
              <span class="fact-dot" />
              <span class="fact-val">
                {(sighting.authors ?? []).map((a) => authorNames.get(a) ?? a).join(', ')}
              </span>
            </div>
          </div>

          {sighting.notes && (
            <section class="block">
              <div class="block__hdr">╔═ {t.sighting.sightingNotes}</div>
              <p class="block__notes">{l10n(sighting.notes, locale)}</p>
            </section>
          )}

          {sighting.species.habitat && (
            <section class="block">
              <div class="block__hdr">╔═ {t.mushrooms.habitat}</div>
              <p class="block__notes">{l10n(sighting.species.habitat, locale)}</p>
            </section>
          )}

          {sighting.species.edibility && (
            <section class="block">
              <div class="block__hdr">╔═ {t.mushrooms.edibility}</div>
              <p class="block__notes">{l10n(sighting.species.edibility, locale)}</p>
            </section>
          )}

          {sighting.species.determiningFeatures.length > 0 && (
            <section class="block">
              <div class="block__hdr">╔═ {t.mushrooms.features}</div>
              <ul class="block__list">
                {sighting.species.determiningFeatures.map((f) => (
                  <li>▸ {l10n(f, locale)}</li>
                ))}
              </ul>
            </section>
          )}

          {sighting.species.notes && (
            <section class="block">
              <div class="block__hdr">╔═ {t.mushrooms.notes}</div>
              <p class="block__notes">{l10n(sighting.species.notes, locale)}</p>
            </section>
          )}
        </>
      )
    }
  </section>

  <script
    is:inline
    define:vars={{
      coverEnabled: dev,
      coverT: {
        updating: t.sighting.updating,
        updated: t.sighting.mainUpdated,
        error: t.sighting.error,
      },
    }}
  >
    if (!coverEnabled) {
      // noop in the production build (buttons aren't rendered there either)
    } else {
      const statusEl = document.getElementById('cover-status')
      document.querySelectorAll('[data-cover]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const payload = {
            date: btn.dataset.date,
            slug: btn.dataset.slug,
            image: btn.dataset.image,
          }
          btn.disabled = true
          if (statusEl) {
            statusEl.textContent = coverT.updating
            statusEl.dataset.state = 'pending'
          }
          try {
            const res = await fetch('/myco/api/sightings/cover', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            })
            if (!res.ok) {
              const err = await res.json().catch(() => ({}))
              throw new Error(err.error || 'HTTP ' + res.status)
            }
            if (statusEl) {
              statusEl.textContent = coverT.updated
              statusEl.dataset.state = 'ok'
            }
            window.location.reload()
          } catch (err) {
            console.error('[cover] failed:', err)
            if (statusEl) {
              statusEl.textContent =
                coverT.error + (err instanceof Error ? ' — ' + err.message : '')
              statusEl.dataset.state = 'error'
            }
            btn.disabled = false
          }
        })
      })
    }
  </script>
</Layout>

<style>
  .sighting-page {
    padding-bottom: 2rem;
  }

  .page-header {
    margin-bottom: 1rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--accent-dim);
    font-size: 0.8125rem;
  }

  .back {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .back__sep {
    color: var(--fg-muted);
  }

  .tui-link {
    color: var(--accent-dim);
    text-decoration: none;
    font-size: 0.8125rem;
  }

  .tui-link:hover {
    color: var(--accent);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .gallery__item {
    margin: 0;
    border: 1px solid var(--fg-muted);
    overflow: hidden;
    background: var(--bg-highlight);
    aspect-ratio: 4 / 3;
    position: relative;
  }

  .gallery__item.gallery__item--cover {
    border-color: var(--accent);
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .gallery__cover {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(14, 18, 11, 0.75);
    border: none;
    border-top: 1px solid var(--border-char);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    transition:
      background 0.1s,
      color 0.1s;
  }

  .gallery__cover:hover:not(:disabled) {
    background: var(--accent);
    color: var(--bg);
  }

  .gallery__cover:disabled {
    color: var(--yellow);
    cursor: default;
  }

  .gallery__full {
    position: absolute;
    top: 0.25rem;
    left: 0.25rem;
    background: rgba(14, 18, 11, 0.75);
    border: 1px solid var(--border-char);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    opacity: 0;
    transition:
      background 0.1s,
      color 0.1s,
      opacity 0.15s;
  }

  .gallery__item:hover .gallery__full,
  .gallery__full:focus-visible {
    opacity: 1;
  }

  .gallery__full:hover {
    background: var(--accent);
    color: var(--bg);
  }

  @media (hover: none) {
    .gallery__full {
      opacity: 1;
    }
  }

  .cover-status {
    display: block;
    margin: -0.25rem 0 1.25rem;
    font-size: 0.75rem;
  }

  .cover-status[data-state='error'] {
    color: var(--red);
  }

  .cover-status[data-state='ok'] {
    color: var(--accent);
  }

  .cover-status[data-state='pending'] {
    color: var(--fg-dim);
  }

  .facts {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.5rem 0.75rem;
    margin-bottom: 1.25rem;
    font-size: 0.8125rem;
  }

  .fact-row {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    line-height: 1.8;
  }

  .fact-lbl {
    color: var(--fg-dim);
    flex-shrink: 0;
    font-size: 0.75rem;
  }

  .fact-dot {
    flex: 1;
    border-bottom: 1px dotted var(--fg-muted);
    min-width: 0.5rem;
    margin-bottom: 0.2em;
  }

  .fact-val {
    color: var(--fg-bright);
    text-align: right;
  }

  .block {
    margin-bottom: 1.25rem;
  }

  .block__hdr {
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 0.8125rem;
    margin-bottom: 0.5rem;
  }

  .block__list {
    list-style: none;
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.75rem;
  }

  .block__list li {
    color: var(--fg);
    line-height: 1.9;
    font-size: 0.8125rem;
  }

  .block__notes {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.75rem;
    color: var(--fg);
    font-style: italic;
    line-height: 1.7;
    font-size: 0.8125rem;
  }
</style>
