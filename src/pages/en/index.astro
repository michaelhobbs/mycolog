---
import Layout from '../../layouts/Layout.astro';
import MushroomCard from '../../components/MushroomCard.astro';
import { getCollection } from 'astro:content';
import { getTranslations } from '../../i18n';
import type { Locale } from '../../i18n';

const locale: Locale = 'en';
const t = getTranslations(locale);

const recentSightings = (await getCollection('sightings'))
  .sort(
    (a, b) =>
      new Date(b.data.dateSpotted).getTime() - new Date(a.data.dateSpotted).getTime(),
  )
  .slice(0, 6);
---

<Layout title="myco.log — mushroom sightings" locale={locale}>
  <section class="hero">
    <pre
      class="hero__ascii"
      aria-hidden="true">
