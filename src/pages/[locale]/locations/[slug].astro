---
import Layout from '../../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import MiniMap from '../../../components/MiniMap.astro'
import Notice from '../../../components/Notice.astro'
import { getTranslations, formatDate, locales } from '../../../i18n'
import { l10n } from '../../../i18n/helpers'
import type { Locale } from '../../../i18n'
import { buildLocationMap, locationName } from '../../../lib/sightings'

export function getStaticPaths() {
  return Promise.resolve(
    (async () => {
      const locations = await getCollection('locations')
      return locations.flatMap((l) => locales.map((locale) => ({ params: { locale, slug: l.id } })))
    })(),
  )
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string }
const t = getTranslations(locale)

const [locations, sightings, species] = await Promise.all([
  getCollection('locations'),
  getCollection('sightings'),
  getCollection('species'),
])
const locMap = buildLocationMap(locations)
const location = locations.find((l) => l.id === slug)

const entries = sightings
  .filter((s) => s.data.locationSlug === slug)
  .sort((a, b) => (a.data.dateSpotted < b.data.dateSpotted ? -1 : 1))

const name = location ? locationName(locMap, location.id, locale) : slug
const speciesName = new Map(species.map((sp) => [sp.id, sp.data]))
---

<Layout title={`${name} — myco.log`} locale={locale}>
  <section class="location-page">
    <Notice body={t.locations.aiDisclaimer} />

    <div class="page-header">
      <span class="page-header__tag">╔══ {name}</span>
      <span class="page-header__sub">
        {entries.length}{' '}
        {t.locations.sightings}
      </span>
    </div>

    <div class="back">
      <a href={`/${locale}/locations`} class="tui-link">{'<'} {t.locations.backToIndex}</a>
    </div>

    {
      location && (
        <>
          {location.data.description && (
            <section class="block">
              <div class="block__hdr">╔═ {t.locations.description}</div>
              <p class="block__notes">{l10n(location.data.description, locale)}</p>
            </section>
          )}

          <div class="facts">
            <div class="fact-row">
              <span class="fact-lbl">{t.locations.forestType}</span>
              <span class="fact-dot" />
              <span class="fact-val">
                {location.data.forestType ? l10n(location.data.forestType, locale) : '—'}
              </span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">{t.locations.soilType}</span>
              <span class="fact-dot" />
              <span class="fact-val">
                {location.data.soilType ? l10n(location.data.soilType, locale) : '—'}
              </span>
            </div>
          </div>

          {entries.length > 0 && (
            <MiniMap
              region={
                location.data.center
                  ? { lat: location.data.center.lat, lng: location.data.center.lng, radiusKm: 1 }
                  : undefined
              }
              points={entries.map((e) => ({
                lat: e.data.location.lat,
                lng: e.data.location.lng,
                label: l10n(speciesName.get(e.data.species)?.commonName, locale) || undefined,
              }))}
            />
          )}

          {entries.length > 0 && (
            <section class="block">
              <div class="block__hdr">
                ╔═ {t.locations.sightings} ({entries.length})
              </div>
              <ul class="block__sightings">
                {entries.map((e) => {
                  const sd = e.data
                  const cover = sd.images?.[0]
                  const sp = speciesName.get(sd.species)
                  return (
                    <li class="sighting">
                      {cover && (
                        <a href={`/${locale}/log/${e.id}`} class="sighting__img">
                          <Image src={cover} alt="" loading="lazy" width={96} />
                        </a>
                      )}
                      <div class="sighting__body">
                        <a href={`/${locale}/log/${e.id}`} class="sighting__date">
                          {formatDate(sd.dateSpotted, locale)}
                        </a>
                        <a href={`/${locale}/mushrooms/${sd.species}`} class="sighting__species">
                          {l10n(sp?.commonName, locale)}
                          {sp?.scientificName ? ` (${sp.scientificName})` : ''}
                        </a>
                      </div>
                    </li>
                  )
                })}
              </ul>
            </section>
          )}
        </>
      )
    }
  </section>
</Layout>

<style>
  .location-page {
    padding-bottom: 2rem;
  }

  .page-header {
    margin-bottom: 1rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--accent-dim);
    font-size: 0.8125rem;
  }

  .back {
    margin-bottom: 1.25rem;
  }

  .tui-link {
    color: var(--accent-dim);
    text-decoration: none;
    font-size: 0.8125rem;
  }

  .tui-link:hover {
    color: var(--accent);
  }

  .facts {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.5rem 0.75rem;
    margin-bottom: 1.25rem;
    font-size: 0.8125rem;
  }

  .fact-row {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    line-height: 1.8;
  }

  .fact-lbl {
    color: var(--fg-dim);
    flex-shrink: 0;
    font-size: 0.75rem;
  }

  .fact-dot {
    flex: 1;
    border-bottom: 1px dotted var(--fg-muted);
    min-width: 0.5rem;
    margin-bottom: 0.2em;
  }

  .fact-val {
    color: var(--fg-bright);
    text-align: right;
  }

  .block {
    margin-bottom: 1.25rem;
  }

  .block__hdr {
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 0.8125rem;
    margin-bottom: 0.5rem;
  }

  .block__notes {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.75rem;
    color: var(--fg);
    font-style: italic;
    line-height: 1.7;
    font-size: 0.8125rem;
  }

  .block__sightings {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sighting {
    display: flex;
    gap: 0.75rem;
    padding: 0.5rem;
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    font-size: 0.8125rem;
  }

  .sighting__img {
    width: 72px;
    height: 56px;
    flex-shrink: 0;
    border: 1px solid var(--fg-muted);
    overflow: hidden;
    background: var(--bg-highlight);
  }

  .sighting__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sighting__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .sighting__date {
    color: var(--yellow);
    font-weight: 700;
    text-decoration: none;
  }

  .sighting__date:hover {
    color: var(--fg-bright);
  }

  .sighting__species {
    color: var(--fg);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sighting__species:hover {
    color: var(--accent);
  }
</style>
