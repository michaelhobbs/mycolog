---
// A nomenclatural name with its authority, as the topology blocks show it:
// the name split so the rank abbreviation stays upright between two italic
// runs ("Amanita muscaria" var. "muscaria"), then authorship and year.
//
// The split happens in the caller (frontmatter helpers cannot return JSX),
// so this component only renders the parts it is handed.
//
// The rank marker (`var.`, `subsp.`, `f.` …) is run through GlossaryTerm, so
// every infraspecific option in the Nomenclature block carries the same
// tooltip as the value names elsewhere. A marker with no glossary entry --
// `lusus`, should one ever appear -- renders as plain text.
import GlossaryTerm from './GlossaryTerm.astro'
import { rankEntryForMarker } from '../data/glossary'

interface Parts {
  base: string
  marker: string
  tail: string
}

interface Props {
  parts: Parts
  /** Authorship plus publication year, already joined — may be empty. */
  cite?: string
}

const { parts, cite } = Astro.props
const mark = parts.marker ? rankEntryForMarker(parts.marker) : undefined
---

<span class="nm">
  <em>{parts.base}</em>
  {
    parts.marker && (
      <span class="nm__rank">
        <GlossaryTerm id={mark?.id}>{parts.marker}</GlossaryTerm>
      </span>
    )
  }
  {parts.tail && <em>{parts.tail}</em>}
  {cite && <span class="nm__cite">{cite}</span>}
</span>

<style>
  .nm {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.3em;
  }

  .nm__rank {
    color: var(--fg-bright);
    font-style: normal;
    font-size: 0.8125rem;
  }

  .nm__cite {
    margin-left: 0.4em;
    color: var(--fg-dim);
    font-size: 0.75rem;
    font-style: normal;
  }
</style>
