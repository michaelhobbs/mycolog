---
import type { Locale } from '../i18n'
import { getTranslations, locales, defaultLocale } from '../i18n'
import { getRelativeLocaleUrl } from 'astro:i18n'
import Lightbox from '../components/Lightbox.astro'
import SiteSearch from '../components/SiteSearch.astro'
import '../styles/theme.css'

interface Props {
  title: string
  locale?: Locale
}

const { title, locale = defaultLocale } = Astro.props
const t = getTranslations(locale)
const currentPath = Astro.url.pathname

function localizedPath(targetLocale: Locale): string {
  const subPath = currentPath.replace(/^\/(en|de)(\/|$)/, '/').replace(/^\/$/, '')
  return getRelativeLocaleUrl(targetLocale, subPath)
}
---

<!doctype html>
<html lang={t.lang} data-theme="tui">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={t.meta.homeDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title="myco.log" href="/rss.xml" />
    <title>{title}</title>
    <!--
      Apply the stored theme before first paint so a mono reader never sees a
      flash of the default palette. Validation is deliberately absent: an
      unknown value simply fails to match a theme block and renders the
      default palette, which is the correct fallback.
    -->
    <script is:inline>
      try {
        var stored = localStorage.getItem('myco-theme')
        if (stored) document.documentElement.setAttribute('data-theme', stored)
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="header">
      <nav class="nav">
        <a href={`/${locale}`} class="nav__logo">
          <span class="nav__logo-icon" aria-hidden="true">@(</span>
          <span class="nav__logo-text">myco.log</span>
        </a>

        <span class="nav__sep" aria-hidden="true">│</span>

        <div class="nav__links">
          <a
            href={`/${locale}`}
            class:list={[
              'nav__link',
              {
                'nav__link--active': currentPath === `/${locale}` || currentPath === `/${locale}/`,
              },
            ]}>[{t.nav.home}]</a
          >
          <a
            href={`/${locale}/log`}
            class:list={['nav__link', { 'nav__link--active': currentPath.includes('/log') }]}
            >[{t.nav.log}]</a
          >
          <a
            href={`/${locale}/mushrooms`}
            class:list={['nav__link', { 'nav__link--active': currentPath.includes('/mushrooms') }]}
            >[{t.nav.mushrooms}]</a
          >
          <a
            href={`/${locale}/locations`}
            class:list={['nav__link', { 'nav__link--active': currentPath.includes('/locations') }]}
            >[{t.nav.locations}]</a
          >
          <a
            href={`/${locale}/map`}
            class:list={['nav__link', { 'nav__link--active': currentPath.includes('/map') }]}
            >[{t.nav.map}]</a
          >
          <a
            href={`/${locale}/backlog`}
            class:list={['nav__link', { 'nav__link--active': currentPath.includes('/backlog') }]}
            >[{t.nav.backlog}]</a
          >
          <a
            href={`/${locale}/identifications`}
            class:list={[
              'nav__link',
              { 'nav__link--active': currentPath.includes('/identifications') },
            ]}>[{t.nav.identifications}]</a
          >
        </div>

        <!--
          Immediately before `.nav__lang`, which keeps the control to the left of
          the language selector as the reader expects on desktop. `.search` then
          carries the `margin-left: auto` that parks it hard right.

          `.nav__lang` has an `auto` of its own and a flex container *splits* the
          free space between every `auto` it finds, which would strand the glyph
          mid-bar with an equal gap either side — hence the pair of rules below
          that zero the neighbours' `auto` while this control is present. They
          are gated on `:not([hidden])` so a JS-off reader, or a page with no
          `SiteSearch` at all, keeps its right alignment.
        -->
        <SiteSearch locale={locale} />

        <!--
          Theme toggle. Shows the theme you would switch TO next (`[mono]`
          while dark, cycling `tui → mono → brut → neobrut`), so the visible
          label and the aria-label both name the action the click performs.
          Ships `hidden` like `.search` and `.nav__date`: with JS off there is
          no dead control, and the script reveals it only once it can also
          restore the stored choice.
        -->
        <button
          class="nav__theme"
          type="button"
          data-theme-toggle
          data-label-tui={t.nav.themeTui}
          data-label-mono={t.nav.themeMono}
          data-label-brut={t.nav.themeBrut}
          data-label-neo={t.nav.themeNeo}
          data-label-nord={t.nav.themeNord}
          data-label-gruvbox={t.nav.themeGruvbox}
          data-label-solarized={t.nav.themeSolarized}
          data-label-catppuccin={t.nav.themeCatppuccin}
          data-label-phosphor={t.nav.themePhosphor}
          hidden
        >
          <span data-theme-toggle-label>[tui]</span>
        </button>

        <div class="nav__lang">
          {
            locales.map((loc, i) => (
              <>
                {i > 0 && (
                  <span class="nav__lang-sep" aria-hidden="true">
                    /
                  </span>
                )}
                <a
                  href={localizedPath(loc)}
                  class:list={['nav__lang-btn', { 'nav__lang-btn--active': loc === locale }]}
                >
                  {loc}
                </a>
              </>
            ))
          }
        </div>

        <!--
          The date-drawer toggle lives in the shared header, but only the pages
          that actually render a drawer may show it: `DateRail`'s script removes
          `hidden` when it finds the drawer it controls. Do not drop the
          attribute — on the other 965 pages nothing would ever remove it.
        -->
        <button
          class="nav__date"
          type="button"
          data-rail-toggle
          aria-expanded="false"
          aria-controls="rail-drawer"
          hidden
        >
          <svg
            class="nav__date-icon"
            viewBox="0 0 16 16"
            width="14"
            height="14"
            stroke-width="1.25"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="1.5" y="3.5" width="13" height="11" fill="none" stroke="currentColor"></rect>
            <path d="M1.5 7h13M5 1.5v4M11 1.5v4" fill="none" stroke="currentColor"></path>
          </svg>
          <span>{t.common.changeDate}</span>
        </button>

        <button class="nav__mobile-toggle" aria-label="Menu" data-mobile-toggle>
          <span>[=]</span>
        </button>
      </nav>

      <div class="nav__mobile-menu" data-mobile-menu>
        <a href={`/${locale}`} class="nav__mobile-link">{'>'} {t.nav.home}</a>
        <a href={`/${locale}/log`} class="nav__mobile-link">{'>'} {t.nav.log}</a>
        <a href={`/${locale}/mushrooms`} class="nav__mobile-link">{'>'} {t.nav.mushrooms}</a>
        <a href={`/${locale}/locations`} class="nav__mobile-link">{'>'} {t.nav.locations}</a>
        <a href={`/${locale}/map`} class="nav__mobile-link">{'>'} {t.nav.map}</a>
        <a href={`/${locale}/backlog`} class="nav__mobile-link">{'>'} {t.nav.backlog}</a>
        <a href={`/${locale}/identifications`} class="nav__mobile-link">
          {'> '}
          {t.nav.identifications}
        </a>
        <div class="nav__mobile-lang">
          {
            locales.map((loc) => (
              <a
                href={localizedPath(loc)}
                class:list={['nav__lang-btn', { 'nav__lang-btn--active': loc === locale }]}
              >
                {loc}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main class="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer__inner">
        <span class="footer__content">
          <span>{t.footer.copyright}</span>
          <a
            class="footer__rss"
            href={`/${locale}/rss.xml`}
            rel="alternate"
            type="application/rss+xml"
          >
            {t.footer.rss}
          </a>
        </span>
      </div>
    </footer>

    <Lightbox locale={locale} />

    <script>
      // ─── Theme toggle ───────────────────────────────────────────────
      // The stored value is applied by the inline head script (before first
      // paint); this only wires the control. Each click advances to the next
      // theme in THEMES (wrapping), persists it, updates the label to that
      // next theme, and fires `myco:theme` so live maps repaint (see
      // src/lib/map-palette.ts). An unknown stored value renders the default
      // palette, so the first click from it lands on `tui` — the theme that
      // is actually on screen.
      const THEMES = [
        'tui',
        'mono',
        'brut',
        'neobrut',
        'nord',
        'gruvbox',
        'solarized',
        'catppuccin',
        'phosphor',
      ] as const
      const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
      if (themeBtn) {
        const root = document.documentElement
        const themeLabel = themeBtn.querySelector('[data-theme-toggle-label]')
        const nextTheme = () => {
          const i = THEMES.indexOf(root.dataset.theme as (typeof THEMES)[number])
          return THEMES[(i + 1 + THEMES.length) % THEMES.length]
        }
        const syncTheme = () => {
          const next = nextTheme()
          if (themeLabel) themeLabel.textContent = `[${next}]`
          const key = ('label' + next[0].toUpperCase() + next.slice(1)) as `label${string}`
          themeBtn.setAttribute('aria-label', themeBtn.dataset[key] ?? '')
        }
        syncTheme()
        themeBtn.hidden = false
        themeBtn.addEventListener('click', () => {
          const next = nextTheme()
          root.dataset.theme = next
          try {
            localStorage.setItem('myco-theme', next)
          } catch {}
          syncTheme()
          window.dispatchEvent(new CustomEvent('myco:theme'))
        })
      }

      document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.querySelector('[data-mobile-toggle]')
        const menu = document.querySelector('[data-mobile-menu]')
        if (!toggle || !menu) return
        toggle.addEventListener('click', () => {
          menu.classList.toggle('nav__mobile-menu--open')
        })
      })
      const ref = (() => {
        try {
          return new URL(document.referrer)
        } catch {
          return null
        }
      })()
      if (ref && ref.origin === location.origin) {
        document.querySelectorAll('[data-back]').forEach((a) => {
          a.setAttribute('href', ref.href)
          a.setAttribute('data-back', 'pop')
        })
      }
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement | null)?.closest?.('[data-back]')
        if (!a) return
        if (a.getAttribute('data-back') === 'pop') {
          e.preventDefault()
          if (history.length > 1) history.back()
          else if (a instanceof HTMLAnchorElement && a.href) location.href = a.href
        }
      })
    </script>
  </body>
</html>

<style is:global>
  /* ─── Reset ────────────────────────────────────── */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.65;
    color: var(--fg);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  img {
    display: block;
    max-width: 100%;
  }
  a {
    color: inherit;
  }

  :target {
    scroll-margin-top: calc(var(--header-h) + 0.5rem);
  }

  /* ─── Header / Nav ────────────────────────────── */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border-char);
  }

  .nav {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__logo-icon {
    color: var(--accent-text);
    font-weight: 700;
  }

  .nav__logo-text {
    color: var(--fg-bright);
    font-weight: 700;
  }

  .nav__sep {
    color: var(--fg-subtle);
  }

  .nav__links {
    display: flex;
    gap: 0.5rem;
  }

  .nav__link {
    color: var(--fg-dim);
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color 0.1s;
  }

  .nav__link:hover {
    color: var(--fg-bright);
  }

  .nav__link--active {
    color: var(--accent-text);
  }

  .nav__lang {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
  }

  /* No `auto` of its own: the free space belongs to `.search` (or
     `.nav__lang` when there is no search), and a third `auto` would split
     the gap and strand the toggle mid-bar. Sits between the two by DOM
     order, so it moves with them at every breakpoint. */
  .nav__theme {
    background: none;
    border: none;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
    padding: 0.25rem;
    transition: color 0.1s;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .nav__theme:hover {
    color: var(--fg-bright);
  }

  .nav__theme:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  /* Restated because an author `display` beats the UA's `[hidden]` rule. */
  .nav__theme[hidden] {
    display: none;
  }

  .nav__lang-sep {
    color: var(--fg-subtle);
  }

  .nav__lang-btn {
    color: var(--fg-dim);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color 0.1s;
  }

  .nav__lang-btn:hover {
    color: var(--fg-bright);
  }

  .nav__lang-btn--active {
    color: var(--accent-text);
  }

  .nav__mobile-toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: none;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 1rem;
    cursor: pointer;
    padding: 0.25rem;
  }

  /*
    `.search` and this bar's other flush-right anchors both claim the free space,
    and a flex container *splits* it between every `margin-left: auto` it finds
    rather than giving it all to the first -- which parked the search glyph
    mid-bar with a second, equal gap before `[=]`. Exactly one may claim it: the
    field once the script has revealed it, and these two before then. The
    `:not([hidden])` is load-bearing in both directions: without it a JS-off
    reader would get two `auto` margins again, and a page with no `SiteSearch`
    at all would lose its right alignment entirely.
  */
  .search:not([hidden]) ~ .nav__mobile-toggle {
    margin-left: 0;
  }

  .search:not([hidden]) ~ .nav__lang {
    margin-left: 0;
  }

  .nav__date {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.5rem;
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    color: var(--fg-dim);
    font: inherit;
    font-size: 0.75rem;
    white-space: nowrap;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    box-shadow: var(--shadow);
    transition: box-shadow 0.1s;
  }

  /* Restated because an author `display` beats the UA's `[hidden]` rule, which
     would leave the button visible on every page. */
  .nav__date[hidden] {
    display: none;
  }

  .nav__date:hover {
    color: var(--fg-bright);
    box-shadow: var(--shadow-press);
  }

  .nav__date[aria-expanded='true'] {
    color: var(--fg-bright);
    border-color: var(--accent-dim);
  }

  .nav__date-icon {
    flex-shrink: 0;
  }

  /* `min-width`, not the `max-width` query below: at exactly 768px both the
     sticky sidebar (`DateRail`) and this query apply, and the drawer is
     `display: none !important` there, so a max-width rule would leave a dead
     button on screen. */
  @media (min-width: 768px) {
    .nav__date {
      display: none;
    }
  }

  .nav__mobile-menu {
    display: none;
    flex-direction: column;
    padding: 0.5rem 1.5rem 1rem;
    gap: 0.25rem;
    border-bottom: 1px solid var(--border-char);
  }

  .nav__mobile-menu--open {
    display: flex;
  }

  .nav__mobile-link {
    color: var(--fg-dim);
    text-decoration: none;
    padding: 0.375rem 0;
  }

  .nav__mobile-lang {
    display: flex;
    gap: 0.5rem;
    padding-top: 0.5rem;
    margin-top: 0.25rem;
    border-top: 1px dashed var(--fg-muted);
  }

  /* ─── Main ────────────────────────────────────── */
  .main {
    flex: 1;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 2rem 1.5rem;
    width: 100%;
  }

  /* ─── Footer ──────────────────────────────────── */
  .footer {
    border-top: 1px solid var(--border-char);
    padding: 1.25rem 1.5rem;
    font-size: 0.8125rem;
  }

  .footer__inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .footer__content {
    color: var(--fg-dim);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer__rss {
    color: var(--fg-subtle);
    text-decoration: none;
    font-size: 0.75rem;
  }

  .footer__rss:hover {
    color: var(--accent-dim);
    text-decoration: underline;
  }

  /* ─── Responsive ──────────────────────────────── */
  @media (max-width: 768px) {
    .nav__links,
    .nav__lang,
    .nav__sep {
      display: none;
    }
    .nav__mobile-toggle {
      display: block;
    }
    .main {
      padding: 1.5rem 1rem;
    }
  }
</style>
