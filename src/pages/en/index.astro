</pre>
    <h1 class="hero__title">{t.home.heroTitle}</h1>
    <p class="hero__line">{'─'.repeat(50)}</p>
    <p class="hero__desc">{t.home.heroDescription}</p>
    <div class="hero__actions">
      <a href={`/${locale}/map`} class="tui-btn">
        {'>'}
        {t.home.heroCta}
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section__header">
      <span class="section__tag">╔══ {t.home.recentTitle}</span>
      <span class="section__sub">{t.home.recentSubtitle}</span>
    </div>

    <div class="grid">
      {
        recentSightings.map((sighting) => (
          <MushroomCard sighting={sighting} locale={locale} />
        ))
      }
    </div>

    <div class="section__footer">
      <a href={`/${locale}/map`} class="tui-link">
        {'>'}
        {t.home.viewAll}
      </a>
    </div>
  </section>

  <section class="info-grid">
    <div class="tui-box tui-box--warn">
      <div class="tui-box__title">╔═ ⚠ {t.home.warningTitle}</div>
      <div class="tui-box__body">{t.home.warningText}</div>
    </div>

    <div class="tui-box tui-box--nature">
      <div class="tui-box__title">╔═ 🌲 {t.home.forestsTitle}</div>
      <div class="tui-box__body">{t.home.forestsText}</div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 2rem 0 2.5rem;
  }

  .hero__ascii {
    font-size: 0.625rem;
    line-height: 1.2;
    color: var(--accent);
    text-shadow: 0 0 10px rgba(51, 255, 51, 0.3);
    margin-bottom: 1.25rem;
    white-space: pre;
    overflow-x: auto;
  }

  .hero__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--fg-bright);
    margin-bottom: 0.75rem;
  }

  .hero__line {
    color: var(--fg-muted);
    overflow: hidden;
    margin-bottom: 1rem;
    white-space: nowrap;
  }

  .hero__desc {
    color: var(--fg-dim);
    max-width: 520px;
    margin: 0 auto 1.5rem;
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
  }

  .tui-btn {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--accent-dim);
    color: var(--accent);
    text-decoration: none;
    font-size: 0.875rem;
    transition:
      background 0.1s,
      color 0.1s;
  }

  .tui-btn:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .section {
    margin-top: 1.5rem;
  }

  .section__header {
    margin-bottom: 1.25rem;
  }

  .section__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 0.9375rem;
    margin-bottom: 0.25rem;
  }

  .section__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .section__footer {
    margin-top: 1.25rem;
  }

  .tui-link {
    color: var(--accent-dim);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color 0.1s;
  }

  .tui-link:hover {
    color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .tui-box {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    font-size: 0.8125rem;
  }

  .tui-box--warn {
    border-color: var(--red);
  }
  .tui-box--warn .tui-box__title {
    color: var(--red);
  }

  .tui-box--nature {
    border-color: var(--accent-dim);
  }
  .tui-box--nature .tui-box__title {
    color: var(--accent);
  }

  .tui-box__title {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px dashed var(--border-char);
    font-weight: 700;
    font-size: 0.8125rem;
  }

  .tui-box__body {
    padding: 0.75rem;
    color: var(--fg-dim);
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 1.5rem 0 2rem;
    }
    .hero__ascii {
      font-size: 0.5rem;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
