---
import Layout from '../../layouts/Layout.astro'
import DateRail from '../../components/DateRail.astro'
import { getCollection } from 'astro:content'
import { getTranslations, locales } from '../../i18n'
import type { RailDay } from '../../lib/date-rail'
import type { Locale } from '../../i18n'

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }
const t = getTranslations(locale)

const backlog = (await getCollection('backlog')).sort((a, b) =>
  a.data.dateSpotted < b.data.dateSpotted ? 1 : -1,
)

const byDate = new Map<string, typeof backlog>()
for (const entry of backlog) {
  const key = entry.data.dateSpotted
  const bucket = byDate.get(key)
  if (bucket) bucket.push(entry)
  else byDate.set(key, [entry])
}

const railDays: RailDay[] = [...byDate.entries()]
  .map(([day, entries]) => {
    const pinned = entries.filter((e) => e.data.location).length
    return {
      date: day,
      count: entries.length,
      meta: `${pinned}/${entries.length} ${t.backlog.pinned}`,
    }
  })
  .sort((a, b) => (a.date < b.date ? 1 : -1))

const counts = `${railDays.length} ${t.log.daysLabel} · ${backlog.length} ${t.backlog.items}`
---

<Layout title={t.meta.backlogTitle} locale={locale}>
  <DateRail
    days={railDays}
    basePath={`/${locale}/backlog`}
    locale={locale}
    countUnit={t.backlog.items}
    navLabel={t.common.jumpToDate}
  >
    <div class="page-header">
      <span class="page-header__tag">╔══ {t.backlog.title}</span>
      <span class="page-header__sub">{t.backlog.subtitle}</span>
    </div>

    <p class="overview__intro">{t.backlog.indexIntro}</p>

    <p class="overview__count">{counts}</p>
  </DateRail>
</Layout>

<style>
  .page-header {
    margin-bottom: 1rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .overview__intro {
    max-width: 34rem;
    margin: 0 0 0.75rem;
    color: var(--fg);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .overview__count {
    max-width: 34rem;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-char);
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }
</style>
