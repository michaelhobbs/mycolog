---
import type { Locale } from '../i18n';
import type { MushroomSighting } from '../types/mushroom';

interface Props {
  sightings: MushroomSighting[];
  locale: Locale;
  center?: [number, number];
  zoom?: number;
}

const {
  sightings,
  locale,
  center = [47.4917, 11.0922],
  zoom = 13,
} = Astro.props;

const sightingsJSON = JSON.stringify(sightings);
---

<div class="map-frame">
  <div class="map-frame__title">
    <span class="map-frame__title-text">[ map ]</span>
    <span class="map-frame__title-coords">{center[0].toFixed(4)}°N {center[1].toFixed(4)}°E</span>
  </div>
  <div
    id="map"
    class="map"
    data-sightings={sightingsJSON}
    data-center={JSON.stringify(center)}
    data-zoom={zoom}
    data-locale={locale}
  ></div>
</div>

<script>
  import L from 'leaflet';

  interface LocalizedString { en: string; de: string; }
  interface Location { lat: number; lng: number; name?: LocalizedString; }
  interface MushroomSighting {
    id: string;
    species: string;
    commonName: LocalizedString;
    dateSpotted: string;
    location: Location;
    imageUrl: string;
    determiningFeatures: LocalizedString[];
    notes?: LocalizedString;
  }

  function l10n(val: LocalizedString | undefined, locale: string): string {
    if (!val) return '';
    return (val as Record<string, string>)[locale] ?? val.en ?? '';
  }

  function formatDate(dateStr: string, locale: string): string {
    const date = new Date(dateStr);
    return date.toLocaleDateString(locale === 'de' ? 'de-DE' : 'en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const mapEl = document.getElementById('map');
    if (!mapEl) return;

    const sightings: MushroomSighting[] = JSON.parse(mapEl.dataset.sightings || '[]');
    const center = JSON.parse(mapEl.dataset.center || '[47.4917, 11.0922]');
    const zoom = parseInt(mapEl.dataset.zoom || '13');
    const locale = mapEl.dataset.locale || 'en';

    const map = L.map('map', { scrollWheelZoom: false }).setView(center, zoom);

    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/">CARTO</a>',
      maxZoom: 19,
    }).addTo(map);

    const markerIcon = L.divIcon({
      className: 'tui-marker',
      html: '<div class="tui-marker__pin">@@</div>',
      iconSize: [40, 20],
      iconAnchor: [20, 20],
      popupAnchor: [0, -22],
    });

    const featuresLabel = locale === 'de' ? 'Merkmale' : 'features';

    sightings.forEach((s) => {
      const marker = L.marker([s.location.lat, s.location.lng], { icon: markerIcon }).addTo(map);

      const popupHtml = `
        <div class="tpopup">
          <div class="tpopup__head">┌─ ${l10n(s.commonName, locale)}</div>
          <img class="tpopup__img" src="${s.imageUrl}" alt="${l10n(s.commonName, locale)}" />
          <div class="tpopup__body">
            <div class="tpopup__row"><span class="tpopup__lbl">species</span> <span class="tpopup__dot"></span> ${s.species}</div>
            <div class="tpopup__row"><span class="tpopup__lbl">date</span> <span class="tpopup__dot"></span> ${formatDate(s.dateSpotted, locale)}</div>
            <div class="tpopup__row"><span class="tpopup__lbl">location</span> <span class="tpopup__dot"></span> ${l10n(s.location.name, locale)}</div>
            ${s.notes ? `<div class="tpopup__notes">└─ ${l10n(s.notes, locale)}</div>` : ''}
            <div class="tpopup__divider"></div>
            <div class="tpopup__features-hdr">├─ ${featuresLabel}:</div>
            <ul class="tpopup__features">
              ${s.determiningFeatures.map(f => `<li>│  ▸ ${l10n(f, locale)}</li>`).join('')}
            </ul>
          </div>
        </div>
      `;

      marker.bindPopup(popupHtml, { maxWidth: 280, className: 'tui-map-popup' });
    });

    if (sightings.length > 0) {
      const bounds = L.latLngBounds(sightings.map(s => [s.location.lat, s.location.lng]));
      map.fitBounds(bounds, { padding: [60, 60] });
    }
  });
</script>

<style>
  .map-frame {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
  }

  .map-frame__title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border-bottom: 1px solid var(--border-char);
    font-size: 0.75rem;
  }

  .map-frame__title-text {
    color: var(--fg-bright);
    font-weight: 700;
  }

  .map-frame__title-coords {
    color: var(--fg-dim);
  }

  .map {
    width: 100%;
    height: 500px;
  }

  /* Markers */
  :global(.tui-marker) {
    background: none !important;
    border: none !important;
  }

  :global(.tui-marker__pin) {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 11px;
    font-weight: 900;
    color: var(--accent);
    text-shadow: 0 0 8px rgba(51, 255, 51, 0.5);
    cursor: pointer;
    transition: text-shadow 0.15s;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  :global(.tui-marker__pin:hover) {
    text-shadow: 0 0 14px rgba(51, 255, 51, 0.8);
  }

  /* Popup */
  :global(.tui-map-popup .leaflet-popup-content-wrapper) {
    background: var(--bg-surface) !important;
    border: 1px solid var(--border-char) !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 0 !important;
    color: var(--fg) !important;
  }

  :global(.tui-map-popup .leaflet-popup-tip) {
    background: var(--bg-surface) !important;
    border: 1px solid var(--border-char) !important;
    border-top: none !important;
    border-left: none !important;
    box-shadow: none !important;
  }

  :global(.tui-map-popup .leaflet-popup-content) {
    margin: 0 !important;
    font-family: var(--font-mono) !important;
    font-size: 0.8125rem !important;
    min-width: 220px;
  }

  :global(.tpopup__img) {
    width: 100%;
    height: 120px;
    object-fit: cover;
    filter: saturate(0.5) brightness(0.8);
    border-top: 1px solid var(--border-char);
    border-bottom: 1px solid var(--border-char);
  }

  :global(.tpopup__head) {
    padding: 0.5rem 0.75rem 0.375rem;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 0.8125rem;
  }

  :global(.tpopup__body) {
    padding: 0.375rem 0.75rem 0.625rem;
  }

  :global(.tpopup__row) {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    line-height: 1.7;
    white-space: nowrap;
    overflow: hidden;
  }

  :global(.tpopup__lbl) {
    color: var(--fg-dim);
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  :global(.tpopup__dot) {
    flex: 1;
    border-bottom: 1px dotted var(--fg-muted);
    min-width: 0.5rem;
    margin-bottom: 0.2em;
  }

  :global(.tpopup__notes) {
    margin-top: 0.375rem;
    color: var(--fg-dim);
    font-style: italic;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  :global(.tpopup__divider) {
    border-top: 1px dashed var(--fg-muted);
    margin: 0.375rem 0;
  }

  :global(.tpopup__features-hdr) {
    color: var(--fg-dim);
    font-size: 0.75rem;
    margin-bottom: 0.2rem;
  }

  :global(.tpopup__features) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(.tpopup__features li) {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .map {
      height: 350px;
    }
  }
</style>
