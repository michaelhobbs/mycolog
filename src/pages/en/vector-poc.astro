---
import Layout from '../../layouts/Layout.astro';

const GARMISCH = [11.0922, 47.4917];
---

<!--
  Proof of concept: the free OpenFreeMap vector map of Garmisch-Partenkirchen,
  rendered with MapLibre GL JS in the dark style, no customizations.
-->
<Layout title="maplibre vector POC — Garmisch-Partenkirchen" locale="en">
  <section class="poc">
    <div class="poc__header">
      <span class="poc__tag"
        >╔══ maplibre vector map — Garmisch-Partenkirchen [POC]</span
      >
      <span class="poc__sub">
        vector tiles from OpenStreetMap via OpenFreeMap · fiord style repainted at runtime
        with the d3 POC palette. Drag to pan, scroll to zoom.</span
      >
    </div>

    <div class="poc__frame">
      <div id="map" class="poc__map"></div>
      <div class="poc__attribution">
        <span>OpenFreeMap · © OpenMapTiles · © OpenStreetMap contributors</span>
      </div>
    </div>

    <div class="poc__note">
      <span class="poc__note-tag">╔═ how it works</span>
      <p>
        A <b>MapLibre GL</b> map loads the free <b>OpenFreeMap</b> fiord style — vector
        tiles generated from OpenStreetMap, no API key required. Its layers are then
        repainted at runtime (via <code>setPaintProperty</code>) to match the colour
        palette of the <b>/en/d3-poc</b> map, so the two proofs-of-concept share a look
        while one draws everything itself and the other uses vector tiles.
      </p>
    </div>
  </section>
</Layout>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  const STYLE_URL = 'https://tiles.openfreemap.org/styles/fiord';

  // Palette lifted from the d3 POC (src/pages/en/d3-poc.astro): dark green
  // hypsometric terrain, teal lakes/rivers, green-toned roads + accent trails.
  function applyPalette(map) {
    const paint = (layer, props) => {
      if (map.getLayer(layer)) {
        Object.entries(props).forEach(([k, v]) => map.setPaintProperty(layer, k, v));
      }
    };

    // terrain / background (d3 elevation ramp, lowest band)
    paint('background', { 'background-color': '#0e120b' });
    paint('landcover_wood', { 'fill-color': '#151a10', 'fill-opacity': 1 });
    paint('landuse_residential', { 'fill-color': '#11150c', 'fill-opacity': 1 });
    paint('landcover_ice_shelf', { 'fill-color': '#20291a' });
    paint('landcover_glacier', { 'fill-color': '#20291a' });

    // hide parks and their dotted outlines entirely
    ['park', 'park_outline'].forEach((l) => {
      if (map.getLayer(l)) map.setLayoutProperty(l, 'visibility', 'none');
    });

    // water (d3 lake/river palette)
    paint('water', { 'fill-color': '#2a7d94' });
    paint('waterway', { 'line-color': '#2a6a80' });

    // buildings
    paint('building', { 'fill-color': '#263222' });

    // roads (d3 road palette: bright -> muted green)
    paint('highway_major_casing', { 'line-color': '#151a10' });
    paint('highway_major_inner', { 'line-color': '#d4f0d4' });
    paint('highway_major_subtle', { 'line-color': '#d4f0d4', 'line-opacity': 0.6 });
    paint('highway_motorway_casing', { 'line-color': '#151a10' });
    paint('highway_motorway_inner', { 'line-color': '#d4f0d4' });
    paint('highway_minor', { 'line-color': '#8fbf8f' });

    // hiking trails (d3 mushroom accent)
    paint('highway_path', { 'line-color': '#33ff33', 'line-dasharray': [1.5, 1.5] });

    // boundaries
    paint('boundary_state', { 'line-color': '#2d5a2d' });
    paint('boundary_country_z5-', { 'line-color': '#4a8f4a' });

    // labels -> d3 bright road green, dark halo for legibility
    ['place_city_large', 'place_city', 'place_town', 'place_village', 'place_suburb', 'place_other',
      'highway_name_other', 'highway_name_motorway', 'water_name'].
      forEach((l) => paint(l, { 'text-color': '#d4f0d4', 'text-halo-color': '#0e120b', 'text-halo-width': 1.5 }));
  }

  function initMap() {
    const container = document.getElementById('map');
    if (!container) return;

    // 15 km from center in each direction (30 km NS total), with the east-west
    // extent derived to match the container's aspect ratio so the box is a
    // rectangle matching the visible viewport.
    // 1 deg lat ~ 111.32 km; 1 deg lon ~ 111.32 * cos(lat).
    const lat = 47.4917, lon = 11.0922;
    const ar = container.clientWidth / container.clientHeight;

    const dLat = 15 / 111.32;                                 // 15 km NS
    const dLon = (15 * ar) / (111.32 * Math.cos((lat * Math.PI) / 180)); // EW keeps aspect ratio
    const w = lon - dLon, e = lon + dLon;
    const s = lat - dLat, n = lat + dLat;

    const map = new maplibregl.Map({
      container,
      style: STYLE_URL,
      center: [lon, lat],
      zoom: 12,
      // No maxBounds / minZoom: the user can pan and zoom freely. Everything
      // outside the 5 km box is simply hidden behind a mask polygon.
    });

    map.on('load', () => {
      applyPalette(map);

      // Mask = a world fill with the box as a hole, so the area outside the
      // 5 km box is hidden. The hole is defined with a reversed winding order.
      const mask = {
        type: 'FeatureCollection',
        features: [
          {
            type: 'Feature',
            properties: {},
            geometry: {
              type: 'Polygon',
              coordinates: [
                [[-180, -90], [180, -90], [180, 90], [-180, 90], [-180, -90]],
                [[w, s], [w, n], [e, n], [e, s], [w, s]],
              ],
            },
          },
        ],
      };

      map.addSource('box-mask', { type: 'geojson', data: mask });
      map.addLayer({
        id: 'box-mask-fill',
        type: 'fill',
        source: 'box-mask',
        paint: { 'fill-color': '#16161a', 'fill-opacity': 1 },
      });

      // Outline of the 15 km box
      map.addLayer({
        id: 'box-mask-outline',
        type: 'line',
        source: 'box-mask',
        paint: { 'line-color': '#4a6a4a', 'line-width': 1.5 },
      });

      map.fitBounds([[w, s], [e, n]], { padding: 16 });
    });

    map.addControl(
      new maplibregl.NavigationControl({ showCompass: false }),
      'bottom-right',
    );
    map.addControl(
      new maplibregl.AttributionControl({ compact: true }),
      'bottom-left',
    );
  }

  document.addEventListener('DOMContentLoaded', initMap);
</script>

<style>
  .poc {
    padding-bottom: 1rem;
  }

  .poc__header {
    margin-bottom: 1rem;
  }

  .poc__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .poc__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .poc__frame {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
  }

  .poc__map {
    width: 100%;
    height: 640px;
    cursor: grab;
    touch-action: none;
    background: var(--bg-highlight);
  }

  .poc__map:active {
    cursor: grabbing;
  }

  .poc__attribution {
    padding: 0.375rem 0.75rem;
    border-top: 1px solid var(--border-char);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  .poc__note {
    margin-top: 1rem;
  }

  .poc__note-tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 0.8125rem;
    margin-bottom: 0.375rem;
  }

  .poc__note p {
    color: var(--fg-dim);
    font-size: 0.8125rem;
    line-height: 1.7;
    max-width: 720px;
  }

  .poc__note b {
    color: var(--fg-bright);
  }

  .poc__note code {
    color: var(--accent);
  }

  :global(.maplibregl-map) {
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .poc__map {
      height: 420px;
    }
  }
</style>
