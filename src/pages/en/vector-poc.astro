---
import Layout from '../../layouts/Layout.astro';
import { sightings } from '../../data/sightings';

const sightingsJSON = JSON.stringify(sightings);
---

<!--
  Proof of concept: the free OpenFreeMap vector map of Garmisch-Partenkirchen,
  rendered with MapLibre GL JS in the dark style, no customizations.
-->
<Layout title="maplibre vector POC — Garmisch-Partenkirchen" locale="en">
  <section class="poc">
    <div class="poc__header">
      <span class="poc__tag"
        >╔══ maplibre vector map — Garmisch-Partenkirchen [POC]</span
      >
      <span class="poc__sub">
        vector tiles from OpenStreetMap via OpenFreeMap · fiord style + d3 POC palette, with
        20 m altitude contours, peaks, shelters, guideposts, named trails and
        <span style="color: var(--accent)">◎ mushroom sightings</span>. Drag to pan, scroll to zoom.</span
      >
    </div>

    <div class="poc__frame">
      <div id="map" class="poc__map" data-sightings={sightingsJSON}></div>
      <div class="poc__attribution">
        <span>OpenFreeMap · © OpenMapTiles · © OpenStreetMap contributors</span>
      </div>
    </div>

    <div class="poc__note">
      <span class="poc__note-tag">╔═ how it works</span>
      <p>
        A <b>MapLibre GL</b> map loads the free <b>OpenFreeMap</b> fiord style — vector
        tiles generated from OpenStreetMap, no API key required. Its layers are repainted at
        runtime to match the <b>/en/d3-poc</b> palette, and hiking data is added straight from
        the same tiles: mountain <b>peaks</b> (name + elevation), <b>shelters</b>, hiking
        <b>guideposts</b>, drinking water, viewpoints, and <b>named trail labels</b> — all from
        the OpenMapTiles schema, requiring no extra tile source or key. <b>20 m altitude
        contours</b> are generated in the browser by <code>maplibre-contour</code> from free
        Mapzen/AWS raster-DEM elevation tiles. The accent <b>◎ mushroom sightings</b> are the
        site's own records from <code>src/data/sightings.ts</code>, embedded on the page and
        rendered as GeoJSON points.
      </p>
    </div>
  </section>
</Layout>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import mlcontour from 'maplibre-contour';

  const STYLE_URL = 'https://tiles.openfreemap.org/styles/fiord';

  // Altitude contours generated on the fly from free raster-DEM tiles
  // (AWS Mapzen "terrarium" elevation tiles, z0-14, no key required).
  // maplibre-contour converts the DEM into vector contour lines client-side,
  // matching the 20 m contour concept of the d3 POC.
  const demSource = new mlcontour.DemSource({
    url: 'https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png',
    encoding: 'terrarium',
    maxzoom: 14,
    worker: false,
    cacheSize: 50,
    timeoutMs: 10_000,
  });
  demSource.setupMaplibre(maplibregl);

  // Palette lifted from the d3 POC (src/pages/en/d3-poc.astro): dark green
  // hypsometric terrain, teal lakes/rivers, green-toned roads + accent trails.
  function applyPalette(map: maplibregl.Map) {
    const paint = (layer: string, props: { [s: string]: unknown; } | ArrayLike<unknown>) => {
      if (map.getLayer(layer)) {
        Object.entries(props).forEach(([k, v]) => map.setPaintProperty(layer, k, v));
      }
    };

    // terrain / background (d3 elevation ramp, lowest band)
    paint('background', { 'background-color': '#0e120b' });
    paint('landcover_wood', { 'fill-color': '#151a10', 'fill-opacity': 1 });
    paint('landuse_residential', { 'fill-color': '#11150c', 'fill-opacity': 1 });
    paint('landcover_ice_shelf', { 'fill-color': '#20291a' });
    paint('landcover_glacier', { 'fill-color': '#20291a' });

    // hide parks and their dotted outlines entirely
    ['park', 'park_outline'].forEach((l) => {
      if (map.getLayer(l)) map.setLayoutProperty(l, 'visibility', 'none');
    });

    // water (d3 lake/river palette)
    paint('water', { 'fill-color': '#2a7d94' });
    paint('waterway', { 'line-color': '#2a6a80' });

    // buildings
    paint('building', { 'fill-color': '#263222' });

    // roads (d3 road palette: bright -> muted green)
    paint('highway_major_casing', { 'line-color': '#151a10' });
    paint('highway_major_inner', { 'line-color': '#d4f0d4' });
    paint('highway_major_subtle', { 'line-color': '#d4f0d4', 'line-opacity': 0.6 });
    paint('highway_motorway_casing', { 'line-color': '#151a10' });
    paint('highway_motorway_inner', { 'line-color': '#d4f0d4' });
    paint('highway_minor', { 'line-color': '#8fbf8f' });

    // hiking trails (d3 mushroom accent)
    paint('highway_path', { 'line-color': '#33ff33', 'line-dasharray': [1.5, 1.5] });

    // boundaries
    paint('boundary_state', { 'line-color': '#2d5a2d' });
    paint('boundary_country_z5-', { 'line-color': '#4a8f4a' });

    // labels -> d3 bright road green, dark halo for legibility
    ['place_city_large', 'place_city', 'place_town', 'place_village', 'place_suburb', 'place_other',
      'highway_name_other', 'highway_name_motorway', 'water_name'].
      forEach((l) => paint(l, { 'text-color': '#d4f0d4', 'text-halo-color': '#0e120b', 'text-halo-width': 1.5 }));
  }

  // Hiking data/labels, all from the existing OpenMapTiles `openmaptiles`
  // source already used by the fiord style (no new tile source or key).
  // These layers are added BEFORE box-mask-fill so out-of-box features stay
  // hidden behind the mask. Layers added after `place_*/highway_name_*` show
  // above them; use "beforeId" to keep natural road/label ordering intact.
  function addHikingLayers(map: maplibregl.Map) {
    const add = (id: string, type: string, beforeId: string, { sourceLayer, filter, layout = {}, paint = {}, minzoom, maxzoom }: { sourceLayer: string; filter: (string | (string | number | string[])[])[] | (string | (string | number | string[])[] | (string | boolean | string[])[])[] | (string | (string | (string | string[])[])[] | (string | boolean | string[])[])[]; layout: { 'icon-image': string; 'icon-size': (string | number | string[])[]; 'text-field': (string | (string | (string | string[])[])[])[]; 'text-font': string[]; 'text-size': number; 'text-anchor': string; 'text-offset': number[]; 'text-allow-overlap': boolean; } | { 'icon-image': string; 'icon-size': number; 'text-field': (string | string[])[]; 'text-font': string[]; 'text-size': number; 'text-anchor': string; 'text-offset': number[]; 'text-allow-overlap': boolean; } | { 'symbol-placement': string; 'text-field': (string | string[])[]; 'text-font': string[]; 'text-size': number; 'text-letter-spacing': number; 'symbol-spacing': number; 'text-rotation-alignment': string; }; paint: { 'text-color': string; 'text-halo-color': string; 'text-halo-width': number; } | { 'text-color': string; 'text-halo-color': string; 'text-halo-width': number; } | { 'text-color': string; 'text-halo-color': string; 'text-halo-width': number; }; minzoom?: number; }) => {
      map.addLayer(
        {
          id,
          type,
          source: 'openmaptiles',
          'source-layer': sourceLayer,
          filter,
          layout,
          paint,
          ...(minzoom !== undefined ? { minzoom } : {}),
          ...(maxzoom !== undefined ? { maxzoom } : {}),
        },
        beforeId,
      );
    };

    const base = map.getStyle().layers.find((l: { id: string; }) => l.id === 'boundary_state');
    const b4 = base ? base.id : undefined;

    // --- mountain peaks (summits with name + elevation) ---
    add('hiking-peak', 'symbol', b4, {
      sourceLayer: 'mountain_peak',
      filter: ['all', ['==', ['get', 'class'], 'peak'], ['<=', ['get', 'rank'], 4]],
      layout: {
        'icon-image': 'marker',
        'icon-size': ['interpolate', ['linear'], ['zoom'], 12, 0.6, 14, 1],
        'text-field': [
          'concat',
          ['coalesce', ['get', 'name_de'], ['get', 'name'], ''],
          ['literal', ' '],
          ['coalesce', ['to-string', ['get', 'ele']], ''],
          ['literal', ' m'],
        ],
        'text-font': ['Noto Sans Bold'],
        'text-size': 11,
        'text-anchor': 'left',
        'text-offset': [0.7, 0],
        'text-allow-overlap': false,
      },
      paint: {
        'text-color': '#d4f0d4',
        'text-halo-color': '#0e120b',
        'text-halo-width': 1.5,
      },
    });

    // --- hiking POIs (shelters, guideposts, drinking water, viewpoints) ---
    // POI data only exists in the tiles from z14, so these fade in on zoom.
    const poiB4 = 'hiking-peak';
    add('hiking-poi', 'symbol', poiB4, {
      sourceLayer: 'poi',
      minzoom: 14,
      filter: [
        'all',
        ['match', ['geometry-type'], ['Point', 'MultiPoint'], true, false],
        [
          'match',
          ['get', 'subclass'],
          ['shelter', 'guidepost', 'map', 'viewpoint', 'drinking_water', 'alpine_hut', 'hostel', 'spring'],
          true,
          false,
        ],
        ['<=', ['get', 'rank'], 15],
      ],
      layout: {
        'icon-image': 'marker',
        'icon-size': 0.4,
        'text-field': ['coalesce', ['get', 'name_de'], ['get', 'name'], ''],
        'text-font': ['Noto Sans Regular'],
        'text-size': 10,
        'text-anchor': 'top',
        'text-offset': [0, 0.5],
        'text-allow-overlap': false,
      },
      paint: {
        'text-color': '#8fbf8f',
        'text-halo-color': '#0e120b',
        'text-halo-width': 1.2,
      },
    });

    // --- named hiking trail labels (from transportation_name) ---
    add('hiking-trail-label', 'symbol', b4, {
      sourceLayer: 'transportation_name',
      minzoom: 14,
      filter: [
        'all',
        ['==', ['get', 'class'], 'path'],
        ['match', ['geometry-type'], ['LineString', 'MultiLineString'], true, false],
        ['!=', ['coalesce', ['get', 'name'], ''], ''],
      ],
      layout: {
        'symbol-placement': 'line',
        'text-field': ['coalesce', ['get', 'name'], ''],
        'text-font': ['Noto Sans Regular'],
        'text-size': 10.5,
        'text-letter-spacing': 0.02,
        'symbol-spacing': 300,
        'text-rotation-alignment': 'map',
      },
      paint: {
        'text-color': '#33ff33',
        'text-halo-color': '#0e120b',
        'text-halo-width': 1.4,
      },
    });
  }

  // Altitude contour lines (vector, generated from the demo DEM source).
  // Minor lines use the d3-POC minor green, index/major lines a lighter green.
  function addContours(map: maplibregl.Map) {
    if (map.getSource('hiking-contours')) return;

    map.addSource('hiking-contours', {
      type: 'vector',
      tiles: [
        demSource.contourProtocolUrl({
          thresholds: {
            12: [40, 200],
            13: [20, 100],
            14: [20, 50],
          },
          contourLayer: 'contours',
          elevationKey: 'ele',
          levelKey: 'level',
          extent: 4096,
          buffer: 1,
        }),
      ],
      maxzoom: 15,
    });

    // Draw contours right above land cover / terrain fills (background, water,
    // landcover, landuse, park) but below waterway lines, buildings, roads and
    // labels — a clean topographic look, like the d3 POC.
    const beforeId = (map.getLayer('waterway') && 'waterway') ||
      (map.getLayer('hiking-peak') && 'hiking-peak') ||
      undefined;
    map.addLayer(
      {
        id: 'hiking-contour-minor',
        type: 'line',
        source: 'hiking-contours',
        'source-layer': 'contours',
        filter: ['==', ['get', 'level'], 0],
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: {
          'line-color': '#3a4a35',
          'line-width': 0.6,
          'line-opacity': 0.9,
        },
      },
      beforeId,
    );

    map.addLayer(
      {
        id: 'hiking-contour-major',
        type: 'line',
        source: 'hiking-contours',
        'source-layer': 'contours',
        filter: ['>=', ['get', 'level'], 1],
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: {
          'line-color': '#5a6c52',
          'line-width': 0.9,
          'line-opacity': 1,
        },
      },
      beforeId,
    );
  }

  // Mushroom sightings pinned as accent dots + labels, from the data already
  // embedded on the page (data-sightings). Added above all other data layers.
  function addSightings(map: maplibregl.Map, sightings: any[]) {
    if (map.getSource('sightings') || !sightings.length) return;

    const features = sightings.map((s: { commonName: { de: any; en: any; }; species: any; location: { lng: any; lat: any; }; }) => ({
      type: 'Feature',
      properties: {
        name: s.commonName?.de ?? s.commonName?.en ?? s.species ?? '',
        species: s.species ?? '',
      },
      geometry: { type: 'Point', coordinates: [s.location.lng, s.location.lat] },
    }));

    map.addSource('sightings', {
      type: 'geojson',
      data: { type: 'FeatureCollection', features },
    });

    map.addLayer({
      id: 'sighting-label',
      type: 'symbol',
      source: 'sightings',
      layout: {
        'text-field': ['coalesce', ['get', 'name'], ''],
        'text-font': ['Noto Sans Bold'],
        'text-size': 11,
        'text-anchor': 'left',
        'text-offset': [1.1, 0],
        'text-allow-overlap': false,
      },
      paint: {
        'text-color': '#33ff33',
        'text-halo-color': '#0e120b',
        'text-halo-width': 1.4,
      },
    });

    map.addLayer(
      {
        id: 'sighting-marker',
        type: 'circle',
        source: 'sightings',
        paint: {
          'circle-color': '#33ff33',
          'circle-radius': 6,
          'circle-stroke-color': '#0e120b',
          'circle-stroke-width': 1.5,
        },
      },
      'sighting-label',
    );
  }

  function initMap() {
    const container = document.getElementById('map');
    if (!container) return;

    // 15 km from center in each direction (30 km NS total), with the east-west
    // extent derived to match the container's aspect ratio so the box is a
    // rectangle matching the visible viewport.
    // 1 deg lat ~ 111.32 km; 1 deg lon ~ 111.32 * cos(lat).
    const lat = 47.4917, lon = 11.0922;
    const ar = container.clientWidth / container.clientHeight;

    const dLat = 15 / 111.32;                                 // 15 km NS
    const dLon = (15 * ar) / (111.32 * Math.cos((lat * Math.PI) / 180)); // EW keeps aspect ratio
    const w = lon - dLon, e = lon + dLon;
    const s = lat - dLat, n = lat + dLat;

    const map = new maplibregl.Map({
      container,
      style: STYLE_URL,
      center: [lon, lat],
      bounds: [[w, s], [e, n]]
      // No maxBounds / minZoom: the user can pan and zoom freely. Everything
      // outside the 5 km box is simply hidden behind a mask polygon.
    });


    map.on('load', () => {
      applyPalette(map);

      // Add hiking data layers (peaks, POIs, trail labels), altitude contours,
      // and mushroom sighting markers BEFORE the mask so anything outside the
      // 15 km box stays hidden behind box-mask-fill.
      addHikingLayers(map);
      addContours(map);
      addSightings(map, JSON.parse(container.dataset.sightings || '[]'));

      // Mask = a world fill with the box as a hole, so the area outside the
      // 5 km box is hidden. The hole is defined with a reversed winding order.
      const mask = {
        type: 'FeatureCollection',
        features: [
          {
            type: 'Feature',
            properties: {},
            geometry: {
              type: 'Polygon',
              coordinates: [
                [[-180, -90], [180, -90], [180, 90], [-180, 90], [-180, -90]],
                [[w, s], [w, n], [e, n], [e, s], [w, s]],
              ],
            },
          },
        ],
      };

      map.addSource('box-mask', { type: 'geojson', data: mask });
      map.addLayer({
        id: 'box-mask-fill',
        type: 'fill',
        source: 'box-mask',
        paint: { 'fill-color': '#141414', 'fill-opacity': 1 },
      });

      // Outline of the 15 km box
      map.addLayer({
        id: 'box-mask-outline',
        type: 'line',
        source: 'box-mask',
        paint: { 'line-color': '#4a6a4a', 'line-width': 1.5 },
      });
    });

    map.addControl(
      new maplibregl.NavigationControl({ showCompass: false }),
      'bottom-right',
    );
  }

  if (document.readyState !== 'loading') initMap();
  else document.addEventListener('DOMContentLoaded', initMap);
</script>

<style>
  .poc {
    padding-bottom: 1rem;
  }

  .poc__header {
    margin-bottom: 1rem;
  }

  .poc__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .poc__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .poc__frame {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
  }

  .poc__map {
    width: 100%;
    height: 640px;
    cursor: grab;
    touch-action: none;
    background: var(--bg-highlight);
  }

  .poc__map:active {
    cursor: grabbing;
  }

  .poc__attribution {
    padding: 0.375rem 0.75rem;
    border-top: 1px solid var(--border-char);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  .poc__note {
    margin-top: 1rem;
  }

  .poc__note-tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 0.8125rem;
    margin-bottom: 0.375rem;
  }

  .poc__note p {
    color: var(--fg-dim);
    font-size: 0.8125rem;
    line-height: 1.7;
    max-width: 720px;
  }

  .poc__note b {
    color: var(--fg-bright);
  }

  .poc__note code {
    color: var(--accent);
  }

  :global(.maplibregl-map) {
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .poc__map {
      height: 420px;
    }
  }

  :global(.maplibregl-ctrl-attrib) {
    display: none;
  }
</style>
