---
interface Props {
  points: { lat: number; lng: number; label?: string }[]
  region?: { lat: number; lng: number; radiusKm?: number }
}

const { points, region } = Astro.props
const count = points.length
const center = region
  ? [region.lng, region.lat]
  : points.reduce((acc, p) => [acc[0] + p.lng / count, acc[1] + p.lat / count], [0, 0])
const coords = `${center[1].toFixed(4)}°N ${center[0].toFixed(4)}°E`
const data = JSON.stringify({
  type: 'FeatureCollection',
  features: points.map((p) => ({
    type: 'Feature',
    properties: { label: p.label ?? '' },
    geometry: { type: 'Point', coordinates: [p.lng, p.lat] },
  })),
})
const regionData = region ? JSON.stringify(region) : ''
---

<div class="mini-map-frame">
  <div class="mini-map-frame__title">
    <span class="mini-map-frame__title-text">[ map ]</span>
    <span class="mini-map-frame__title-coords">{coords}</span>
    <button
      type="button"
      class="mini-map-frame__full"
      data-minimap-full
      title="fullscreen"
      aria-label="fullscreen"
    >
      ⛶
    </button>
  </div>
  <div id="minimap" class="mini-map-frame__map" data-points={data} data-region={regionData}></div>
  <div class="mini-map-frame__attribution">
    <span>OpenFreeMap · © OpenMapTiles · © OpenStreetMap contributors</span>
  </div>
</div>

<script>
  import maplibregl from 'maplibre-gl'
  import 'maplibre-gl/dist/maplibre-gl.css'

  const STYLE_URL = 'https://tiles.openfreemap.org/styles/fiord'

  // Same dark terrain palette as the full map (/map), trimmed to the layers
  // relevant at thumbnail zoom. Kept in sync with MapVector.applyPalette.
  function applyPalette(map: maplibregl.Map) {
    const paint = (layer: string, props: { [s: string]: unknown }) => {
      if (map.getLayer(layer)) {
        Object.entries(props).forEach(([k, v]) => map.setPaintProperty(layer, k, v))
      }
    }

    paint('background', { 'background-color': '#0e120b' })
    paint('landcover_wood', { 'fill-color': '#151a10', 'fill-opacity': 1 })
    paint('landuse_residential', { 'fill-color': '#11150c', 'fill-opacity': 1 })
    paint('landcover_ice_shelf', { 'fill-color': '#20291a' })
    paint('landcover_glacier', { 'fill-color': '#20291a' })

    ;['park', 'park_outline'].forEach((l) => {
      if (map.getLayer(l)) map.setLayoutProperty(l, 'visibility', 'none')
    })

    paint('water', { 'fill-color': '#2a7d94' })
    paint('waterway', { 'line-color': '#2a6a80' })
    paint('building', { 'fill-color': '#263222' })

    paint('highway_major_casing', { 'line-color': '#151a10' })
    paint('highway_major_inner', { 'line-color': '#d4f0d4' })
    paint('highway_major_subtle', { 'line-color': '#d4f0d4', 'line-opacity': 0.6 })
    paint('highway_motorway_casing', { 'line-color': '#151a10' })
    paint('highway_motorway_inner', { 'line-color': '#d4f0d4' })
    paint('highway_minor', { 'line-color': '#8fbf8f' })
    paint('highway_path', { 'line-color': '#33ff33', 'line-dasharray': [1.5, 1.5] })

    paint('boundary_state', { 'line-color': '#2d5a2d' })
    paint('boundary_country_z5-', { 'line-color': '#4a8f4a' })

    ;[
      'place_city_large',
      'place_city',
      'place_town',
      'place_village',
      'place_suburb',
      'place_other',
      'highway_name_other',
      'highway_name_motorway',
      'water_name',
    ].forEach((l) =>
      paint(l, { 'text-color': '#d4f0d4', 'text-halo-color': '#0e120b', 'text-halo-width': 1.5 }),
    )
  }

  const container = document.getElementById('minimap')
  const frame = container?.closest('.mini-map-frame') as HTMLElement | null
  const fullBtn = frame?.querySelector('[data-minimap-full]') as HTMLButtonElement | null
  const pts = JSON.parse(container?.dataset.points || '{"features":[]}')
  const features = pts.features as {
    properties: { label?: string }
    geometry: { coordinates: [number, number] }
  }[]
  const region = JSON.parse(container?.dataset.region || 'null') as {
    lat: number
    lng: number
    radiusKm?: number
  } | null
  const center = region
    ? [region.lng, region.lat]
    : features
        .reduce(
          (acc, f) => {
            const [lng, lat] = f.geometry.coordinates
            return [acc[0] + lng, acc[1] + lat]
          },
          [0, 0],
        )
        .map((v) => v / Math.max(features.length, 1))

  // Fixed 15 km "hunting box" around the center, same geographic extent as the
  // big map's box-mask (MapVector). The box is container-size independent, so
  // the shown area is identical regardless of the map's dimensions. The map is
  // framed to this exact box and everything outside it is masked.
  function maskBox(lat: number, lng: number): [number, number, number, number] {
    const dLat = 15 / 111.32
    const dLon = 15 / (111.32 * Math.cos((lat * Math.PI) / 180))
    const w = lng - dLon
    const e = lng + dLon
    const s = lat - dLat
    const n = lat + dLat
    return [w, s, e, n]
  }

  // Masks everything outside the 15 km box (MapVector's box-mask).
  function addMask(map: maplibregl.Map, [w, s, e, n]: [number, number, number, number]) {
    if (map.getSource('mini-mask')) return

    const mask = {
      type: 'FeatureCollection' as const,
      features: [
        {
          type: 'Feature' as const,
          properties: {},
          geometry: {
            type: 'Polygon' as const,
            coordinates: [
              [
                [-180, -90],
                [180, -90],
                [180, 90],
                [-180, 90],
                [-180, -90],
              ],
              [
                [w, s],
                [w, n],
                [e, n],
                [e, s],
                [w, s],
              ],
            ],
          },
        },
      ],
    }

    map.addSource('mini-mask', { type: 'geojson', data: mask })
    map.addLayer({
      id: 'mini-mask-fill',
      type: 'fill',
      source: 'mini-mask',
      paint: { 'fill-color': '#141414', 'fill-opacity': 1 },
    })
    map.addLayer({
      id: 'mini-mask-outline',
      type: 'line',
      source: 'mini-mask',
      paint: { 'line-color': '#4a6a4a', 'line-width': 1.5 },
    })
  }

  function buildCircle(lat: number, lng: number, radiusM: number, segments = 96) {
    const dLat = radiusM / 110574
    const dLon = radiusM / (111320 * Math.cos((lat * Math.PI) / 180))
    const coords: number[][] = []
    for (let i = 0; i < segments; i++) {
      const a = (i / segments) * 2 * Math.PI
      coords.push([lng + dLon * Math.sin(a), lat + dLat * Math.cos(a)])
    }
    coords.push(coords[0])
    return { type: 'Polygon' as const, coordinates: [coords] }
  }

  function addRegion(map: maplibregl.Map) {
    if (!region) return
    const radiusM = (region.radiusKm ?? 1) * 1000
    const circleFeature = {
      type: 'Feature' as const,
      properties: {},
      geometry: buildCircle(region.lat, region.lng, radiusM),
    }
    const data = { type: 'FeatureCollection' as const, features: [circleFeature] }
    map.addSource('mini-region', { type: 'geojson', data: data as any })
    map.addLayer({
      id: 'mini-region-fill',
      type: 'fill',
      source: 'mini-region',
      paint: { 'fill-color': '#33ff33', 'fill-opacity': 0.1 },
    })
    map.addLayer({
      id: 'mini-region-line',
      type: 'line',
      source: 'mini-region',
      paint: {
        'line-color': '#33ff33',
        'line-width': 1.5,
        'line-opacity': 0.85,
        'line-dasharray': [3, 2],
      },
    })
  }

  function addMarkers(map: maplibregl.Map) {
    if (!features.length) return

    map.addSource('sighting', { type: 'geojson', data: pts })
    map.addLayer({
      id: 'sighting-dot',
      type: 'circle',
      source: 'sighting',
      paint: {
        'circle-color': '#33ff33',
        'circle-radius': 6,
        'circle-stroke-color': '#0e120b',
        'circle-stroke-width': 1.5,
      },
    })

    if (features.some((f) => f.properties?.label)) {
      map.addLayer({
        id: 'sighting-label',
        type: 'symbol',
        source: 'sighting',
        layout: {
          'text-field': ['coalesce', ['get', 'label'], ''],
          'text-font': ['Noto Sans Bold'],
          'text-size': 11,
          'text-anchor': 'left',
          'text-offset': [1.1, 0],
          'text-allow-overlap': false,
        },
        paint: {
          'text-color': '#33ff33',
          'text-halo-color': '#0e120b',
          'text-halo-width': 1.4,
        },
      })
    }
  }

  function initMap() {
    if (!container || (!features.length && !region)) return

    const [clng, clat] = center
    // With a region the view is fitted to the location circle; otherwise it
    // shows the fixed 15 km hunting box around the area.
    const [w, s, e, n] = region
      ? (() => {
          const dLat = ((region.radiusKm ?? 1) * 1.45) / 111.32
          const dLon = dLat / Math.cos((region.lat * Math.PI) / 180)
          return [region.lng - dLon, region.lat - dLat, region.lng + dLon, region.lat + dLat]
        })()
      : maskBox(clat, clng)

    const map = new maplibregl.Map({
      container,
      style: STYLE_URL,
      center: [clng, clat],
      bounds: [
        [w, s],
        [e, n],
      ],
    })

    map.on('load', () => {
      applyPalette(map)
      if (!region) addMask(map, [w, s, e, n])
      addRegion(map)
      try {
        addMarkers(map)
      } catch (err) {
        console.error('[minimap] addMarkers failed:', err)
      }
    })

    map.on('error', (e: any) => {
      console.error('[minimap] maplibre error:', e?.error)
    })

    // iOS Safari (iPhone/iPad) has no element Fullscreen API, so the ⛶ button
    // emulates fullscreen there by pinning the frame as a fixed overlay.
    const canFullscreen =
      typeof document.documentElement.requestFullscreen === 'function' &&
      typeof document.exitFullscreen === 'function'
    function setExpanded(on: boolean) {
      if (!frame) return
      if (on) frame.dataset.expanded = 'true'
      else delete frame.dataset.expanded
    }

    fullBtn?.addEventListener('click', async () => {
      if (!frame) return
      if (!canFullscreen) {
        setExpanded(!frame.hasAttribute('data-expanded'))
        map.resize()
        return
      }
      try {
        if (document.fullscreenElement) {
          await document.exitFullscreen()
        } else {
          await frame.requestFullscreen()
        }
      } catch (err) {
        console.error('[minimap] fullscreen failed:', err)
      }
    })

    document.addEventListener('fullscreenchange', () => {
      if (!frame) return
      if (document.fullscreenElement === frame) {
        frame.dataset.fullscreen = 'true'
      } else {
        delete frame?.dataset.fullscreen
      }
      map.resize()
    })
  }

  if (document.readyState !== 'loading') initMap()
  else document.addEventListener('DOMContentLoaded', initMap)
</script>

<style>
  .mini-map-frame {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    margin-bottom: 1.25rem;
  }

  .mini-map-frame:fullscreen {
    display: flex;
    flex-direction: column;
    width: 100vw;
    height: 100vh;
    margin: 0;
  }

  .mini-map-frame[data-expanded] {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    margin: 0;
    background: var(--bg);
  }

  .mini-map-frame__title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border-char);
    font-size: 0.8125rem;
  }

  .mini-map-frame__title-text {
    color: var(--fg-bright);
    font-weight: 700;
  }

  .mini-map-frame__title-coords {
    color: var(--fg-dim);
    font-size: 0.6875rem;
    margin-left: auto;
  }

  .mini-map-frame__full {
    background: #0e120b;
    border: 1px solid var(--border-char);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    transition:
      background 0.1s,
      color 0.1s;
  }

  .mini-map-frame__full:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .mini-map-frame__map {
    width: 100%;
    height: 320px;
    cursor: grab;
    touch-action: none;
    background: var(--bg-highlight);
  }

  .mini-map-frame:fullscreen .mini-map-frame__map,
  .mini-map-frame[data-expanded] .mini-map-frame__map {
    flex: 1;
    height: auto;
  }

  .mini-map-frame__attribution {
    padding: 0.375rem 0.75rem;
    border-top: 1px solid var(--border-char);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  :global(.maplibregl-map) {
    font-family: var(--font-mono);
  }

  :global(.maplibregl-ctrl-attrib) {
    display: none;
  }

  @media (max-width: 768px) {
    .mini-map-frame__map {
      height: 240px;
    }
  }
</style>
