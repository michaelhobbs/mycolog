---
import Layout from '../../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import { getTranslations, formatDate, locales } from '../../../i18n'
import type { Locale, Translations } from '../../../i18n'
import BacklogIdentify from '../../../components/BacklogIdentify.astro'

export async function getStaticPaths() {
  // The identification form is a dev workflow, but the read-only item pages
  // are generated in production too so backlog items can be shared by link.
  const backlog = (await getCollection('backlog')).sort((a, b) =>
    a.data.dateSpotted < b.data.dateSpotted ? -1 : 1,
  )
  return locales.flatMap((locale) =>
    backlog.map((entry) => ({ params: { locale, slug: entry.id } })),
  )
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string }
const t: Translations = getTranslations(locale)
const dev = import.meta.env.DEV

const entry = (await getCollection('backlog')).find((e) => e.id === slug)
if (!entry) {
  return Astro.redirect(`/${locale}/backlog`)
}

const fullSrcs = await Promise.all(
  entry.data.images.map(async (img) => (await getImage({ src: img, width: 1600 }))?.src ?? ''),
)
---

<Layout
  title={`${dev ? t.backlog.addTitle : `${t.backlog.item} #${entry.id}`} — myco.log`}
  locale={locale}
>
  <section class="add-page">
    <div class="add-nav">
      <a class="add-nav__back" href={`/${locale}/backlog`}>{'<'} {t.backlog.backToList}</a>
    </div>

    <div class="add-head">
      <h1 class="add-head__title">
        {dev ? t.backlog.addTitle : `${t.backlog.item} #${entry.id}`}
      </h1>
      <span class="add-head__meta"
        >{t.backlog.item} #{entry.id} · {t.backlog.date}
        {formatDate(entry.data.dateSpotted, locale)}</span
      >
    </div>

    {
      dev ? (
        <BacklogIdentify
          id={entry.id}
          dateSpotted={entry.data.dateSpotted}
          location={entry.data.location}
          authors={entry.data.authors}
          locale={locale}
        />
      ) : (
        <div class="identify">
          <fieldset>
            <legend>{t.backlog.location}</legend>
            {entry.data.location ? (
              <span class="identify__value">
                {entry.data.location.lat.toFixed(5)}°N {entry.data.location.lng.toFixed(5)}°E
              </span>
            ) : (
              <p class="field-hint">{t.backlog.noLocation}</p>
            )}
          </fieldset>
        </div>
      )
    }

    <div class="identify">
      <fieldset>
        <legend>{entry.data.images.length} {t.backlog.photos}</legend>
        <div class="gallery" data-lightbox-group>
          {
            entry.data.images.map((img, i) => (
              <figure class="gallery__fig" data-lightbox-src={fullSrcs[i]}>
                <Image
                  src={img}
                  alt={`#{entry.id} — ${i + 1}`}
                  widths={[400, 800]}
                  sizes="(min-width: 640px) 400px, 100vw"
                />
                <button
                  type="button"
                  class="gallery__full"
                  data-lightbox-trigger
                  data-index={i}
                  aria-label={`${t.backlog.fullscreen} ${i + 1}`}
                  title={t.backlog.fullscreen}
                >
                  ⛶
                </button>
              </figure>
            ))
          }
        </div>
      </fieldset>
    </div>
  </section>
</Layout>

<style>
  .add-page {
    padding-bottom: 3rem;
  }

  .add-nav {
    margin-bottom: 1rem;
  }

  .add-nav__back {
    color: var(--accent);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .add-nav__back:hover {
    color: var(--fg-bright);
  }

  .add-head {
    margin-bottom: 1.25rem;
  }

  .add-head__title {
    font-size: 1.25rem;
    color: var(--fg-bright);
    margin: 0 0 0.25rem;
  }

  .add-head__meta {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .identify {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  fieldset {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    padding: 1rem;
  }

  legend {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.8125rem;
    padding: 0 0.375rem;
  }

  .field-hint {
    color: var(--fg-subtle);
    font-size: 0.75rem;
    margin: 0 0 0.75rem;
  }

  .identify__value {
    color: var(--fg-bright);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.5rem;
  }

  .gallery__fig {
    margin: 0;
    border: 1px solid var(--bg-highlight);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--bg-highlight);
    position: relative;
  }

  .gallery__fig img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__full {
    position: absolute;
    top: 0.25rem;
    left: 0.25rem;
    background: rgba(14, 18, 11, 0.75);
    border: 1px solid var(--border-char);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    opacity: 0;
    transition:
      background 0.1s,
      color 0.1s,
      opacity 0.15s;
  }

  .gallery__fig:hover .gallery__full,
  .gallery__full:focus-visible {
    opacity: 1;
  }

  .gallery__full:hover {
    background: var(--accent);
    color: var(--bg);
  }

  @media (hover: none) {
    .gallery__full {
      opacity: 1;
    }
  }
</style>
