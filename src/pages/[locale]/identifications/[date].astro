---
import Layout from '../../../layouts/Layout.astro'
import MushroomCard from '../../../components/MushroomCard.astro'
import LinkRow from '../../../components/LinkRow.astro'
import { getCollection } from 'astro:content'
import { enrichSightings, identificationDate, buildLocationMap } from '../../../lib/sightings'
import { getTranslations, formatDate, locales } from '../../../i18n'
import type { Locale } from '../../../i18n'

export async function getStaticPaths() {
  const sightingEntries = await getCollection('sightings')
  const dates = [
    ...new Set(sightingEntries.map((s) => s.data.dateIdentified || s.data.dateSpotted)),
  ].sort()
  return dates.flatMap((date) => locales.map((locale) => ({ params: { locale, date } })))
}

const { locale, date } = Astro.params as { locale: Locale; date: string }
const t = getTranslations(locale)

const [sightingEntries, speciesEntries, locationEntries] = await Promise.all([
  getCollection('sightings'),
  getCollection('species'),
  getCollection('locations'),
])
const sightings = enrichSightings(sightingEntries, speciesEntries).filter(
  (s) => identificationDate(s) === date,
)
const locations = buildLocationMap(locationEntries)
---

<Layout
  title={`${t.identifications.title} · ${formatDate(date, locale)} — myco.log`}
  locale={locale}
>
  <section class="identifications-page">
    <div class="page-header">
      <span class="page-header__tag"
        >╔══ {t.identifications.title} · {formatDate(date, locale)}</span
      >
      <span class="page-header__sub">{sightings.length} {t.log.sightingsCount}</span>
    </div>

    <LinkRow locale={locale} fallback={`/${locale}/identifications`} />

    {sightings.length === 0 && <p class="empty">{t.log.noSightings}</p>}

    <div class="day__grid">
      {
        sightings.map((sighting) => (
          <MushroomCard sighting={sighting} locale={locale} locations={locations} />
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .identifications-page {
    padding-bottom: 2rem;
  }

  .page-header {
    margin-bottom: 1.25rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .empty {
    color: var(--fg-dim);
    font-size: 0.8125rem;
    margin-bottom: 1rem;
  }

  .day__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .day__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
