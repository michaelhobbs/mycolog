---
import Layout from '../../layouts/Layout.astro'
import DateRail from '../../components/DateRail.astro'
import { getCollection } from 'astro:content'
import {
  enrichSightings,
  identificationDate,
  buildLocationMap,
  locationName,
} from '../../lib/sightings'
import { getTranslations, locales } from '../../i18n'
import type { RailDay } from '../../lib/date-rail'
import type { Locale } from '../../i18n'

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }
const t = getTranslations(locale)

const [sightingEntries, speciesEntries, locationEntries] = await Promise.all([
  getCollection('sightings'),
  getCollection('species'),
  getCollection('locations'),
])
const sightings = enrichSightings(sightingEntries, speciesEntries)
const locations = buildLocationMap(locationEntries)

const bySession = new Map<string, typeof sightings>()
for (const s of sightings) {
  const key = identificationDate(s)
  const bucket = bySession.get(key)
  if (bucket) bucket.push(s)
  else bySession.set(key, [s])
}

const railDays: RailDay[] = [...bySession.entries()]
  .map(([day, items]) => {
    const names = [...new Set(items.map((s) => s.locationSlug).filter(Boolean))]
      .slice(0, 3)
      .map((slug) => locationName(locations, slug, locale))
    return { date: day, count: items.length, meta: names.join(' · ') || undefined }
  })
  .sort((a, b) => (a.date < b.date ? 1 : -1))

const counts = `${railDays.length} ${t.log.daysLabel} · ${sightings.length} ${t.log.sightingsCount}`
---

<Layout title={t.meta.identificationsTitle} locale={locale}>
  <DateRail
    days={railDays}
    basePath={`/${locale}/identifications`}
    locale={locale}
    countUnit={t.log.sightingsCount}
    navLabel={t.common.jumpToDate}
  >
    <div class="page-header">
      <span class="page-header__tag">╔══ {t.identifications.title}</span>
      <span class="page-header__sub">{t.identifications.subtitle}</span>
    </div>

    <p class="overview__intro">{t.identifications.indexIntro}</p>

    <p class="overview__count">{counts}</p>
  </DateRail>
</Layout>

<style>
  .page-header {
    margin-bottom: 1rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .overview__intro {
    max-width: 34rem;
    margin: 0 0 0.75rem;
    color: var(--fg);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .overview__count {
    max-width: 34rem;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-char);
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }
</style>
