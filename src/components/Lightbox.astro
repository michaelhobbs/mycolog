---
// Fullscreen photo viewer ("lightroom" modal). Wraps the gallery in a native
// <dialog> (top-layer, focus-trapped, Esc-aware). Works with any gallery marked
// with `data-lightbox-group` that contains per-image sources via
// `data-lightbox-src`, opened by buttons marked `data-lightbox-trigger`
// (optionally carrying a `data-index`). If no `data-lightbox-src` elements
// exist, the group's <img> elements are used as sources.
//
// Gestures:
//   - horizontal swipe / ArrowLeft/Right / prev-next buttons: navigate (1×)
//   - drag when zoomed: pan
//   - wheel / trackpad pinch / two-finger pinch: zoom (anchored at cursor)
//   - double-click / double-tap: toggle 1× ⇄ 2.5×
//   - +/- keys zoom, 0 resets, Esc resets zoom first, then closes

import { getTranslations } from '../i18n'
import type { Locale } from '../i18n'

const { locale = 'en' } = Astro.props as { locale?: Locale }
const t = getTranslations(locale)
---

<dialog class="lightbox" data-lightbox-modal aria-label={t.lightbox.viewer}>
  <figure class="lightbox__frame" data-lightbox-frame>
    <img class="lightbox__img" data-lightbox-img alt="" draggable="false" />
    <figcaption class="lightbox__caption" data-lightbox-caption></figcaption>
  </figure>

  <button
    type="button"
    class="lightbox__btn lightbox__btn--close"
    data-lightbox-close
    aria-label={t.lightbox.close}
    title={t.lightbox.close}
    autofocus
  >
    [×]
  </button>
  <button
    type="button"
    class="lightbox__btn lightbox__btn--prev"
    data-lightbox-prev
    aria-label={t.lightbox.previous}
    title={t.lightbox.previous}
  >
    ‹
  </button>
  <button
    type="button"
    class="lightbox__btn lightbox__btn--next"
    data-lightbox-next
    aria-label={t.lightbox.next}
    title={t.lightbox.next}
  >
    ›
  </button>

  <div class="lightbox__toolbar">
    <button
      type="button"
      class="lightbox__btn"
      data-lightbox-zoom-out
      aria-label={t.lightbox.zoomOut}
      title={t.lightbox.zoomOut}
    >
      [−]
    </button>
    <div class="lightbox__count" data-lightbox-count aria-hidden="true"></div>
    <button
      type="button"
      class="lightbox__btn"
      data-lightbox-zoom-in
      aria-label={t.lightbox.zoomIn}
      title={t.lightbox.zoomIn}
    >
      [+]
    </button>
    <button
      type="button"
      class="lightbox__btn"
      data-lightbox-reset
      aria-label={t.lightbox.resetZoom}
      title={t.lightbox.resetZoom}
    >
      [reset]
    </button>
  </div>
</dialog>

<script is:inline>
  const modal = document.querySelector('[data-lightbox-modal]')
  if (modal) {
    const imgEl = modal.querySelector('[data-lightbox-img]')
    const captionEl = modal.querySelector('[data-lightbox-caption]')
    const countEl = modal.querySelector('[data-lightbox-count]')
    const closeBtn = modal.querySelector('[data-lightbox-close]')
    const frameEl = modal.querySelector('[data-lightbox-frame]')
    const zoomInBtn = modal.querySelector('[data-lightbox-zoom-in]')
    const zoomOutBtn = modal.querySelector('[data-lightbox-zoom-out]')
    const resetBtn = modal.querySelector('[data-lightbox-reset]')

    let sources = []
    let captions = []
    let index = 0

    const MIN_SCALE = 1
    const MAX_SCALE = 4
    const DBL_SCALE = 2.5
    let scale = 1
    let tx = 0
    let ty = 0

    function sourcesOf(group) {
      const els = Array.from(group.querySelectorAll('[data-lightbox-src]'))
      if (els.length) return els.map((el) => el.dataset.lightboxSrc ?? '')
      return Array.from(group.querySelectorAll('img')).map((i) => i.currentSrc || i.src || '')
    }

    function captionsOf(group) {
      return Array.from(group.querySelectorAll('img')).map((i) => i.alt ?? '')
    }

    function apply(grabbing = false) {
      imgEl.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`
      imgEl.dataset.zoomed = grabbing ? 'grabbing' : scale > 1 ? 'true' : undefined
      zoomInBtn.disabled = scale >= MAX_SCALE
      zoomOutBtn.disabled = scale <= MIN_SCALE
      resetBtn.disabled = scale <= MIN_SCALE
    }

    function clampPan() {
      const maxX = Math.max(0, (imgEl.offsetWidth / 2) * (scale - 1))
      const maxY = Math.max(0, (imgEl.offsetHeight / 2) * (scale - 1))
      tx = Math.max(-maxX, Math.min(maxX, tx))
      ty = Math.max(-maxY, Math.min(maxY, ty))
    }

    function setZoom(next, anchorX = null, anchorY = null) {
      next = Math.max(MIN_SCALE, Math.min(MAX_SCALE, next))
      if (anchorX !== null && anchorY !== null) {
        const rect = imgEl.getBoundingClientRect()
        const px = anchorX - (rect.left + rect.width / 2)
        const py = anchorY - (rect.top + rect.height / 2)
        tx = Math.round(px - (px - tx) * (next / scale))
        ty = Math.round(py - (py - ty) * (next / scale))
      }
      scale = next
      clampPan()
      apply()
    }

    function resetZoom() {
      scale = 1
      tx = 0
      ty = 0
      apply()
    }

    function update() {
      if (!sources.length) return
      imgEl.src = sources[index]
      imgEl.alt = captions[index] ?? ''
      captionEl.textContent = captions[index] ?? ''
      countEl.textContent = `${index + 1} / ${sources.length}`
      resetZoom()
    }

    function open(group, start) {
      sources = sourcesOf(group)
      captions = captionsOf(group)
      index = Math.max(0, Math.min(start || 0, sources.length - 1))
      resetZoom()
      document.body.style.overflow = 'hidden'
      if (!modal.open) modal.showModal()
      update()
    }

    function go(step) {
      if (sources.length < 2) return
      index = (index + step + sources.length) % sources.length
      update()
    }

    const pointers = new Map()
    let dragX = null
    let dragY = null
    let suppressClick = false
    let pinch = null

    frameEl.addEventListener('pointerdown', (e) => {
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY })
      frameEl.setPointerCapture(e.pointerId)
      if (pointers.size === 2) {
        dragX = null
        dragY = null
        const [a, b] = Array.from(pointers.values())
        pinch = {
          dist: Math.hypot(a.x - b.x, a.y - b.y),
          midX: (a.x + b.x) / 2,
          midY: (a.y + b.y) / 2,
          scale,
          tx,
          ty,
        }
      } else if (pointers.size === 1) {
        dragX = e.clientX
        dragY = e.clientY
      }
    })

    frameEl.addEventListener('pointermove', (e) => {
      if (!pointers.has(e.pointerId)) return
      const cur = { x: e.clientX, y: e.clientY }
      pointers.set(e.pointerId, cur)

      if (pinch && pointers.size >= 2) {
        const [a, b] = Array.from(pointers.values())
        const dist = Math.hypot(a.x - b.x, a.y - b.y)
        const midX = (a.x + b.x) / 2
        const midY = (a.y + b.y) / 2
        scale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, pinch.scale * (dist / pinch.dist)))
        tx = pinch.tx + (midX - pinch.midX)
        ty = pinch.ty + (midY - pinch.midY)
        clampPan()
        apply(true)
        return
      }

      if (dragX === null || pointers.size !== 1) return
      const dx = cur.x - dragX
      const dy = cur.y - dragY

      if (scale > 1) {
        tx += dx
        ty += dy
        clampPan()
        apply(true)
        dragX = cur.x
        dragY = cur.y
      } else if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        go(dx < 0 ? 1 : -1)
        suppressClick = true
        dragX = null
        dragY = null
      }
    })

    const endPointer = (e) => {
      pointers.delete(e.pointerId)
      if (pointers.size < 2) pinch = null
      dragX = null
      dragY = null
      apply()
    }
    frameEl.addEventListener('pointerup', endPointer)
    frameEl.addEventListener('pointercancel', endPointer)

    frameEl.addEventListener('dblclick', (e) => {
      if (scale > 1) resetZoom()
      else setZoom(DBL_SCALE, e.clientX, e.clientY)
    })

    modal.addEventListener(
      'wheel',
      (e) => {
        if (!modal.open) return
        e.preventDefault()
        if (pointers.size > 0) return
        if (Math.abs(e.deltaY) < Math.abs(e.deltaX)) return
        const factor = Math.exp(-e.deltaY * 0.0025)
        setZoom(scale * factor, e.clientX, e.clientY)
      },
      { passive: false },
    )

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-lightbox-trigger]')
      if (!btn) return
      const group = btn.closest('[data-lightbox-group]')
      if (!group) return
      e.preventDefault()
      e.stopPropagation()
      const idx =
        btn.dataset.index !== undefined
          ? Number(btn.dataset.index)
          : Number(group.dataset.index || 0)
      open(group, Number.isFinite(idx) ? idx : 0)
    })

    closeBtn.addEventListener('click', () => modal.close())
    modal.querySelector('[data-lightbox-prev]').addEventListener('click', (e) => {
      e.stopPropagation()
      go(-1)
    })
    modal.querySelector('[data-lightbox-next]').addEventListener('click', (e) => {
      e.stopPropagation()
      go(1)
    })
    zoomInBtn.addEventListener('click', (e) => {
      e.stopPropagation()
      setZoom(scale * 1.5)
    })
    zoomOutBtn.addEventListener('click', (e) => {
      e.stopPropagation()
      setZoom(scale / 1.5)
    })
    resetBtn.addEventListener('click', (e) => {
      e.stopPropagation()
      resetZoom()
    })

    modal.addEventListener('click', (e) => {
      if (suppressClick) {
        suppressClick = false
        return
      }
      if (e.target === modal) modal.close()
    })

    // Esc: reset zoom first, then let the dialog close natively.
    modal.addEventListener('cancel', (e) => {
      if (scale > 1) {
        e.preventDefault()
        resetZoom()
      }
    })

    modal.addEventListener('close', () => {
      document.body.style.overflow = ''
      imgEl.removeAttribute('src')
      pointers.clear()
      pinch = null
      dragX = null
      dragY = null
      resetZoom()
    })

    document.addEventListener('keydown', (e) => {
      if (!modal.open) return
      if (e.key === 'ArrowLeft') {
        e.preventDefault()
        go(-1)
      } else if (e.key === 'ArrowRight') {
        e.preventDefault()
        go(1)
      } else if (e.key === '+' || e.key === '=') {
        e.preventDefault()
        setZoom(scale * 1.5)
      } else if (e.key === '-') {
        e.preventDefault()
        setZoom(scale / 1.5)
      } else if (e.key === '0') {
        e.preventDefault()
        resetZoom()
      }
    })
  }
</script>

<style>
  .lightbox {
    margin: 0;
    padding: 0;
    border: none;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    background: transparent;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox::backdrop {
    background: rgba(8, 10, 8, 0.94);
  }

  .lightbox__frame {
    max-width: 92vw;
    max-height: 92vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .lightbox__img {
    max-width: 92vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--border-char);
    transform-origin: center center;
    will-change: transform;
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
  }

  .lightbox__img[data-zoomed] {
    cursor: grab;
  }

  .lightbox__img[data-zoomed='grabbing'] {
    cursor: grabbing;
  }

  .lightbox__caption {
    color: var(--fg-dim);
    font-size: 0.75rem;
    padding-top: 0.75rem;
  }

  .lightbox__btn {
    background: var(--bg-surface);
    border: 1px solid var(--border-char);
    color: var(--accent);
    font-family: var(--font-mono);
    padding: 0.5rem 0.875rem;
    line-height: 1;
    cursor: pointer;
    transition:
      background 0.1s,
      color 0.1s;
  }

  .lightbox__btn:hover:not(:disabled) {
    background: var(--accent);
    color: var(--bg);
  }

  .lightbox__btn:disabled {
    color: var(--fg-muted);
    cursor: default;
  }

  .lightbox__btn--close {
    position: fixed;
    top: 1rem;
    right: 1rem;
  }

  .lightbox__btn--prev {
    position: fixed;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__btn--next {
    position: fixed;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__toolbar {
    position: fixed;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lightbox__toolbar .lightbox__btn {
    padding: 0.375rem 0.625rem;
  }

  .lightbox__count {
    color: var(--fg-dim);
    font-size: 0.75rem;
    padding: 0 0.25rem;
  }
</style>
