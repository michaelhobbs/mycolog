---
interface Props {
  locale: string
}
const { locale } = Astro.props as { locale: 'en' | 'de' }
---

<div class="map-frame">
  <div class="map-frame__title">
    <span class="map-frame__title-text">[ {locale === 'de' ? 'Ort wählen' : 'pick location'} ]</span
    >
    <span class="map-frame__coords" id="picker-coords"
      >{locale === 'de' ? 'noch kein Ort' : 'no location'}</span
    >
  </div>
  <div id="picker-map" class="picker-map" data-locale={locale}></div>
  <div class="map-frame__attribution">
    <span>OpenFreeMap · © OpenMapTiles · © OpenStreetMap contributors</span>
  </div>
</div>

<script>
  import maplibregl from 'maplibre-gl'
  import 'maplibre-gl/dist/maplibre-gl.css'

  const STYLE_URL = 'https://tiles.openfreemap.org/styles/fiord'

  function init() {
    const container = document.getElementById('picker-map')
    if (!container) return

    const map = new maplibregl.Map({
      container,
      style: STYLE_URL,
      center: [11.0922, 47.4917],
      zoom: 11,
    })

    const coordsEl = document.getElementById('picker-coords')
    let marker: maplibregl.Marker | null = null

    function paintPalette() {
      const paint = (layer: string, props: { [s: string]: unknown }) => {
        if (map.getLayer(layer)) {
          Object.entries(props).forEach(([k, v]) => map.setPaintProperty(layer, k, v))
        }
      }
      paint('background', { 'background-color': '#0e120b' })
      paint('landcover_wood', { 'fill-color': '#151a10', 'fill-opacity': 1 })
      paint('landuse_residential', { 'fill-color': '#11150c', 'fill-opacity': 1 })
      paint('water', { 'fill-color': '#2a7d94' })
      paint('waterway', { 'line-color': '#2a6a80' })
      ;['highway_major_casing', 'highway_motorway_casing'].forEach((l) =>
        paint(l, { 'line-color': '#151a10' }),
      )
      paint('highway_major_inner', { 'line-color': '#d4f0d4' })
      paint('highway_minor', { 'line-color': '#8fbf8f' })
      paint('highway_path', { 'line-color': '#33ff33', 'line-dasharray': [1.5, 1.5] })
    }

    function updatePin(lngLat: maplibregl.LngLat) {
      const el = document.createElement('div')
      el.className = 'picker-pin'
      el.innerHTML = ''
      if (marker) marker.remove()
      marker = new maplibregl.Marker({ element: el }).setLngLat(lngLat).addTo(map)

      const lat = lngLat.lat.toFixed(5)
      const lng = lngLat.lng.toFixed(5)
      if (coordsEl) coordsEl.textContent = `${lat}°N ${lng}°E`

      const input = document.getElementById('picker-location') as HTMLInputElement | null
      if (input) input.value = JSON.stringify({ lat: Number(lat), lng: Number(lng) })
    }

    map.on('load', () => {
      paintPalette()
      map.on('click', (e) => {
        updatePin(e.lngLat)
        map.getCanvas().style.cursor = 'crosshair'
      })
      map.on('mousemove', () => {
        map.getCanvas().style.cursor = 'crosshair'
      })
    })
  }

  if (document.readyState !== 'loading') init()
  else document.addEventListener('DOMContentLoaded', init)
</script>

<input type="hidden" id="picker-location" name="location" value="" />

<style>
  .map-frame {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
  }

  .map-frame__title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border-char);
    font-size: 0.8125rem;
  }

  .map-frame__title-text {
    color: var(--fg-bright);
    font-weight: 700;
  }

  .map-frame__coords {
    color: var(--fg-dim);
    font-size: 0.6875rem;
  }

  .picker-map {
    width: 100%;
    height: 480px;
    cursor: crosshair;
    touch-action: none;
    background: var(--bg-highlight);
  }

  .map-frame__attribution {
    padding: 0.375rem 0.75rem;
    border-top: 1px solid var(--border-char);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  :global(.picker-pin) {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg);
    box-shadow: 0 0 0 2px var(--accent-dim);
    cursor: crosshair;
  }

  :global(.maplibregl-ctrl-attrib) {
    display: none;
  }

  :global(.maplibregl-map) {
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .picker-map {
      height: 340px;
    }
  }
</style>
