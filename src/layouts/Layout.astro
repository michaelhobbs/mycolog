---
import type { Locale } from '../i18n'
import { getTranslations, locales, defaultLocale } from '../i18n'
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props {
  title: string
  locale?: Locale
}

const { title, locale = defaultLocale } = Astro.props
const t = getTranslations(locale)
const currentPath = Astro.url.pathname

function localizedPath(targetLocale: Locale): string {
  const subPath = currentPath.replace(/^\/(en|de)(\/|$)/, '/').replace(/^\/$/, '')
  return getRelativeLocaleUrl(targetLocale, subPath)
}
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={t.meta.homeDescription} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="header">
      <nav class="nav">
        <a href={`/${locale}`} class="nav__logo">
          <span class="nav__logo-icon" aria-hidden="true">@(</span>
          <span class="nav__logo-text">myco.log</span>
        </a>

        <span class="nav__sep" aria-hidden="true">│</span>

        <div class="nav__links">
          <a
            href={`/${locale}`}
            class:list={[
              'nav__link',
              {
                'nav__link--active': currentPath === `/${locale}` || currentPath === `/${locale}/`,
              },
            ]}>[{t.nav.home}]</a
          >
          <a
            href={`/${locale}/log`}
            class:list={['nav__link', { 'nav__link--active': currentPath.includes('/log') }]}
            >[{t.nav.log}]</a
          >
          <a
            href={`/${locale}/mushrooms`}
            class:list={['nav__link', { 'nav__link--active': currentPath.includes('/mushrooms') }]}
            >[{t.nav.mushrooms}]</a
          >
          <a
            href={`/${locale}/map`}
            class:list={['nav__link', { 'nav__link--active': currentPath.includes('/map') }]}
            >[{t.nav.map}]</a
          >
          <a
            href={`/${locale}/backlog`}
            class:list={['nav__link', { 'nav__link--active': currentPath.includes('/backlog') }]}
            >[{t.nav.backlog}]</a
          >
        </div>

        <div class="nav__lang">
          {
            locales.map((loc, i) => (
              <>
                {i > 0 && (
                  <span class="nav__lang-sep" aria-hidden="true">
                    /
                  </span>
                )}
                <a
                  href={localizedPath(loc)}
                  class:list={['nav__lang-btn', { 'nav__lang-btn--active': loc === locale }]}
                >
                  {loc}
                </a>
              </>
            ))
          }
        </div>

        <button class="nav__mobile-toggle" aria-label="Menu" data-mobile-toggle>
          <span>[=]</span>
        </button>
      </nav>

      <div class="nav__mobile-menu" data-mobile-menu>
        <a href={`/${locale}`} class="nav__mobile-link">{'>'} {t.nav.home}</a>
        <a href={`/${locale}/log`} class="nav__mobile-link">{'>'} {t.nav.log}</a>
        <a href={`/${locale}/mushrooms`} class="nav__mobile-link">{'>'} {t.nav.mushrooms}</a>
        <a href={`/${locale}/map`} class="nav__mobile-link">{'>'} {t.nav.map}</a>
        <a href={`/${locale}/backlog`} class="nav__mobile-link">{'>'} {t.nav.backlog}</a>
        <div class="nav__mobile-lang">
          {
            locales.map((loc) => (
              <a
                href={localizedPath(loc)}
                class:list={['nav__lang-btn', { 'nav__lang-btn--active': loc === locale }]}
              >
                {loc}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main class="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer__inner">
        <span class="footer__content">
          <span>{t.footer.copyright}</span>
        </span>
      </div>
    </footer>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.querySelector('[data-mobile-toggle]')
        const menu = document.querySelector('[data-mobile-menu]')
        if (!toggle || !menu) return
        toggle.addEventListener('click', () => {
          menu.classList.toggle('nav__mobile-menu--open')
        })
      })
    </script>
  </body>
</html>

<style is:global>
  /* ─── Reset ────────────────────────────────────── */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg: #0c0c0c;
    --bg-surface: #141414;
    --bg-highlight: #1a1a1a;
    --fg: #b4d4b4;
    --fg-bright: #d4f0d4;
    --fg-dim: #4a6a4a;
    --fg-muted: #2d4a2d;
    --accent: #33ff33;
    --accent-dim: #1a9a1a;
    --yellow: #d4d433;
    --red: #d44433;
    --border-char: #2d4a2d;

    --font-mono: 'JetBrains Mono', 'Fira Code', 'SF Mono', 'Cascadia Code', 'Consolas', monospace;

    --radius: 0;
  }

  html {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.65;
    color: var(--fg);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  img {
    display: block;
    max-width: 100%;
  }
  a {
    color: inherit;
  }

  /* ─── Header / Nav ────────────────────────────── */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border-char);
  }

  .nav {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 48px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__logo-icon {
    color: var(--accent);
    font-weight: 700;
  }

  .nav__logo-text {
    color: var(--fg-bright);
    font-weight: 700;
  }

  .nav__sep {
    color: var(--fg-muted);
  }

  .nav__links {
    display: flex;
    gap: 0.5rem;
  }

  .nav__link {
    color: var(--fg-dim);
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color 0.1s;
  }

  .nav__link:hover {
    color: var(--fg-bright);
  }

  .nav__link--active {
    color: var(--accent);
  }

  .nav__lang {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
  }

  .nav__lang-sep {
    color: var(--fg-muted);
  }

  .nav__lang-btn {
    color: var(--fg-dim);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color 0.1s;
  }

  .nav__lang-btn:hover {
    color: var(--fg-bright);
  }

  .nav__lang-btn--active {
    color: var(--accent);
  }

  .nav__mobile-toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: none;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 1rem;
    cursor: pointer;
    padding: 0.25rem;
  }

  .nav__mobile-menu {
    display: none;
    flex-direction: column;
    padding: 0.5rem 1.5rem 1rem;
    gap: 0.25rem;
    border-bottom: 1px solid var(--border-char);
  }

  .nav__mobile-menu--open {
    display: flex;
  }

  .nav__mobile-link {
    color: var(--fg-dim);
    text-decoration: none;
    padding: 0.375rem 0;
  }

  .nav__mobile-lang {
    display: flex;
    gap: 0.5rem;
    padding-top: 0.5rem;
    margin-top: 0.25rem;
    border-top: 1px dashed var(--fg-muted);
  }

  /* ─── Main ────────────────────────────────────── */
  .main {
    flex: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    width: 100%;
  }

  /* ─── Footer ──────────────────────────────────── */
  .footer {
    border-top: 1px solid var(--border-char);
    padding: 1.25rem 1.5rem;
    font-size: 0.8125rem;
  }

  .footer__inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .footer__content {
    color: var(--fg-dim);
  }

  /* ─── Responsive ──────────────────────────────── */
  @media (max-width: 768px) {
    .nav__links,
    .nav__lang,
    .nav__sep {
      display: none;
    }
    .nav__mobile-toggle {
      display: block;
    }
    .main {
      padding: 1.5rem 1rem;
    }
  }
</style>
