---
import Layout from '../../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import Block from '../../../components/Block.astro'
import MiniMap from '../../../components/MiniMap.astro'
import LinkRow from '../../../components/LinkRow.astro'
import SpeciesData from '../../../components/SpeciesData.astro'
import SpeciesGallery from '../../../components/SpeciesGallery.astro'
import SpeciesSources from '../../../components/SpeciesSources.astro'
import { speciesWikidata } from '../../../data/wikidata/species'
import { speciesTaxonomy } from '../../../data/taxonomy/species'
import { getTranslations, formatDate, locales } from '../../../i18n'
import { l10n } from '../../../i18n/helpers'
import { buildLocationMap, locationName } from '../../../lib/sightings'
import type { Locale } from '../../../i18n'

export function getStaticPaths() {
  return Promise.resolve(
    (async () => {
      const species = await getCollection('species')
      return species.flatMap((sp) => locales.map((locale) => ({ params: { locale, name: sp.id } })))
    })(),
  )
}

const { locale, name } = Astro.params as { locale: Locale; name: string }
const t = getTranslations(locale)

const [all, speciesList, locations] = await Promise.all([
  getCollection('sightings'),
  getCollection('species'),
  getCollection('locations'),
])
const species = speciesList.find((sp) => sp.id === name)
const locMap = buildLocationMap(locations)

const entries = all
  .filter((s) => s.data.species === name)
  .sort((a, b) => (a.data.dateSpotted < b.data.dateSpotted ? -1 : 1))

const sp = species?.data
// A species may have no common name in the current locale ("en": "" is how the
// absence is stored). Prefer the common name, fall back to the scientific name
// so the page title, tag and image alt are never blank.
const pageName = sp ? l10n(sp.commonName, locale) || sp.scientificName : name
// Flattened across sightings, so a photo's position here is the lightbox's own
// index on both this page and the gallery route.
const allImages = entries.flatMap((e) => e.data.images)
const sharedNotes = sp?.notes
const habitat = sp?.habitat
const edibility = sp?.edibility
const features = sp?.determiningFeatures ?? []
const fullSrcs = await Promise.all(
  allImages.map(async (img) => (await getImage({ src: img, width: 1600 }))?.src ?? ''),
)

// The Wikidata snapshot for this species, joined on the resolved QID rather
// than the slug. `wikidataId` is optional in the schema, so this can be
// undefined for a species that has no Wikidata item yet.
const wikidata = sp?.wikidataId ? speciesWikidata[sp.wikidataId] : undefined

// The Index Fungorum topology, keyed by collection slug like every other
// per-species lookup. Undefined until `update-species-taxonomy` has run for
// a newly added species.
const taxonomy = speciesTaxonomy[name]

// Built here rather than inline in the template: a newline inside a JSX text
// node collapses away, so `{t.mushrooms.sightings} ({entries.length})` on its
// own line would render as "8Sightings" the moment Prettier wrapped it.
const sightingsTitle = `${t.mushrooms.sightings} (${entries.length})`
---

<Layout title={`${pageName} — myco.log`} locale={locale}>
  <section class="species-page">
    <div class="page-header">
      <span class="page-header__tag">╔══ {pageName}</span>
      <span class="page-header__sub">{sp?.scientificName}</span>
    </div>

    <LinkRow
      locale={locale}
      fallback={`/${locale}/mushrooms`}
      links={[{ href: `/${locale}/mushrooms`, label: t.mushrooms.backToIndex }]}
    />

    {
      sp && (
        <div class="layout">
          {/* The gallery leads the DOM but sits in the right-hand column: the
              stacked page should still open on the photographs, and `order`
              handles that below rather than duplicating the markup. The map
              travels with it. */}
          <div class="band band--aside">
            <Block title={t.mushrooms.photosTitle}>
              <SpeciesGallery
                locale={locale}
                t={t}
                slug={name}
                commonName={sp.commonName}
                items={allImages}
                fullSrcs={fullSrcs}
              />
            </Block>

            {entries.length > 0 && (
              <MiniMap
                points={entries.map((e) => ({
                  lat: e.data.location.lat,
                  lng: e.data.location.lng,
                  label: locationName(locMap, e.data.locationSlug, locale),
                }))}
                fill
              />
            )}
          </div>

          <div class="band band--main">
            <SpeciesData
              data={wikidata}
              locale={locale}
              t={t}
              scientificName={sp.scientificName}
              slug={name}
              commonName={sp.commonName}
              habitat={habitat}
              edibility={edibility}
              taxonomy={taxonomy}
            />

            {features.length > 0 && (
              <Block title={t.mushrooms.features}>
                <ul class="block__list">
                  {features.map((f) => (
                    <li>▸ {l10n(f, locale)}</li>
                  ))}
                </ul>
              </Block>
            )}

            {sharedNotes && (
              <Block title={t.mushrooms.notes}>
                <p class="block__notes">{l10n(sharedNotes, locale)}</p>
              </Block>
            )}
          </div>

          <div class="band band--sightings">
            <Block title={sightingsTitle}>
              <ul class="block__sightings">
                {entries.map((e) => {
                  const sd = e.data
                  const cover = sd.images?.[0]
                  return (
                    <li class="sighting">
                      {cover && (
                        <a href={`/${locale}/log/${e.id}`} class="sighting__img">
                          <Image src={cover} alt={pageName} loading="lazy" width={96} />
                        </a>
                      )}
                      <div class="sighting__body">
                        <a href={`/${locale}/log/${e.id}`} class="sighting__date">
                          {formatDate(sd.dateSpotted, locale)}
                        </a>
                        <span class="sighting__loc">
                          @
                          {sd.locationSlug ? (
                            <a
                              href={`/${locale}/locations/${sd.locationSlug}`}
                              class="sighting__loc-link"
                            >
                              {locationName(locMap, sd.locationSlug, locale) || t.mushrooms.unknown}
                            </a>
                          ) : (
                            t.mushrooms.unknown
                          )}
                        </span>
                      </div>
                    </li>
                  )
                })}
              </ul>
            </Block>
          </div>

          {/* The sources are a full-width row of their own at the foot of the
              page, below the sightings. */}
          <div class="band band--sources">
            <SpeciesSources data={wikidata} locale={locale} t={t} columns />
          </div>
        </div>
      )
    }
  </section>
</Layout>

<style>
  .species-page {
    padding-bottom: 2rem;
  }

  .page-header {
    margin-bottom: 1.25rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--accent-dim);
    font-size: 0.8125rem;
  }

  .back {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .back__sep {
    color: var(--fg-subtle);
  }

  .tui-link {
    color: var(--accent-dim);
    text-decoration: none;
    font-size: 0.8125rem;
  }

  .tui-link:hover {
    color: var(--accent-text);
  }

  /* Two columns on top, one full-width row underneath. Grid, not CSS multicol:
     the columns are chosen bands rather than a flow that fills, because the
     gallery has to sit in the right column *and* come first in the DOM (it is
     the hero of the stacked page). Multicol cannot express "this group here,
     that group there" -- it just balances whatever it is given, which would
     scatter the map and the sources away from the photographs. */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 1.5rem;
    align-items: start;
  }

  /* Rows are named explicitly: with only `grid-column` set, auto-placement has
     to reason about the aside band coming first, and the sightings band is
     easier to reason about as "row 2" than as "the next free row". */
  .band--main {
    grid-column: 1;
    grid-row: 1;
  }

  /* `align-self: stretch` opts this band out of the grid's `align-items: start`.
     Without it the band is only as tall as the gallery plus a 320px map, so
     whenever the prose column is taller -- which is most species, now that the
     morphology and ecology icons are 78px -- the leftover space is dead space
     under the map. Stretching gives the band the full row height, and the flex
     column hands that slack to the map, which grows into it (MiniMap's `fill`).
     The main band keeps `start`: it is the one that defines the row height, and
     stretching it would only matter if the aside were taller, which it must not
     stretch into. */
  .band--aside {
    grid-column: 2;
    grid-row: 1;
    align-self: stretch;
    display: flex;
    flex-direction: column;
  }

  .band--sightings {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .band--sources {
    grid-column: 1 / -1;
    grid-row: 3;
  }

  /* The stacked override lives at the end of this stylesheet, not here: the
     rules it has to beat (`.block__sightings`) are defined further down, and
     equal-specificity media queries do not win by being a media query. */

  .block__list {
    list-style: none;
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.75rem;
  }

  .block__list li {
    color: var(--fg);
    line-height: 1.9;
    font-size: 0.8125rem;
  }

  .block__notes {
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.75rem;
    color: var(--fg);
    font-style: italic;
    line-height: 1.7;
    font-size: 0.8125rem;
  }

  /* The sightings are a full-width row, so the list splits into three columns of
     its own rather than leaving one long ribbon down the middle of the page.
     Three, not two: the row's content is a fixed 72px thumbnail plus a wrapping
     body, so narrowing the column costs a wrapped location line and no
     truncation. */
  .block__sightings {
    list-style: none;
    column-count: 3;
    column-gap: 1.5rem;
  }

  /* A row must not be cut in half by the column break, and multicol gives no
     vertical `gap` to block boxes, so the spacing moves onto the rows. */
  .sighting {
    display: flex;
    gap: 0.75rem;
    padding: 0.5rem;
    margin-bottom: 0.5rem;
    border: var(--border-w) solid var(--border-char);
    background: var(--bg-surface);
    font-size: 0.8125rem;
    break-inside: avoid;
  }

  .sighting__img {
    width: 72px;
    height: 56px;
    flex-shrink: 0;
    border: var(--border-w) solid var(--fg-muted);
    overflow: hidden;
    background: var(--bg-highlight);
  }

  .sighting__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sighting__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .sighting__date {
    color: var(--yellow);
    font-weight: 700;
    text-decoration: none;
  }

  .sighting__date:hover {
    color: var(--fg-bright);
  }

  .sighting__loc {
    color: var(--fg-dim);
    font-size: 0.75rem;
  }

  .sighting__loc-link {
    color: var(--fg-dim);
    text-decoration: none;
    transition: color 0.1s;
  }

  .sighting__loc-link:hover {
    color: var(--accent-text);
  }

  /* One column: below this width the right column cannot hold the hero photo
     at a readable size, so the page stacks. It reads in the order the bands
     occupy on the desktop grid: the left column top to bottom (names,
     morphology, ecology, edibility, key features, notes), then the second
     column (photos, map), then the full-width rows (sightings, sources).
     `order` rather than reordering the markup keeps the gallery first in the
     DOM, which is what the desktop grid places second -- so the two layouts
     share one set of elements. `grid-column`/`grid-row` are ignored once the
     grid becomes a flex column, so only `display` and `order` need
     overriding. The sources list drops its own two columns here too, in
     SpeciesSources. */
  @media (max-width: 900px) {
    .layout {
      display: flex;
      flex-direction: column;
      /* `align-items: start` from the grid rules above means "do not stretch"
         on a cross-axis-aligned flex container too, which shrank every band to
         its content's width and left the sightings list half the page. */
      align-items: stretch;
    }

    .band--main {
      order: 1;
    }

    .band--aside {
      order: 2;
    }

    .band--sightings {
      order: 3;
    }

    .band--sources {
      order: 4;
    }

    .block__sightings {
      column-count: 1;
    }
  }
</style>
