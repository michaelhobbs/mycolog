---
import Layout from '../../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import Block from '../../../components/Block.astro'
import MiniMap from '../../../components/MiniMap.astro'
import LinkRow from '../../../components/LinkRow.astro'
import SpeciesData from '../../../components/SpeciesData.astro'
import SpeciesSources from '../../../components/SpeciesSources.astro'
import { speciesWikidata } from '../../../data/wikidata/species'
import { getTranslations, formatDate, locales } from '../../../i18n'
import { l10n } from '../../../i18n/helpers'
import { buildLocationMap, locationName } from '../../../lib/sightings'
import type { Locale } from '../../../i18n'

export function getStaticPaths() {
  return Promise.resolve(
    (async () => {
      const species = await getCollection('species')
      return species.flatMap((sp) => locales.map((locale) => ({ params: { locale, name: sp.id } })))
    })(),
  )
}

const { locale, name } = Astro.params as { locale: Locale; name: string }
const t = getTranslations(locale)
const dev = import.meta.env.DEV

const [all, speciesList, locations] = await Promise.all([
  getCollection('sightings'),
  getCollection('species'),
  getCollection('locations'),
])
const species = speciesList.find((sp) => sp.id === name)
const locMap = buildLocationMap(locations)

const entries = all
  .filter((s) => s.data.species === name)
  .sort((a, b) => (a.data.dateSpotted < b.data.dateSpotted ? -1 : 1))

const sp = species?.data
const items = entries.flatMap((e) =>
  e.data.images.map((img, index) => ({ sighting: e.id, index, img })),
)
const allImages = items.map((item) => item.img)
const sharedNotes = sp?.notes
const habitat = sp?.habitat
const edibility = sp?.edibility
const features = sp?.determiningFeatures ?? []
const coverKey = sp?.cover ? `${sp.cover.sighting}#${sp.cover.index}` : null
const fullSrcs = await Promise.all(
  allImages.map(async (img) => (await getImage({ src: img, width: 1600 }))?.src ?? ''),
)

// The Wikidata snapshot for this species, joined on the resolved QID rather
// than the slug. `wikidataId` is optional in the schema, so this can be
// undefined for a species that has no Wikidata item yet.
const wikidata = sp?.wikidataId ? speciesWikidata[sp.wikidataId] : undefined

// Built here rather than inline in the template: a newline inside a JSX text
// node collapses away, so `{t.mushrooms.sightings} ({entries.length})` on its
// own line would render as "8Sightings" the moment Prettier wrapped it.
const sightingsTitle = `${t.mushrooms.sightings} (${entries.length})`
---

<Layout title={`${species ? l10n(sp?.commonName, locale) : name} — myco.log`} locale={locale}>
  <section class="species-page">
    <div class="page-header">
      <span class="page-header__tag">╔══ {sp ? l10n(sp.commonName, locale) : name}</span>
      <span class="page-header__sub">{sp?.scientificName}</span>
    </div>

    <LinkRow
      locale={locale}
      fallback={`/${locale}/mushrooms`}
      links={[{ href: `/${locale}/mushrooms`, label: t.mushrooms.backToIndex }]}
    />

    {
      sp && (
        <>
          <div class="gallery" data-lightbox-group>
            {items.map((item, i) => {
              const key = `${item.sighting}#${item.index}`
              return (
                <figure
                  class:list={['gallery__item', dev && coverKey === key && 'gallery__item--cover']}
                  data-lightbox-src={fullSrcs[i]}
                >
                  <button
                    type="button"
                    class="gallery__zoom"
                    data-lightbox-trigger
                    data-index={i}
                    aria-label={`${t.mushrooms.fullscreen} ${i + 1}`}
                    title={t.mushrooms.fullscreen}
                  >
                    <Image
                      src={item.img}
                      alt={`${l10n(sp.commonName, locale)} — ${i + 1}`}
                      loading="lazy"
                      width={640}
                      widths={[320, 640]}
                    />
                  </button>
                  {dev && (
                    <button
                      type="button"
                      class="gallery__cover"
                      data-cover
                      data-sighting={item.sighting}
                      data-index={item.index}
                      disabled={coverKey === key}
                      title={coverKey === key ? t.sighting.mainPhoto : t.sighting.setMainPhoto}
                    >
                      {coverKey === key ? t.sighting.mainPhoto : t.sighting.setMainPhoto}
                    </button>
                  )}
                </figure>
              )
            })}
          </div>

          {dev && <span id="cover-status" class="cover-status" role="status" />}

          <SpeciesData
            data={wikidata}
            locale={locale}
            t={t}
            scientificName={sp.scientificName}
            commonName={sp.commonName}
            habitat={habitat}
            edibility={edibility}
          />

          {features.length > 0 && (
            <Block title={t.mushrooms.features}>
              <ul class="block__list">
                {features.map((f) => (
                  <li>▸ {l10n(f, locale)}</li>
                ))}
              </ul>
            </Block>
          )}

          {sharedNotes && (
            <Block title={t.mushrooms.notes}>
              <p class="block__notes">{l10n(sharedNotes, locale)}</p>
            </Block>
          )}

          {entries.length > 0 && (
            <MiniMap
              points={entries.map((e) => ({
                lat: e.data.location.lat,
                lng: e.data.location.lng,
                label: locationName(locMap, e.data.locationSlug, locale),
              }))}
            />
          )}

          <Block title={sightingsTitle}>
            <ul class="block__sightings">
              {entries.map((e) => {
                const sd = e.data
                const cover = sd.images?.[0]
                return (
                  <li class="sighting">
                    {cover && (
                      <a href={`/${locale}/log/${e.id}`} class="sighting__img">
                        <Image
                          src={cover}
                          alt={l10n(sp.commonName, locale)}
                          loading="lazy"
                          width={96}
                        />
                      </a>
                    )}
                    <div class="sighting__body">
                      <a href={`/${locale}/log/${e.id}`} class="sighting__date">
                        {formatDate(sd.dateSpotted, locale)}
                      </a>
                      <span class="sighting__loc">
                        @
                        {sd.locationSlug ? (
                          <a
                            href={`/${locale}/locations/${sd.locationSlug}`}
                            class="sighting__loc-link"
                          >
                            {locationName(locMap, sd.locationSlug, locale) || t.mushrooms.unknown}
                          </a>
                        ) : (
                          t.mushrooms.unknown
                        )}
                      </span>
                    </div>
                  </li>
                )
              })}
            </ul>
          </Block>

          <SpeciesSources data={wikidata} locale={locale} t={t} />
        </>
      )
    }
  </section>

  <script
    is:inline
    define:vars={{
      coverEnabled: dev,
      coverSpecies: name,
      coverT: {
        updating: t.sighting.updating,
        updated: t.sighting.mainUpdated,
        error: t.sighting.error,
      },
    }}
  >
    if (coverEnabled) {
      const statusEl = document.getElementById('cover-status')
      document.querySelectorAll('[data-cover]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const payload = {
            sighting: btn.dataset.sighting,
            index: Number(btn.dataset.index),
          }
          btn.disabled = true
          if (statusEl) {
            statusEl.textContent = coverT.updating
            statusEl.dataset.state = 'pending'
          }
          try {
            const res = await fetch(`/myco/api/species/${coverSpecies}/cover`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            })
            if (!res.ok) {
              const err = await res.json().catch(() => ({}))
              throw new Error(err.error || 'HTTP ' + res.status)
            }
            if (statusEl) {
              statusEl.textContent = coverT.updated
              statusEl.dataset.state = 'ok'
            }
            window.location.reload()
          } catch (err) {
            console.error('[cover] failed:', err)
            if (statusEl) {
              statusEl.textContent =
                coverT.error + (err instanceof Error ? ' — ' + err.message : '')
              statusEl.dataset.state = 'error'
            }
            btn.disabled = false
          }
        })
      })
    }
  </script>
</Layout>

<style>
  .species-page {
    padding-bottom: 2rem;
  }

  .page-header {
    margin-bottom: 1.25rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--accent-dim);
    font-size: 0.8125rem;
  }

  .back {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .back__sep {
    color: var(--fg-subtle);
  }

  .tui-link {
    color: var(--accent-dim);
    text-decoration: none;
    font-size: 0.8125rem;
  }

  .tui-link:hover {
    color: var(--accent);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .gallery__item {
    margin: 0;
    border: 1px solid var(--fg-muted);
    overflow: hidden;
    background: var(--bg-highlight);
    aspect-ratio: 4 / 3;
    position: relative;
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: filter 0.15s;
  }

  .gallery__zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
    /* Opts out of iOS double-tap-to-zoom, so a single tap fires click. */
    touch-action: manipulation;
  }

  .gallery__zoom:hover img {
    filter: brightness(1.08);
  }

  .gallery__item.gallery__item--cover {
    border-color: var(--accent);
  }

  .gallery__cover {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: #0e120b;
    border: none;
    border-top: 1px solid var(--border-char);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    transition:
      background 0.1s,
      color 0.1s;
  }

  .gallery__cover:hover:not(:disabled) {
    background: var(--accent);
    color: var(--bg);
  }

  .gallery__cover:disabled {
    color: var(--yellow);
    cursor: default;
  }

  .cover-status {
    display: block;
    margin: -0.25rem 0 1.25rem;
    font-size: 0.75rem;
  }

  .cover-status[data-state='error'] {
    color: var(--red);
  }

  .cover-status[data-state='ok'] {
    color: var(--accent);
  }

  .cover-status[data-state='pending'] {
    color: var(--fg-dim);
  }

  .block__list {
    list-style: none;
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.75rem;
  }

  .block__list li {
    color: var(--fg);
    line-height: 1.9;
    font-size: 0.8125rem;
  }

  .block__notes {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    padding: 0.75rem;
    color: var(--fg);
    font-style: italic;
    line-height: 1.7;
    font-size: 0.8125rem;
  }

  .block__sightings {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sighting {
    display: flex;
    gap: 0.75rem;
    padding: 0.5rem;
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    font-size: 0.8125rem;
  }

  .sighting__img {
    width: 72px;
    height: 56px;
    flex-shrink: 0;
    border: 1px solid var(--fg-muted);
    overflow: hidden;
    background: var(--bg-highlight);
  }

  .sighting__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sighting__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .sighting__date {
    color: var(--yellow);
    font-weight: 700;
    text-decoration: none;
  }

  .sighting__date:hover {
    color: var(--fg-bright);
  }

  .sighting__loc {
    color: var(--fg-dim);
    font-size: 0.75rem;
  }

  .sighting__loc-link {
    color: var(--fg-dim);
    text-decoration: none;
    transition: color 0.1s;
  }

  .sighting__loc-link:hover {
    color: var(--accent);
  }
</style>
