---
import Layout from '../../layouts/Layout.astro'
import MapVector from '../../components/MapVector.astro'
import { getCollection } from 'astro:content'
import { enrichSightings } from '../../lib/sightings'
import { getTranslations, locales } from '../../i18n'
import type { Locale } from '../../i18n'

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }
const t = getTranslations(locale)

const [sightingEntries, speciesEntries] = await Promise.all([
  getCollection('sightings'),
  getCollection('species'),
])
const sightings = enrichSightings(sightingEntries, speciesEntries)
---

<Layout title={t.meta.mapTitle} locale={locale}>
  <section class="map-page">
    <div class="page-header">
      <span class="page-header__tag">╔══ {t.map.title}</span>
      <span class="page-header__sub">{t.map.subtitle}</span>
    </div>

    <MapVector sightings={sightings} locale={locale} center={[47.4917, 11.0922]} />

    <div class="legend">
      <span>@@</span>
      <span class="legend__text">{t.map.legendHint}</span>
    </div>
  </section>
</Layout>

<style>
  .map-page {
    padding-bottom: 2rem;
  }

  .page-header {
    margin-bottom: 1.25rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    font-size: 0.75rem;
    color: var(--accent);
  }

  .legend__text {
    color: var(--fg-dim);
  }
</style>
