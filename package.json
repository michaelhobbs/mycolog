{
  "name": "mushrooms",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/generate-thumbnails.mjs --soft",
    "dev": "astro dev",
    "prebuild": "node scripts/generate-thumbnails.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "update-backlog": "node scripts/import-backlog-public.mjs",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "prepare": "husky",
    "api": "node scripts/api.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.2.6",
    "maplibre-contour": "^0.1.0",
    "maplibre-gl": "^6.11.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "lint-staged": {
    "*.{astro,js,mjs,ts,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@jetbrains/postcss-require-hover": "^0.2.0",
    "@maplibre/maplibre-gl-native": "^6.4.1",
    "@types/node": "^26.6.1",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
}
