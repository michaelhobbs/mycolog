---
import Layout from '../../layouts/Layout.astro';

const GARMISCH = [11.0922, 47.4917];
---

<!--
  Proof of concept: the free OpenFreeMap vector map of Garmisch-Partenkirchen,
  rendered with MapLibre GL JS in the dark style, no customizations.
-->
<Layout title="maplibre vector POC — Garmisch-Partenkirchen" locale="en">
  <section class="poc">
    <div class="poc__header">
      <span class="poc__tag"
        >╔══ maplibre vector map — Garmisch-Partenkirchen [POC]</span
      >
      <span class="poc__sub">
        vector tiles from OpenStreetMap via OpenFreeMap · base style, no
        customizations. Drag to pan, scroll to zoom.</span
      >
    </div>

    <div class="poc__frame">
      <div id="map" class="poc__map"></div>
      <div class="poc__attribution">
        <span>OpenFreeMap · © OpenMapTiles · © OpenStreetMap contributors</span>
      </div>
    </div>

    <div class="poc__note">
      <span class="poc__note-tag">╔═ how it works</span>
      <p>
        A <b>MapLibre GL</b> map loads the free <b>OpenFreeMap</b> style — vector
        tiles generated from OpenStreetMap, no API key required. The base style is
        shown unchanged, centred on Garmisch-Partenkirchen.
      </p>
    </div>
  </section>
</Layout>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  const STYLE_URL = 'https://tiles.openfreemap.org/styles/dark';

  function initMap() {
    const container = document.getElementById('map');
    if (!container) return;

    // 15 km from center in each direction (30 km NS total), with the east-west
    // extent derived to match the container's aspect ratio so the box is a
    // rectangle matching the visible viewport.
    // 1 deg lat ~ 111.32 km; 1 deg lon ~ 111.32 * cos(lat).
    const lat = 47.4917, lon = 11.0922;
    const ar = container.clientWidth / container.clientHeight;

    const dLat = 15 / 111.32;                                 // 15 km NS
    const dLon = (15 * ar) / (111.32 * Math.cos((lat * Math.PI) / 180)); // EW keeps aspect ratio
    const w = lon - dLon, e = lon + dLon;
    const s = lat - dLat, n = lat + dLat;

    const map = new maplibregl.Map({
      container,
      style: STYLE_URL,
      center: [lon, lat],
      zoom: 12,
      // No maxBounds / minZoom: the user can pan and zoom freely. Everything
      // outside the 5 km box is simply hidden behind a mask polygon.
    });

    map.on('load', () => {
      // Mask = a world fill with the box as a hole, so the area outside the
      // 5 km box is hidden. The hole is defined with a reversed winding order.
      const mask = {
        type: 'FeatureCollection',
        features: [
          {
            type: 'Feature',
            properties: {},
            geometry: {
              type: 'Polygon',
              coordinates: [
                [[-180, -90], [180, -90], [180, 90], [-180, 90], [-180, -90]],
                [[w, s], [w, n], [e, n], [e, s], [w, s]],
              ],
            },
          },
        ],
      };

      map.addSource('box-mask', { type: 'geojson', data: mask });
      map.addLayer({
        id: 'box-mask-fill',
        type: 'fill',
        source: 'box-mask',
        paint: { 'fill-color': '#16161a', 'fill-opacity': 1 },
      });

      // Outline of the 15 km box
      map.addLayer({
        id: 'box-mask-outline',
        type: 'line',
        source: 'box-mask',
        paint: { 'line-color': '#4a6a4a', 'line-width': 1.5 },
      });

      map.fitBounds([[w, s], [e, n]], { padding: 16 });
    });

    map.addControl(
      new maplibregl.NavigationControl({ showCompass: false }),
      'bottom-right',
    );
    map.addControl(
      new maplibregl.AttributionControl({ compact: true }),
      'bottom-left',
    );
  }

  document.addEventListener('DOMContentLoaded', initMap);
</script>

<style>
  .poc {
    padding-bottom: 1rem;
  }

  .poc__header {
    margin-bottom: 1rem;
  }

  .poc__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .poc__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .poc__frame {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
  }

  .poc__map {
    width: 100%;
    height: 640px;
    cursor: grab;
    touch-action: none;
    background: var(--bg-highlight);
  }

  .poc__map:active {
    cursor: grabbing;
  }

  .poc__attribution {
    padding: 0.375rem 0.75rem;
    border-top: 1px solid var(--border-char);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  .poc__note {
    margin-top: 1rem;
  }

  .poc__note-tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 0.8125rem;
    margin-bottom: 0.375rem;
  }

  .poc__note p {
    color: var(--fg-dim);
    font-size: 0.8125rem;
    line-height: 1.7;
    max-width: 720px;
  }

  .poc__note b {
    color: var(--fg-bright);
  }

  :global(.maplibregl-map) {
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .poc__map {
      height: 420px;
    }
  }
</style>
