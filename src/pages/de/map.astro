---
import Layout from '../../layouts/Layout.astro';
import Map from '../../components/Map.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getTranslations } from '../../i18n';
import type { Locale } from '../../i18n';

const locale: Locale = 'de';
const t = getTranslations(locale);

const sightings = await getCollection('sightings');
---

<Layout title="karte — myco.log" locale={locale}>
  <section class="map-page">
    <div class="page-header">
      <span class="page-header__tag">╔══ {t.map.title}</span>
      <span class="page-header__sub">{t.map.subtitle}</span>
    </div>

    <Map
      sightings={sightings}
      locale={locale}
      center={[47.4917, 11.0922]}
      zoom={13}
    />

    <div class="legend">
      <span>@@</span>
      <span class="legend__text">{t.map.legendHint}</span>
    </div>

    <section class="list">
      <div class="list__header">
        <span class="list__title">╠══ {t.map.allSightings} ({sightings.length})</span>
      </div>
      <div class="list__grid">
        {sightings.map((entry) => {
          const sighting = entry.data;
          const date = new Date(sighting.dateSpotted).toLocaleDateString('de-DE', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
          });
          const name = sighting.location.name?.de ?? `${sighting.location.lat.toFixed(4)}°N ${sighting.location.lng.toFixed(4)}°E`;
          return (
            <div class="list-item">
              <div class="list-item__img">
                {sighting.images?.[0] && (
                  <Image src={sighting.images[0]} alt={sighting.commonName.de} loading="lazy" width={96} />
                )}
              </div>
              <div class="list-item__body">
                <span class="list-item__species">{sighting.species}</span>
                <h3 class="list-item__name">{sighting.commonName.de}</h3>
                <div class="list-item__meta">
                  <span class="list-item__lbl">datum</span>
                  <span class="list-item__dot"></span>
                  <span>{date}</span>
                </div>
                <div class="list-item__meta">
                  <span class="list-item__lbl">ort</span>
                  <span class="list-item__dot"></span>
                  <span>{name}</span>
                </div>
                {sighting.habitat && (
                  <span class="list-item__habitat">└─ {sighting.habitat.de}</span>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </section>
</Layout>

<style>
  .map-page { padding-bottom: 2rem; }

  .page-header { margin-bottom: 1.25rem; }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    font-size: 0.75rem;
    color: var(--accent);
  }

  .legend__text {
    color: var(--fg-dim);
  }

  .list { margin-top: 2rem; }

  .list__header {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-char);
    margin-bottom: 1rem;
  }

  .list__title {
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .list__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 0.75rem;
  }

  .list-item {
    display: flex;
    gap: 0.75rem;
    padding: 0.625rem;
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    font-size: 0.8125rem;
    transition: border-color 0.1s;
  }

  .list-item:hover {
    border-color: var(--accent-dim);
  }

  .list-item__img {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border: 1px solid var(--fg-muted);
    overflow: hidden;
    background: var(--bg-highlight);
  }

  .list-item__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.5) brightness(0.8);
  }

  .list-item__body { flex: 1; min-width: 0; }

  .list-item__species {
    font-size: 0.6875rem;
    color: var(--accent-dim);
  }

  .list-item__name {
    color: var(--fg-bright);
    font-size: 0.875rem;
    font-weight: 700;
    margin: 0.125rem 0 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .list-item__meta {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .list-item__lbl {
    color: var(--fg-muted);
    flex-shrink: 0;
  }

  .list-item__dot {
    flex: 1;
    border-bottom: 1px dotted var(--fg-muted);
    min-width: 0.5rem;
    margin-bottom: 0.2em;
  }

  .list-item__habitat {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  @media (max-width: 640px) {
    .list__grid { grid-template-columns: 1fr; }
  }
</style>
