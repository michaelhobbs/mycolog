---
import Layout from '../../layouts/Layout.astro'
import Notice from '../../components/Notice.astro'
import NewsFeed from '../../components/NewsFeed.astro'
import { getTranslations, locales } from '../../i18n'
import type { Locale } from '../../i18n'
import { getRelativeLocaleUrl } from 'astro:i18n'

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }
const t = getTranslations(locale)
const mapUrl = getRelativeLocaleUrl(locale, 'map')
const logUrl = getRelativeLocaleUrl(locale, 'log')
const mushroomsUrl = getRelativeLocaleUrl(locale, 'mushrooms')
---

<Layout title={t.meta.homeTitle} locale={locale}>
  <section class="hero">
    <pre
      class="hero__ascii hero__ascii--wordmark"
      aria-hidden="true">
