---
import Layout from '../../../layouts/Layout.astro'
import LinkRow from '../../../components/LinkRow.astro'
import MushroomCard from '../../../components/MushroomCard.astro'
import DateRail from '../../../components/DateRail.astro'
import { getCollection } from 'astro:content'
import { enrichSightings, buildLocationMap, locationName } from '../../../lib/sightings'
import { getTranslations, formatDate, locales } from '../../../i18n'
import { formatDayLong, type RailDay } from '../../../lib/date-rail'
import type { Locale } from '../../../i18n'

export function getStaticPaths() {
  return Promise.resolve(
    (async () => {
      const sightings = await getCollection('sightings')
      const dates = [...new Set(sightings.map((s) => s.data.dateSpotted))].sort()
      return dates.flatMap((date) => locales.map((locale) => ({ params: { locale, date } })))
    })(),
  )
}

const { locale, date } = Astro.params as { locale: Locale; date: string }
const t = getTranslations(locale)

const [all, species, locations] = await Promise.all([
  getCollection('sightings'),
  getCollection('species'),
  getCollection('locations'),
])
const enriched = enrichSightings(all, species)
const list = enriched.filter((s) => s.dateSpotted === date).sort((a, b) => a.id.localeCompare(b.id))
const locMap = buildLocationMap(locations)

const byDate = new Map<string, typeof list>()
for (const s of enriched) {
  const bucket = byDate.get(s.dateSpotted)
  if (bucket) bucket.push(s)
  else byDate.set(s.dateSpotted, [s])
}

const railDays: RailDay[] = [...byDate.entries()]
  .map(([day, items]) => {
    const names = [...new Set(items.map((s) => s.locationSlug).filter(Boolean))]
      .slice(0, 3)
      .map((slug) => locationName(locMap, slug, locale))
    return { date: day, count: items.length, meta: names.join(' · ') || undefined }
  })
  .sort((a, b) => (a.date < b.date ? 1 : -1))
const countLabel = `${list.length} ${t.log.sightingsCount}`
---

<Layout title={`${t.log.today} ${date ?? ''} — myco.log`} locale={locale}>
  <DateRail
    days={railDays}
    basePath={`/${locale}/log`}
    locale={locale}
    countUnit={t.log.sightingsCount}
    navLabel={t.common.jumpToDate}
    activeDate={date}
    activeLabel={date ? formatDayLong(date, locale) : ''}
  >
    <div class="page-header">
      <span class="page-header__tag">╔══ {t.log.today} {date ? formatDate(date, locale) : ''}</span>
      <span class="page-header__sub">{countLabel}</span>
    </div>

    <LinkRow
      locale={locale}
      fallback={`/${locale}/log`}
      links={[{ href: `/${locale}/log`, label: t.log.backToLog }]}
    />

    {
      list.length === 0 ? (
        <p class="empty">{t.log.noSightings}</p>
      ) : (
        <div class="day__grid">
          {list.map((s) => (
            <MushroomCard sighting={s} locale={locale} locations={locMap} />
          ))}
        </div>
      )
    }
  </DateRail>
</Layout>

<style>
  .page-header {
    margin-bottom: 1rem;
  }

  .page-header__tag {
    display: block;
    color: var(--fg-bright);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .page-header__sub {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .empty {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .day__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .day__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
