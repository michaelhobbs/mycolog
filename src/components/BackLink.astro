---
import type { Locale } from '../i18n'
import { getTranslations } from '../i18n'

interface Props {
  locale: Locale
  fallback: string
}

const { locale, fallback } = Astro.props
const t = getTranslations(locale)
---

<a class="back-link" data-back href={fallback}>
  {'<'}
  {t.common.back}
</a>

<style>
  .back-link {
    color: var(--accent-dim);
    text-decoration: none;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .back-link:hover {
    color: var(--accent);
  }
</style>
