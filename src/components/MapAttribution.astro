---
const services = [
  { label: 'OpenFreeMap', href: 'https://openfreemap.org/' },
  { label: '© OpenMapTiles', href: 'https://openmaptiles.org/' },
  { label: '© OpenStreetMap contributors', href: 'https://www.openstreetmap.org/copyright' },
]
---

<div class="map-attribution">
  {
    services.map((service, i) => (
      <>
        {i > 0 && ' '}
        <span class="map-attribution__item">
          <a
            class="map-attribution__link"
            href={service.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {service.label}
          </a>
          {i < services.length - 1 && <span class="map-attribution__sep"> ·</span>}
        </span>
      </>
    ))
  }
</div>

<style>
  .map-attribution {
    padding: 0.375rem 0.75rem;
    border-top: 1px solid var(--border-char);
    font-size: 0.6875rem;
    color: var(--fg-dim);
    text-align: right;
  }

  .map-attribution__item {
    white-space: nowrap;
  }

  .map-attribution__sep {
    color: var(--fg-subtle);
  }

  .map-attribution__link {
    color: var(--fg-dim);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .map-attribution__link:hover {
    color: var(--accent);
  }

  .map-attribution__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
