---
// The picture that stands for a Wikidata value: the drawing if there is one,
// otherwise a square of the colour Wikidata records for it, otherwise nothing.
//
// A value can have a glyph, a colour, or both — three spore print values are
// drawn but carry no triplet, and 13 carry a triplet but no drawing — so this asks
// for both and prefers the drawing. Rendering nothing is still a real outcome
// (four values have neither) and the caller must live with it.
//
// The sizing lives here rather than in the caller's stylesheet because Astro's
// scoped styles do not reach an element rendered by another component: a class
// the caller passes in would carry the caller's scope attribute, not this one's.
import { colorsFor, iconUrlFor } from '../lib/wikidata-icons'

interface Props {
  qid: string
  /** `row` is the large morphology/ecology size, `chip` the compact edibility one. */
  variant?: 'row' | 'chip'
}

const { qid, variant = 'row' } = Astro.props
const icon = iconUrlFor(qid)
const colors = colorsFor(qid)

// Wikidata stores a bare triplet; the generator normalises it to `#RRGGBB`.
// This is the *fill* only. The spokes and the rim are painted by CSS on top of
// it, so the value is passed as a custom property rather than as `background`.
//
// It must always be an <image>, never a bare colour: a colour is not valid in a
// `background-image` list, and because `var()` resolves at computed-value time,
// one bad layer silently drops the *whole* declaration and leaves `none`.
const fill =
  colors.length === 0
    ? null
    : colors.length === 1
      ? `linear-gradient(${colors[0]}, ${colors[0]})`
      : // No triplet is canonical, so rather than pick one, band the fill into
        // equal stripes of all of them. At one colour this is a flat fill.
        `linear-gradient(90deg, ${colors
          .map((c, i) => {
            const from = ((i * 100) / colors.length).toFixed(2)
            const to = (((i + 1) * 100) / colors.length).toFixed(2)
            return `${c} ${from}% ${to}%`
          })
          .join(', ')})`

// The sheet the print is taken on, chosen per value so the powder always reads:
// a near-black sheet under a light spore print, a near-white one under a dark
// one. Comparing measured contrast beats thresholding on luminance — the two
// candidates are not symmetric about 0.5, because WCAG's +0.05 offset pulls the
// crossover down to ~0.22, and a mid-tone like `tan` (0.48) is far more legible
// on near-black than on near-white. With several triplets the sheet must suit the
// *worst* of them, or a band of the fill would disappear into the paper.
const PAPER_DARK = '#0a0a0a'
const PAPER_LIGHT = '#f7f7f4'

/** WCAG relative luminance of a `#RRGGBB` triplet. */
function luminance(hex: string): number {
  const lin = (i: number) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4
  }
  return 0.2126 * lin(1) + 0.7152 * lin(3) + 0.0722 * lin(5)
}

/** WCAG contrast ratio between two relative luminances. */
const ratio = (a: number, b: number) => (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05)

const paper = (() => {
  const lit = colors.map(luminance).filter(Number.isFinite)
  if (lit.length === 0) return PAPER_DARK
  const worstOn = (hex: string) => Math.min(...lit.map((l) => ratio(l, luminance(hex))))
  return worstOn(PAPER_LIGHT) >= worstOn(PAPER_DARK) ? PAPER_LIGHT : PAPER_DARK
})()

// Named on the element so the exact triplets reach a screen reader and a hover:
// "buff", "tan" and "cream" are ambiguous in a way their hex codes are not.
const label = colors.join(' ')
---

{
  icon ? (
    <img
      class:list={['mark', `mark--${variant}`]}
      src={icon}
      alt=""
      loading="lazy"
      width={variant === 'row' ? 112 : 28}
      height={variant === 'row' ? 112 : 28}
    />
  ) : fill ? (
    <span
      class:list={['mark', `mark--${variant}`, 'swatch']}
      style={`--spore-fill: ${fill}; --spore-paper: ${paper}`}
      role="img"
      aria-label={label}
      title={label}
    />
  ) : null
}

<style>
  /* Commons drawings are 300px and arrive in mixed PNG/SVG; constrain both axes
     so neither a square PNG nor a tall drawing stretches a row. `flex-shrink`
     keeps a long value from squashing it. */
  .mark {
    flex-shrink: 0;
    object-fit: contain;
  }

  /* The enlarged variant, for the morphology and ecology rows. It trails the
     value rather than leading it, which also fixes the row's baseline: a flex
     container takes its baseline from its first item, so with the mark first the
     whole row hung off the image's bottom edge instead of the text's. Edibility
     keeps the compact size — its marks sit in a chip list, not in a row. */
  .mark--row {
    width: 5.6rem;
    height: 5.6rem;
  }

  .mark--chip {
    width: 1.4rem;
    height: 1.4rem;
  }

  /* Drawn as a spore print rather than a flat chip: a cap pressed gill-down
     leaves fine lines converging under the stem, denser at the middle and
     fading towards the rim of the cap, and broken into dashes rather than solid.

     `--spore-fill` is the sheet's colour and `--spore-paper` the sheet itself,
     both from the inline style: one triplet, or a banded gradient when the value
     has several and none is canonical. A `repeating-conic-gradient` draws the
     lines because a transform can move and scale a picture but cannot draw the
     hundred or so of them a gill pattern has.

     The lines go on a pseudo-element so they can be masked without taking the
     fill and the ring with them — the fill keeps its exact colour instead of
     being tinted towards the paper by a rim fade. */
  .swatch {
    position: relative;
    border-radius: 50%;
    background: var(--spore-fill);
    /* A hairline border, or a near-black fill loses its shape against the
       surface. It is inset so the ring does not enlarge the disc. */
    box-shadow: inset 0 0 0 1px var(--border-char);
  }

  .swatch::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: repeating-conic-gradient(
      from 0deg at 50% 50%,
      var(--spore-paper) 0 1.5deg,
      transparent 1.5deg 3deg
    );
    /* Two masks, multiplied, because both effects vary with radius and one
       layer cannot express them:

     - a radial one carries the density gradient. The lines converge on their own
       — a conic gradient spaces them by r·θ, so they crowd the centre — and
       this turns that into something visible, fading them out towards the rim. It
       also clears the very centre, where lines that close would merge into a
       blob.
     - a repeating radial one cuts them into dashes. Its lengths are in pixels, so
       the same dash subtends a shrinking angle towards the middle: dots near the
       centre, short strokes further out.

     `mask-composite` is what multiplies them. Its absence degrades to `add`, i.e.
     the dashes union back in and the rim fade is lost — the flat disc of the
     first version, not a broken mark. The `-webkit-` keywords differ, hence both. */
    -webkit-mask-image:
      radial-gradient(
        circle at 50% 50%,
        transparent 0 3%,
        #000 10%,
        rgba(0, 0, 0, 0.6) 45%,
        rgba(0, 0, 0, 0.16) 82%,
        transparent 100%
      ),
      repeating-radial-gradient(circle at 50% 50%, #000 0 1.2px, transparent 1.2px 3.6px);
    mask-image:
      radial-gradient(
        circle at 50% 50%,
        transparent 0 3%,
        #000 10%,
        rgba(0, 0, 0, 0.6) 45%,
        rgba(0, 0, 0, 0.16) 82%,
        transparent 100%
      ),
      repeating-radial-gradient(circle at 50% 50%, #000 0 1.2px, transparent 1.2px 3.6px);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
</style>
