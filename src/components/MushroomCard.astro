---
import type { Locale } from '../i18n'
import type { EnrichedSighting, LocationMap } from '../lib/sightings'
import { locationName } from '../lib/sightings'
import { Image, getImage } from 'astro:assets'
import { l10n } from '../i18n/helpers'
import { formatDate, getTranslations } from '../i18n'

interface Props {
  sighting: EnrichedSighting
  locale: Locale
  locations: LocationMap
}

const { sighting, locale, locations } = Astro.props
const s = sighting
const t = l10n
const dict = getTranslations(locale)

const fullUrls = await Promise.all(
  (s.images ?? []).map(async (img) => {
    const resolved = await getImage({ src: img, width: 1600 })
    return resolved?.src ?? ''
  }),
)
---

<div class="tui-card">
  <div class="tui-card__head">
    <a href={`/${locale}/log/${s.slug}`} class="tui-card__title"
      >┌─ {t(s.species.commonName, locale)}</a
    >
    <a href={`/${locale}/log/${s.slug}`} class="tui-card__more">{'>'}{dict.card.more}</a>
  </div>

  <div
    class="tui-card__carousel"
    data-carousel={s.images && s.images.length > 1 ? '' : undefined}
    data-lightbox-group
  >
    {
      s.images?.map((img, i) => (
        <button
          class="tui-card__slide"
          type="button"
          data-active={i === 0 ? '' : undefined}
          data-lightbox-src={fullUrls[i]}
          data-lightbox-trigger
          data-index={i}
          aria-label={`${dict.card.fullscreen} ${i + 1}`}
          title={dict.card.fullscreen}
        >
          <Image
            src={img}
            alt={t(s.species.commonName, locale)}
            loading="lazy"
            widths={[640, 320]}
            sizes="(min-width: 640px) 320px, 100vw"
          />
        </button>
      ))
    }
    <div class="tui-card__overlay">
      <a href={`/${locale}/log/${s.slug.split('/')[0]}`} class="tui-card__date"
        >{formatDate(s.dateSpotted, locale)}</a
      >
    </div>
    {
      (s.images?.length ?? 0) > 1 && (
        <>
          <button
            class="tui-card__arrow tui-card__arrow--prev"
            data-arrow="prev"
            aria-label="Previous"
          >
            ‹
          </button>
          <button class="tui-card__arrow tui-card__arrow--next" data-arrow="next" aria-label="Next">
            ›
          </button>
        </>
      )
    }
  </div>

  {
    (s.images?.length ?? 0) > 1 && (
      <div class="tui-card__thumbs">
        {s.images.map((img, i) => (
          <button
            class="tui-card__thumb"
            type="button"
            data-thumb
            data-index={i}
            aria-label={`${i + 1}`}
          >
            <Image src={img} alt="" loading="lazy" width={96} />
            <span class="tui-card__thumb-idx">{i + 1}</span>
          </button>
        ))}
      </div>
    )
  }

  <div class="tui-card__body">
    <div class="tui-card__row">
      <span class="tui-card__label">species</span>
      <span class="tui-card__sep-dots"></span>
      <a href={`/${locale}/mushrooms/${s.id}`} class="tui-card__val tui-card__val--link"
        >{s.species.scientificName}</a
      >
    </div>
    <div class="tui-card__row">
      <span class="tui-card__label">location</span>
      <span class="tui-card__sep-dots"></span>
      {
        s.locationSlug ? (
          <a
            href={`/${locale}/locations/${s.locationSlug}`}
            class="tui-card__val tui-card__val--link"
          >
            {locationName(locations, s.locationSlug, locale)}
          </a>
        ) : (
          <span class="tui-card__val">{dict.mushrooms.unknown}</span>
        )
      }
    </div>
    {
      s.species.habitat && (
        <div class="tui-card__row">
          <span class="tui-card__label">habitat</span>
          <span class="tui-card__sep-dots" />
          <span class="tui-card__val">{t(s.species.habitat, locale)}</span>
        </div>
      )
    }
    {
      s.species.edibility && (
        <div class="tui-card__row">
          <span class="tui-card__label">edibility</span>
          <span class="tui-card__sep-dots" />
          <span class="tui-card__val">{t(s.species.edibility, locale)}</span>
        </div>
      )
    }

    <div class="tui-card__divider"></div>

    <div class="tui-card__features">
      <span class="tui-card__features-hdr"
        >├─ {t(s.species.determiningFeatures[0], locale) ? 'features:' : ''}</span
      >
      <ul>
        {
          s.species.determiningFeatures.map((f) => (
            <li>
              │ <span class="tui-card__bullet">▸</span> {t(f, locale)}
            </li>
          ))
        }
      </ul>
    </div>

    {
      s.notes && (
        <>
          <div class="tui-card__divider" />
          <div class="tui-card__notes">
            └─ <span class="tui-card__note-text">{t(s.notes, locale)}</span>
          </div>
        </>
      )
    }
  </div>
</div>

<style>
  .tui-card {
    border: 1px solid var(--border-char);
    background: var(--bg-surface);
    font-size: 0.8125rem;
    min-width: 0;
  }

  .tui-card__head {
    padding: 0.5rem 0.75rem 0;
    font-size: 0.75rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .tui-card__title {
    color: var(--fg-bright);
    font-weight: 700;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tui-card__title:hover {
    color: var(--accent);
  }

  .tui-card__more {
    color: var(--accent-dim);
    text-decoration: none;
    font-size: 0.6875rem;
    flex-shrink: 0;
    transition: color 0.1s;
  }

  .tui-card__more:hover {
    color: var(--accent);
  }

  .tui-card__carousel {
    position: relative;
    margin: 0.5rem 0.75rem;
    border: 1px solid var(--fg-muted);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-highlight);
    /* Let the browser own vertical panning, keep horizontal drags for swipe nav. */
    touch-action: pan-y;
  }

  .tui-card__slide {
    position: absolute;
    inset: 0;
    display: block;
    padding: 0;
    border: none;
    background: none;
    opacity: 0;
    visibility: hidden;
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
    /* Opts this element out of iOS double-tap-to-zoom, so a single tap fires click. */
    touch-action: manipulation;
    transition:
      opacity 0.2s,
      visibility 0.2s;
    height: 100%;
    width: 100%;
  }

  .tui-card__slide[data-active] {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  .tui-card__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.15s;
  }

  .tui-card__slide:hover img {
    filter: brightness(1.08);
  }

  .tui-card__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: #0e120b;
    border: 1px solid var(--border-char);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1;
    padding: 0.75rem 0.875rem;
    cursor: pointer;
    z-index: 2;
    opacity: 0;
    /* Must be none while hidden: opacity:0 alone stays hit-testable and would
       swallow taps on the photo, so the lightbox never opens on the first tap. */
    pointer-events: none;
    transition:
      background 0.1s,
      color 0.1s,
      opacity 0.15s;
  }

  .tui-card__carousel:hover .tui-card__arrow {
    opacity: 1;
    pointer-events: auto;
  }

  .tui-card__arrow:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .tui-card__arrow--prev {
    left: 0.25rem;
  }

  .tui-card__arrow--next {
    right: 0.25rem;
  }

  .tui-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
  }

  .tui-card__date {
    display: inline-block;
    pointer-events: auto;
    background: var(--bg);
    border: 1px solid var(--border-char);
    border-top: none;
    border-left: none;
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--yellow);
    text-decoration: none;
  }

  .tui-card__date:hover {
    color: var(--accent);
  }

  .tui-card__thumbs {
    display: flex;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem 0;
    flex-wrap: wrap;
  }

  .tui-card__thumb {
    position: relative;
    width: 4rem;
    height: 3rem;
    border: 1px solid var(--fg-muted);
    overflow: hidden;
    background: var(--bg-highlight);
    padding: 0;
    cursor: pointer;
    transition: border-color 0.1s;
  }

  .tui-card__thumb:hover,
  .tui-card__thumb[data-active] {
    border-color: var(--accent);
  }

  .tui-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tui-card__thumb-idx {
    position: absolute;
    bottom: 0;
    right: 0;
    background: var(--bg);
    color: var(--fg-dim);
    font-size: 0.625rem;
    padding: 0 0.25rem;
    border-top: 1px solid var(--border-char);
    border-left: 1px solid var(--border-char);
  }

  .tui-card__body {
    padding: 0.75rem 0.75rem 0.75rem;
  }

  .tui-card__row {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    line-height: 1.7;
    white-space: nowrap;
    overflow: hidden;
  }

  .tui-card__label {
    color: var(--fg-dim);
    flex-shrink: 0;
    font-size: 0.75rem;
  }

  .tui-card__sep-dots {
    flex: 1;
    border-bottom: 1px dotted var(--fg-muted);
    min-width: 1rem;
    margin-bottom: 0.2em;
  }

  .tui-card__val {
    color: var(--fg-bright);
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tui-card__val--link {
    text-decoration: none;
    transition: color 0.1s;
  }

  .tui-card__val--link:hover {
    color: var(--accent);
  }

  .tui-card__divider {
    border-top: 1px dashed var(--fg-muted);
    margin: 0.5rem 0;
  }

  .tui-card__features-hdr {
    color: var(--fg-dim);
    font-size: 0.75rem;
    display: block;
    margin-bottom: 0.25rem;
  }

  .tui-card__features ul {
    list-style: none;
  }

  .tui-card__features li {
    color: var(--fg);
    line-height: 1.7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tui-card__bullet {
    color: var(--accent-dim);
  }

  .tui-card__notes {
    color: var(--fg-dim);
    font-style: italic;
    line-height: 1.6;
  }

  .tui-card__note-text {
    color: var(--fg);
  }
</style>

<script>
  const SWIPE_MIN_DX = 40
  const SWIPE_DY_RATIO = 1.5

  document.querySelectorAll('.tui-card__carousel[data-carousel]').forEach((el) => {
    const carousel = el as HTMLElement
    const slides = [...carousel.querySelectorAll('.tui-card__slide')]
    const card = carousel.closest('.tui-card')
    const thumbs = [...(card?.querySelectorAll('[data-thumb]') ?? [])]
    if (slides.length <= 1) return
    let active = 0
    let startX: number | null = null
    let startY: number | null = null
    let suppressClick = false

    function show(i: number) {
      slides[active].removeAttribute('data-active')
      active = (i + slides.length) % slides.length
      slides[active].setAttribute('data-active', '')
      carousel.dataset.index = String(active)
      thumbs.forEach((thumb, thumbIndex) => {
        if (thumbIndex === active) thumb.setAttribute('data-active', '')
        else thumb.removeAttribute('data-active')
      })
    }

    carousel.dataset.index = String(active)

    carousel.querySelector('[data-arrow="prev"]')?.addEventListener('click', () => show(active - 1))
    carousel.querySelector('[data-arrow="next"]')?.addEventListener('click', () => show(active + 1))
    thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => show(i)))

    carousel.addEventListener('pointerdown', (e) => {
      // Any pending suppression belongs to a finished gesture; a new one supersedes it.
      suppressClick = false
      if (e.pointerType === 'mouse' || !e.isPrimary) return
      startX = e.clientX
      startY = e.clientY
    })

    carousel.addEventListener('pointerup', (e) => {
      if (startX === null || startY === null) return
      const dx = e.clientX - startX
      const dy = e.clientY - startY
      startX = null
      startY = null
      if (Math.abs(dx) < SWIPE_MIN_DX || Math.abs(dx) < Math.abs(dy) * SWIPE_DY_RATIO) return
      show(dx < 0 ? active + 1 : active - 1)
      // The slide is a child of the carousel and the lightbox opens from a
      // document-level bubble listener, so cancelling during capture keeps a
      // swipe from also firing the click that opens the lightbox.
      suppressClick = true
    })

    carousel.addEventListener('pointercancel', () => {
      startX = null
      startY = null
    })

    carousel.addEventListener(
      'click',
      (e) => {
        if (!suppressClick) return
        suppressClick = false
        e.preventDefault()
        e.stopPropagation()
      },
      { capture: true },
    )
  })
</script>
