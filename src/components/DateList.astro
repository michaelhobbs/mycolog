---
import { formatDay, groupByMonth, type RailDay } from '../lib/date-rail'
import type { Locale } from '../i18n'

interface Props {
  days: RailDay[]
  basePath: string
  locale: Locale
  countUnit: string
  navLabel: string
  activeDate?: string
  idPrefix?: string
}

const { days, basePath, locale, countUnit, navLabel, activeDate, idPrefix = 'rail' } = Astro.props
const months = groupByMonth(days, locale)
---

{
  months.length === 0 ? (
    <p class="date-list__empty">—</p>
  ) : (
    <nav class="date-list" aria-label={navLabel} id={idPrefix}>
      {months.map((month) => (
        <section class="date-list__month">
          <h2 class="date-list__month-label">{month.label}</h2>
          <ul class="date-list__days">
            {month.days.map((day) => (
              <li>
                <a
                  class="date-list__day"
                  href={`${basePath}/${day.date}`}
                  aria-current={day.date === activeDate ? 'page' : undefined}
                  data-active={day.date === activeDate ? '' : undefined}
                >
                  <span class="date-list__date">{formatDay(day.date, locale)}</span>
                  <span class="date-list__dots" />
                  <span class="date-list__count">
                    {day.count} {countUnit}
                  </span>
                </a>
                {day.meta && <p class="date-list__meta">{day.meta}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
  )
}

<style>
  .date-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .date-list__empty {
    color: var(--fg-dim);
    font-size: 0.8125rem;
  }

  .date-list__month-label {
    margin: 0 0 0.375rem;
    color: var(--accent-dim);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .date-list__days {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .date-list__day {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.1875rem 0.375rem;
    color: var(--fg-dim);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .date-list__date {
    flex-shrink: 0;
  }

  .date-list__dots {
    flex: 1;
    min-width: 0.5rem;
    border-bottom: 1px dotted var(--fg-muted);
    margin-bottom: 0.2em;
  }

  .date-list__count {
    flex-shrink: 0;
  }

  .date-list__day:hover {
    color: var(--fg-bright);
    background: var(--bg-highlight);
  }

  .date-list__day[data-active] {
    color: var(--fg-bright);
    background: var(--bg-highlight);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .date-list__meta {
    margin: 0 0 0.25rem;
    padding: 0 0.375rem;
    color: var(--fg-muted);
    font-size: 0.6875rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
